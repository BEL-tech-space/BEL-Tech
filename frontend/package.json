{
  "name": "frontend",
  "version": "1.0.0",
  "main": "tailwind.config.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "tsc",
    "build": "esbuild src/index.ts --bundle --sourcemap --outfile=public/assets/scripts/beltech.js",
    "build-sw": "esbuild src/sw/sw.ts --bundle --sourcemap --outfile=public/sw.js",
    "injectManifest": "esbuild src/sw/injectManifest-sw.ts --bundle --platform=node --packages=external --outfile=injectManifest.js && node injectManifest.js && rm injectManifest.js",
    "sw": "pnpm build-sw && pnpm injectManifest",
    "dev:tsc": "tsc --watch --preserveWatchOutput",
    "dev:build": "pnpm run sw && pnpm run build --watch=forever",
    "dev": "npm-run-all --parallel dev:*"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "esbuild": "^0.24.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "workbox-cli": "^7.1.0"
  },
  "dependencies": {
    "npm-run-all": "^4.1.5",
    "tailwindcss": "3",
    "workbox-build": "^7.1.0",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-navigation-preload": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.1.0",
    "workbox-strategies": "^7.3.0",
    "workbox-streams": "^7.3.0"
  }
}
