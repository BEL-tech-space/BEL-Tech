package frontend

templ LocationPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="stylesheet" href="/assets/styles/output.css"/>
			<title>Location</title>
		</head>
		<body>
			 <div class="px-6 pt-4 absolute z-20">
            <p class="font-bold text-xl pb-4 text-start">Find the closest smart bin to you! 😄</p>
            <input type="text"
                   placeholder="Search location"
                   class="bg-green-200 rounded-xl w-[90%] text-center absolute" />
            <img src="/assets/svg/search.svg"
                 class="w-6 h-6 relative left-72" />
        </div>

        <div class="absolute top-0 right-0 left-0 bottom-0 py-24">
            <div id="map"
                 class="w-full h-full">
            </div>
        </div>

        <script defer
                src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAqjo9EnrHgTK2-TeBIrUCq1GywYk7wlvw&callback=initMap">
                </script>
        <script type="text/javascript">
            function initMap () {
                var zoomVal = 4.2;
                if ( window.matchMedia( '(max-width: 767px)' ).matches )
                {
                    zoomVal = 2.5;
                }
                var options = {
                    zoom: zoomVal,
                    center: { lat: 7.405385919885895, lng: 3.889942027649539 },
                    mapTypeId: google.maps.MapTypeId.ROADMAP
                };
                var map = new google.maps.Map( document.getElementById( 'map' ), options );

                var marker1 = new google.maps.Marker( {
                    position: { lat: 7.402616211314639, lng: 3.9020077417937116 },
                    map: map,
                } );
                var marker2 = new google.maps.Marker( {
                    position: { lat: 7.475459606302984, lng: 3.903737589460358 },
                    map: map,
                } );
            }
        </script>

			@menuComp("location")
		</body>
	</html>
}
 