package frontend

templ WalletPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="stylesheet" href="/assets/styles/output.css"/>
			<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
			<title>Wallet</title>
		</head>
		<body>
			<div class="px-6 pt-8">
				<div class="flex w-full justify-start leading-4 items-center">
					<img src="/assets/images/name.jpg" class="rounded-2xl w-8 h-8" p-4/>
					<p class="text-lg font-semibold pl-4">Welcome, Tobias</p>
					<button class="bg-green-200 h-12 w-12 ml-auto rounded-md flex justify-center items-center"><img src="/assets/svg/notification.svg" class="align-middle"/></button>
				</div>
				<div class="flex gap-4">
					<p class="text-xl">My Balance</p>
					<img src="/assets/svg/eye.svg"/>
				</div>
				<p class="text-2xl font-extrabold pt-3 pb-6">999,999,999.999999 BEL</p>
				<div class="flex w-full justify-between items-start">
					<div class="flex flex-col gap-3 items-center">
						<button class="bg-green-200 h-12 w-12 rounded-full"><img src="/assets/svg/+.svg" class="h-8 w-8 m-auto"/></button>
						<p>Send</p>
						<button class="bg-green-200 h-12 w-12 rounded-full flex justify-center items-center"><img src="/assets/svg/subscribe.svg" class="h-8 w-8" class="h-8 w-8"/></button>
						<p>Subscribe</p>
					</div>
					<div class="flex flex-col gap-3 justify-center">
						<button class="bg-green-200 h-12 w-12 rounded-full flex justify-center items-center"><img src="/assets/svg/-.svg" class="h-8 w-8"/></button>
						<p>Receive</p>
						<button class="bg-green-200 h-12 w-12 rounded-full flex justify-center items-center"><img src="/assets/svg/learn.svg" class="h-8 w-8"/></button>
						<p>Learn</p>
					</div>
					<div class="flex flex-col gap-3 justify-center">
						<button class="bg-green-200 h-12 w-12 rounded-full flex justify-center items-center"><img src="/assets/svg/cash out.svg" class="h-8 w-8"/></button>
						<p>Cash out</p>
						<button class="bg-green-200 h-12 w-12 rounded-full flex justify-center items-center"><img src="/assets/svg/history.svg" class="h-8 w-8"/></button>
						<p>History</p>
					</div>
					<div class="flex flex-col gap-3 justify-center">
						<button class="bg-green-200 h-12 w-12 rounded-full flex justify-center items-center"><img src="/assets/svg/voucher.svg" class="h-8 w-8"/></button>
						<p>Voucher</p>
						<button class="bg-green-200 h-12 w-12  rounded-full flex justify-center items-center"><img src="/assets/svg/connect wallet.svg" class="h-8 w-8"/></button>
						<p>Wallet</p>
					</div>
				</div>
				<div class="inline-flex w-full justify-between pt-10">
					<p class="text-lg font-bold">Watchlist</p>
					<button><p class="text-green-800 text-sm">See all</p></button>
				</div>
			
				<div id="coins-container">
					<ul id="coins-list">
					
					</ul>
				</div>
			</div>

			<script>
				async function fetchCoinData() {
					const coins = ['bitcoin', 'ethereum', 'solana'];
					const url = `https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&ids=${coins.join(',')}`;
					
					try {
						const response = await fetch(url);
						const data = await response.json();

						const coinsList = document.getElementById('coins-list');

						data.forEach((coin, index) => {
							const listItem = document.createElement('li');
							listItem.classList.add('flex', 'justify-between', 'items-center');
							
							listItem.innerHTML = `
								<img src="${coin.image}" alt="${coin.name}" class="rounded-full w-10 h-10 pr-2"/>
								<div class="mr-0">
									<p class="text-lg font-bold">${coin.name}</p>
									<p class="text-sm">${coin.symbol.toUpperCase()}</p>
								</div>
								<div id="chart-${index}" class="w-20 h-7"></div> <!-- ApexChart will render here -->
								<div>
									<p class="font-extrabold text-xl text-center">$${coin.current_price.toLocaleString()}</p>
									<p class="${coin.price_change_percentage_24h >= 0 ? 'text-green-600' : 'text-red-600'} text-center">
										${coin.price_change_percentage_24h.toFixed(2)}%
									</p>
								</div>
							`;

							coinsList.appendChild(listItem);

							// Create Sparkline Chart
							createSparkline(`chart-${index}`, coin);
						});
					} catch (error) {
						console.error('Error fetching coin data:', error);
					}
				}

				// Function to create the sparkline graph using ApexCharts
				function createSparkline(elementId, coin) {
					const options = {
						chart: {
							type: 'line',
							sparkline: {
								enabled: true
							}
						},
						series: [{
							name: coin.name,
							data: generateRandomData() 
						}],
						stroke: {
							curve: 'smooth',
							width: 2
						},
						colors: coin.price_change_percentage_24h >= 0 ? ['#16a34a'] : ['#dc2626'], // Green for uptrend, Red for downtrend
					};

					const chart = new ApexCharts(document.querySelector(`#${elementId}`), options);
					chart.render();
				}

				// Dummy data generator for sparkline, replace this with actual price data over time
				function generateRandomData() {
					const data = [];
					for (let i = 0; i < 10; i++) {
						data.push(Math.floor(Math.random() * 100));
					}
					return data;
				}

				fetchCoinData();
			</script>

		
			@menuComp("wallet")
		</body>
	</html>
}
