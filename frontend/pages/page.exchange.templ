package frontend

templ ExchangePage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="stylesheet" href="/assets/styles/output.css"/>
			<title>Exchange</title>
		</head>
		<body>
			<div class="px-6 pt-8">
				<div class="flex w-full justify-between leading-4 items-center">
					<img src="/assets/images/name.jpg" class="rounded-2xl w-8 h-8"/>
					<p class="text-xl font-extrabold text-center">Exchange</p>
					<button class="bg-green-200 h-12 w-12 rounded-md flex justify-center items-center"><img src="/assets/svg/notification.svg" class="align-middle"/></button>
				</div>
				<div class="pt-10 flex w-3/5 justify-between font-light">
					<p>Airtime</p>
					<p>Data</p>
					<p>Voucher</p>
				</div>
				<p class="text-xl font-extrabold pt-5">Networks</p>
				<p class="text-sm">Select your network provider for airtime top-up</p>
				<div class="flex gap-4 w-full pt-6">
					<button class="border-green-200 border-solid border-2 rounded-lg w-1/2 pl-5 py-4">
						<img src="assets/images/glo.png" alt="" class="w-14 h-14 pl mb-4"/>
						<p class="text-bold text-xl text-start">Glo</p>
						<p class="text-bold text-xs text-start">5% Cashback</p>
					</button>
					<button class="border-green-200 border-solid border-2 rounded-lg w-1/2 pl-5 py-4">
						<img src="assets/images/mtn.png" alt="" class="w-14 h-14 pl mb-4"/>
						<p class="text-bold text-xl text-start">MTN</p>
						<p class="text-bold text-xs text-start">5% Cashback</p>
					</button>
				</div>
				<div class="flex gap-4 w-full pt-6">
					<button class="border-green-200 border-solid border-2 rounded-lg w-1/2 pl-5 py-4">
						<img src="assets/images/airtel.png" alt="" class="w-14 h-14 pl mb-4"/>
						<p class="text-bold text-xl text-start">Airtel</p>
						<p class="text-bold text-xs text-start">5% Cashback</p>
					</button>
					<!-- <button class="border-green-200 border-solid border-2 rounded-lg w-1/2 pl-5 py-4">
                    <img src="assets/images/mtn.png" alt="" class="w-14 h-14 pl mb-4"/>
                    <p class="text-bold text-xl text-start">MTN</p>
                    <p class="text-bold text-xs text-start">5% Cashback</p>
                </button> -->
				</div>
				<div class="flex w-full gap-4 bg-fuchsia-50 rounded-xl py-4 px-2 my-6">
					<img src="/assets/images/friends.jpg" alt="" class="w-20 h-20 rounded-lg"/>
					<div>
						<p class="text-start text-bold text-sm">Add beneficiaries for instant <br/> top-ups</p>
						<button class="text-green-600 font-semibold text-xs">Add beneficiary</button>
					</div>
				</div>
				<div class="flex w-full gap-4 bg-fuchsia-50 rounded-xl py-4 px-2">
					<img src="/assets/images/bonus.jpg" alt="" class="w-20 h-20 rounded-lg"/>
					<div>
						<p class="text-start text-bold text-sm">Get cashback for any airtime <br/> purchase</p>
						<button class="text-green-600 font-semibold text-xs">View cashback</button>
					</div>
				</div>
			</div>
			@menuComp("exchange")
		</body>
	</html>
}
