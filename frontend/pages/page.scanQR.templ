package frontend

templ ScanQRPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="stylesheet" href="/assets/styles/output.css"/>
			<title>Scan QR</title>
		</head>
		<body>
			<div class="flex flex-col justify-around items-center h-minus-menu">
				<div class="bg-white flex justify-between items-center w-full px-8">
					<button><img src="/assets/svg/-.svg" alt=""/></button>
					<p class="font-bold text-xl">Scan</p>
					<button class="bg-green-200 h-14 w-14 rounded-md flex justify-center items-center"><img src="/assets/svg/notification.svg" class="align-middle"/></button>
				</div>
				<img src="/assets/image/scan2.png" alt="" class="w-4/5 justify-center"/>
				<p class="text-center text-xl">Scan QR code on the smart bin to<br/>dispose waste</p>
				<button class="bg-green-800 text-white w-4/5 rounded-md h-12 items-end">Scan QR</button>
			</div>
			@menuComp()
		</body>
	</html>
}
