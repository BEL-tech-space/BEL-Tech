package frontend

templ menuComp(active string) {
	<div class="bg-white flex w-full justify-around pt-2 fixed bottom-0 z-50 max-h-20">
		if active == "home" {
			<button class="bg-green-100 rounded-3xl p-2"><a href="/home"><img src="/assets/svg/home bold.svg" class="w-10 h-20"/></a></button>
		} else {
			<button><a href="/home"><img src="/assets/svg/home linear.svg" class="w-10 h-20"/></a></button>
		}

		if active == "scan" {
			<button class="bg-green-100 rounded-3xl p-2"><a href="/scan"><img src="/assets/svg/scan bold.svg" class="w-10 h-20"/></a></button>
		} else {
			<button><a href="/scan"><img src="/assets/svg/scan linear.svg" class="w-10 h-20"/></a></button>
		}

		if active == "location" {
			<button class="bg-green-100 rounded-3xl p-2"><a href="/location"><img src="/assets/svg/location bold.svg" class="w-10 h-20"/></a></button>
		} else {
			<button><a href="/location"><img src="/assets/svg/location linear.svg" class="w-10 h-20"/></a></button>
		}

		if active == "wallet" {
			<button class="bg-green-100 rounded-3xl p-2"><a href="/wallet"><img src="/assets/svg/wallet bold.svg" class="w-10 h-20"/></a></button>
		} else {
			<button><a href="/wallet"><img src="/assets/svg/wallet linear.svg" class="w-10 h-20"/></a></button>
		}

		if active == "exchange" {
			<button class="bg-green-100 rounded-3xl p-2"><a href="/exchange"><img src="/assets/svg/exchange linear.svg" class="w-10 h-20"/></a></button>
		} else {
			<button><a href="/exchange"><img src="/assets/svg/exchange linear.svg" class="w-10 h-20"/></a></button>
		}
	</div>
}
