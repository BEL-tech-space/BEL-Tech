package frontend

templ AccountProfile(user User) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="stylesheet" href="/assets/styles/output.css"/>
			<script src="/assets/libriaries/hyperscript.min.js"></script>
			<title>Account Profile</title>
			@removeScrollBar()
		</head>
		<body class="bg-[url('/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="Page w-full h-full flex flex-col font-montserrat text-[#2E2E2E]">
				@profileBar(user)
				<main class="grow overflow-y-auto w-full pl-[1.5rem] pr-[1.56rem] pt-[1.875rem]">
					@letRecycleAndProfile("My Profile")
					<article class="h-full py-auto">
						<section class="my-[3.25rem] flex relative w-[7.75rem] aspect-square mx-auto items-end justify-end">
							<img src="/assets/svg/3d_avatar_3.svg" alt="" class="absolute"/>
							<button>
								<img src="/assets/svg/editPFP.svg" alt="" class="w-[1.962rem] aspect-square z-20 "/>
							</button>
						</section>
						<form action="" class="flex flex-col gap-3 justify-center items-center">
							<div class="w-full flex flex-col justify-start items-start gap-1">
								<label for="" class="font-semibold text-xs">Display Name:</label>
								<input type="text" name="nickname" id="nickname" class="outline-none border-solid border-[#569B78] border-[0.0313rem] rounded p-2 w-full"/>
							</div>
							<div class="w-full flex flex-col justify-start items-start gap-1">
								<label for="" class="font-semibold text-xs">Email:</label>
								<input disabled type="text" name="nickname" id="email" placeholder={ user.Email } class="outline-none border-solid border-[#569B78] border-[0.0313rem] rounded p-2 w-full"/>
							</div>
							<div class="w-full flex flex-col justify-start items-start gap-1">
								<label for="" class="font-semibold text-xs">Wallet:</label>
								<input disabled type="text" name="nickname" id="wallet" class="outline-none relative border-solid border-[#569B78] border-[0.0313rem] rounded p-2 w-full"/>
								<button>
									<img src="/assets/svg/connectWallet.svg" alt="" class="absolute top-0 w-4 aspect-square"/>
								</button>
							</div>
							<section class="mt-10 w-full grid grid-cols-profileButton items-center gap-[0.625rem]">
								<button _="on click call #changeSPLWalletAddrDialog.showModal() then halt" class="w-full text-center bg-[#016934] text-white text-sm tracking-[0.1px] font-medium py-[0.625rem] px-1 rounded-md">Save Changes</button>
								<a
									href="/account/signout"
									title="logout"
									class="bg-[#FFE8E8] rounded-md flex justify-center items-center"
								>
									<img
										src="/assets/svg/login.svg"
										class="w-6 aspect-square m-2"
									/>
								</a>
							</section>
						</form>
					</article>
				</main>
				@menuComp("dashboard")
			</div>
		</body>
		@createNewPinDialog()
		@enterSPLWalletAddrDialog()
		@successDialog(true)
		@chnageSPLWalletAddrDialog()
	</html>
}

templ createNewPinDialog() {
	<dialog id="createNewPinDialog" class="backdrop:backdrop-blur-sm rounded-2xl py-8 pl-7 pr-9 font-montserrat text-[#2E2E2E]">
		<img
			src="/assets/images/beltech_logo.png"
			alt="Beltech Logo"
			class="w-[6.56rem] aspect-[104.96/107.84] mx-auto"
		/>
		<p class="font-bold text-sm leading-[1.067rem] text-center mb-2 mt-6">Enter Private Pin</p>
		<p class="font-normal text-xs text-center text-nowrap">Enter your private pin to change your wallet</p>
		<form action="" class="mt-8 w-full">
			<label for="pin" class="font-bold text-xs">Enter Pin</label>
			<input type="password" required max="4" minlength="4" name="pin" id="pin" inputmode="numeric" class="min-h-[2.071rem] w-full border-solid border-[#569B78] border-[0.0256rem] rounded outline-none"/>
			<button type="button" _="on click call #createNewPinDialog.close()" class="w-full rounded-md mt-[4.554rem] mb-2 font-medium bg-[#016934] text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-[5.219rem] text-center text-white">Proceed</button>
		</form>
		<p class=" text-center font-poppins text-xs leading-[1.125rem] font-normal tracking-[0.01em]">Don't have a pin? <a class="font-montserrat font-bold text-xs text-[#016934]">Set Pin</a></p>
	</dialog>
}

templ enterSPLWalletAddrDialog() {
	<dialog id="enterSPLWalletAddrDialog" class="backdrop:backdrop-blur-sm rounded-2xl py-8 pl-7 pr-9 font-montserrat text-[#2E2E2E]">
		<img
			src="/assets/images/beltech_logo.png"
			alt="Beltech Logo"
			class="w-[6.56rem] aspect-[104.96/107.84] mx-auto"
		/>
		<p class="font-bold text-sm leading-[1.067rem] text-center mb-2 mt-6">Connect Wallet</p>
		<p class="font-normal text-xs text-center text-nowrap">Enter new SPL wallet address</p>
		<form action="" class="mt-8 w-full">
			<label for="wallet" class="font-bold text-xs">SPL Wallet Address</label>
			<input type="password" required max="4" minlength="4" name="wallet" id="wallet" inputmode="numeric" class="min-h-[2.071rem] w-full border-solid border-[#569B78] border-[0.0256rem] rounded outline-none"/>
			<button type="button" _="on click call #enterSPLWalletAddrDialog.close()" class="w-full rounded-md mt-[4.554rem] mb-2 font-medium bg-[#016934] text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-[5.219rem] text-center text-white">Proceed</button>
		</form>
	</dialog>
}

templ successDialog(new bool) {
	<dialog id="successDialog" class="backdrop:backdrop-blur-sm rounded-2xl py-8 pl-7 pr-9 font-montserrat text-[#2E2E2E]">
		<img src="/assets/svg/confetti.svg" alt="" class="w-[6.25rem] aspect-square mx-auto"/>
		if new {
			<p class="mt-6 mb-4 font-bold text-[0.813rem] leading-5 tracking-[0.00625em] text-black text-center">Success! Wallet address has been successfully added</p>
		} else {
			<p class="mt-6 mb-4 font-bold text-[0.813rem] leading-5 tracking-[0.00625em] text-black text-center">Success! Wallet address has been changed successfully</p>
		}
		<button type="button" _="on click call #successDialog.close()" class="outline-none w-full rounded-md mb-2 font-medium bg-[#016934] text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-[5.219rem] text-center text-white">Proceed</button>
	</dialog>
}

templ chnageSPLWalletAddrDialog() {
	<dialog id="changeSPLWalletAddrDialog" class="backdrop:backdrop-blur-sm rounded-2xl py-8 pl-7 pr-9 font-montserrat text-[#2E2E2E]">
		<p class="mt-2 mb-4 font-poppins font-extralight text-[0.813rem] leading-5 tracking-[0.00625em] text-black text-left text-wrap">BxfSXLfrj3DsFVk6Pnqnt2b7F5AwoaSPtsbDnRCXfwbe</p>
		<p class="font-semibold text-[0.813rem] leading-5 tracking-[0.00625em] text-black text-left text-wrap">Change wallet SPL wallet address?</p>
		<div class="mx-auto w-4/5 mt-2 flex justify-between items-center gap-2">
			<button type="button" _="on click call #changeSPLWalletAddrDialog.close()" class="outline-none rounded-md mb-2 font-medium bg-[#016934] text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-8 text-center text-white">Proceed</button>
			<button type="button" _="on click call #changeSPLWalletAddrDialog.close()" class="outline-none rounded-md mb-2 font-medium bg-black text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-8 text-center text-white">Close</button>
		</div>
	</dialog>
}
