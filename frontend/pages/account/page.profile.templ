package frontend

templ Profile(acc Account) {
	<!DOCTYPE html>
	<html lang="en">
		@HeadTag("Profile")
		<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="Page w-full h-full flex flex-col font-montserrat text-[#2E2E2E]">
				@CommonHeader(acc)
				@ProfileMain(acc)
				@Footer("dashboard", templ.NopComponent)
			</div>
		</body>
		@scriptForProfilePage()
		@createNewPinDialog()
		@enterSPLWalletAddrDialog()
		@successDialog(true)
		@changeSPLWalletAddrDialog()
	</html>
}

templ ProfileMain(acc Account) {
	<main class="grow overflow-y-auto w-full pl-[1.5rem] pr-[1.56rem] pt-[1.875rem]">
		<section class="flex items-center gap-1">
			<p class="leading-[1.143rem] font-semibold text-[0.938rem]">My Profile</p>
			<picture>
				<source type="image/webp" srcset="/public/assets/images/Recycle_small.webp"/>
				<img
					src="/public/assets/images/Recycle_small.png"
					class="w-5 aspect-square"
				/>
			</picture>
		</section>
		@ProfileChangeDisplayIcon(acc.AvatarUrl)
		@ProfileUpdataAccountInfoPartial(acc)
	</main>
}

templ scriptForProfilePage() {
	<script src="/public/assets/scripts/hyperscript.min.js"></script>
	<script src="/public/assets/scripts/htmx.min.js"></script>
	<script src="/public/assets/scripts/notification.js"></script>
	@commingSoonTooltip()
}

templ ProfileMainOpeningTag() {
	@templ.Raw(`<main class="grow overflow-y-auto w-full pl-[1.5rem] pr-[1.56rem] pt-[1.875rem]">
		<section class="flex items-center gap-1">
			<p class="leading-[1.143rem] font-semibold text-[0.938rem]">My Profile</p>
			<picture>
				<source type="image/webp" srcset="/public/assets/images/Recycle_small.webp"/>
				<img
					src="/public/assets/images/Recycle_small.png"
					class="w-5 aspect-square"
				/>
			</picture>
		</section>`)
}

templ ProfileChangeDisplayIcon(avatarURL string) {
	<section class="my-[3.25rem] flex relative w-[7.75rem] aspect-square mx-auto items-end justify-end">
		<img src={ avatarURL } alt="Profile Avatar" class="absolute rounded-full w-full aspect-square"/>
		<form method="POST" action="/account/profile/uploadAvatar" enctype="multipart/form-data" class="z-40">
			<label for="avatarInput" class="cursor-pointer">
				<img src="/public/assets/svg/editPFP.svg" alt="Edit Profile Picture" class="w-[1.962rem] aspect-square"/>
			</label>
			<input
				type="file"
				id="avatarInput"
				name="avatar"
				accept="image/*"
				required
				class="hidden"
			/>
		</form>
	</section>
}

templ ProfileUpdataAccountInfoPartial(acc Account) {
	<form
		hx-post="/account/profile/changeDisplayName"
		hx-trigger="submit"
		hx-target="#header"
		hx-swap="outerHTML"
		class="flex flex-col gap-3 justify-center items-center"
		_="on submit
			tell #saveButton
				add @disabled then add .opacity-45 then add .{'bg-green-400'}
				then remove .{'bg-[#016934]'}"
	>
		<div class="w-full flex flex-col justify-start items-start gap-1">
			<label for="nickname" class="font-semibold text-xs">Display Name:</label>
			<input
				type="text"
				name="nickname"
				id="nickname"
				minlength="2"
				maxlength="20"
				placeholder={ acc.DisplayName }
				class="outline-none border-solid border-[#569B78] border-[0.0313rem] rounded p-2 w-full"
				_="on input
					tell #saveButton
					if my.value.trim()
						remove @disabled then remove .opacity-45 then remove .{'bg-green-400'}
						then add .{'bg-[#016934]'}
					else
						add @disabled then add .opacity-45 then add .{'bg-green-400'}
						then remove .{'bg-[#016934]'}
					end"
			/>
		</div>
		<div class="w-full flex flex-col justify-start items-start gap-1">
			<label for="email" class="font-semibold text-xs">Email:</label>
			<input disabled type="text" name="email" id="email" placeholder={ acc.Email } class="outline-none border-solid border-[#569B78] border-[0.0313rem] rounded p-2 w-full"/>
		</div>
		<div class="w-full flex flex-col justify-start items-start gap-1 relative">
			<label for="wallet" class="font-semibold text-xs">Wallet:</label>
			<input disabled type="text" name="wallet" id="wallet" placeholder="wallet functionality coming soon" class="outline-none  border-solid border-[#569B78] border-[0.0313rem] rounded p-2 w-full"/>
			<button class="absolute top-2/4 right-4" data-tippy-content="coming soon">
				<img src="/public/assets/svg/connectWallet.svg" alt="" class="w-5 aspect-square"/>
			</button>
		</div>
		<section class="mt-10 w-full grid grid-cols-profileButton items-center gap-[0.625rem]">
			<button
				id="saveButton"
				disabled
				type="submit"
				class="w-full text-center opacity-45 bg-green-400 text-white text-sm tracking-[0.1px] font-medium py-[0.625rem] px-1 rounded-md"
			>Save Changes</button>
			<a
				href="/account/auth/logout/google"
				title="logout"
				class="bg-[#FFE8E8] rounded-md flex justify-center items-center"
			>
				<img
					src="/public/assets/svg/login.svg"
					class="w-6 aspect-square m-2"
				/>
			</a>
		</section>
	</form>
}

templ createNewPinDialog() {
	<dialog id="createNewPinDialog" class="backdrop:backdrop-blur-sm rounded-2xl py-8 pl-7 pr-9 font-montserrat text-[#2E2E2E]">
		<img
			src="/public/assets/images/beltech_logo.png"
			alt="Beltech Logo"
			class="w-[6.56rem] aspect-[104.96/107.84] mx-auto"
		/>
		<p class="font-bold text-sm leading-[1.067rem] text-center mb-2 mt-6">Enter Private Pin</p>
		<p class="font-normal text-xs text-center text-nowrap">Enter your private pin to change your wallet</p>
		<form action="" class="mt-8 w-full">
			<div class="flex flex-col justify-start items-start gap-3 relative">
				<label for="pin" class="font-bold text-xs">Enter Pin</label>
				<input required type="number" name="pin" id="pin" maxlength="4" minlength="4" inputmode="numeric" class="min-h-[2.071rem] pl-2 w-full border-solid border-[#569B78] border-[0.0256rem] rounded outline-none"/>
				<button class="absolute top-[60%] right-4" id="eye">
					<img src="/public/assets/svg/greenEye.svg" alt="" class="w-4 aspect-square"/>
				</button>
			</div>
			<div class=" mt-16 flex justify-between items-center gap-3">
				<button type="button" class="outline-none rounded-md mb-2 font-medium bg-[#016934] text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-8 text-center text-white">Proceed</button>
				<button _="on click call #createNewPinDialog.close()" class="outline-none rounded-md mb-2 font-medium bg-black text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-8 text-center text-white">Close</button>
			</div>
		</form>
		<p class=" text-center font-poppins text-xs leading-[1.125rem] font-normal tracking-[0.01em]">Don't have a pin? <a class="font-montserrat font-bold text-xs text-[#016934]">Set Pin</a></p>
		// 	<script>
		//         const passwordInput = document.getElementById('pin');
		//         const eyeBtn = document.getElementById('eye');
		// 		eyeBtn.addEventListener('click', (ev) => {
		// 			ev.stopPropagation();
		// 			ev.preventDefault();
		//         	const passwordType = passwordInput.getAttribute('type');
		// 			if (passwordType === 'password') {
		// 				passwordInput.setAttribute('type', 'number');
		// 			} else {
		// 				passwordInput.setAttribute('type', 'password');
		// 			}
		// 		});
		// </script>
	</dialog>
}

templ enterSPLWalletAddrDialog() {
	<dialog id="enterSPLWalletAddrDialog" class="backdrop:backdrop-blur-sm rounded-2xl py-8 pl-7 pr-9 font-montserrat text-[#2E2E2E]">
		<img
			src="/public/assets/images/beltech_logo.png"
			alt="Beltech Logo"
			class="w-[6.56rem] aspect-[104.96/107.84] mx-auto"
		/>
		<p class="font-bold text-sm leading-[1.067rem] text-center mb-2 mt-6">Connect Wallet</p>
		<p class="font-normal text-xs text-center text-nowrap">Enter new SPL wallet address</p>
		<form action="" class="mt-8 w-full">
			<label for="newWallet" class="font-bold text-xs">SPL Wallet Address</label>
			<input type="text" name="newWallet" id="newWallet" class="min-h-[2.071rem] pl-1 w-full border-solid border-[#569B78] border-[0.0256rem] rounded outline-none"/>
			<button type="button" _="on click call #enterSPLWalletAddrDialog.close()" class="w-full rounded-md mt-16 mb-2 font-medium bg-[#016934] text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-[5.219rem] text-center text-white">Proceed</button>
		</form>
	</dialog>
}

templ successDialog(new bool) {
	<dialog id="successDialog" class="backdrop:backdrop-blur-sm rounded-2xl py-8 pl-7 pr-9 font-montserrat text-[#2E2E2E]">
		<img src="/public/assets/svg/confetti.svg" alt="" class="w-[6.25rem] aspect-square mx-auto"/>
		if new {
			<p class="mt-6 mb-4 font-bold text-[0.813rem] leading-5 tracking-[0.00625em] text-black text-center">Success! Wallet address has been successfully added</p>
		} else {
			<p class="mt-6 mb-4 font-bold text-[0.813rem] leading-5 tracking-[0.00625em] text-black text-center">Success! Wallet address has been changed successfully</p>
		}
		<button type="button" _="on click call #successDialog.close()" class="outline-none w-full rounded-md mb-2 font-medium bg-[#016934] text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-[5.219rem] text-center text-white">Proceed</button>
	</dialog>
}

templ changeSPLWalletAddrDialog() {
	<dialog id="changeSPLWalletAddrDialog" class="backdrop:backdrop-blur-sm rounded-2xl py-8 pl-7 pr-9 font-montserrat text-[#2E2E2E]">
		<p class="mt-2 mb-4 font-poppins font-extralight text-[0.813rem] leading-5 tracking-[0.00625em] text-black text-left text-wrap">BxfSXLfrj3DsFVk6Pnqnt2b7F5AwoaSPtsbDnRCXfwbe</p>
		<p class="font-semibold text-[0.813rem] leading-5 tracking-[0.00625em] text-black text-left text-wrap">Change SPL wallet address?</p>
		<div class="mx-auto w-4/5 mt-2 flex justify-between items-center gap-2">
			<button type="button" _="on click call #changeSPLWalletAddrDialog.close()" class="outline-none rounded-md mb-2 font-medium bg-[#016934] text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-8 text-center text-white">Proceed</button>
			<button type="button" _="on click call #changeSPLWalletAddrDialog.close()" class="outline-none rounded-md mb-2 font-medium bg-black text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-8 text-center text-white">Close</button>
		</div>
	</dialog>
}
