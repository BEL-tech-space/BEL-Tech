package frontend

import "strings"

templ headTag(pageTitle string) {
	<head>
		<meta charset="UTF-8"/>
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0, viewport-fit=cover"
		/>
		if strings.Contains(strings.ToLower(pageTitle), "dashboard") ||
			strings.Contains(strings.ToLower(pageTitle), "scan") || 
			strings.Contains(strings.ToLower(pageTitle), "location") || 
			strings.Contains(strings.ToLower(pageTitle), "wallet") || 
			strings.Contains(strings.ToLower(pageTitle), "spend") {
			// <link rel="manifest" href="/public/manifest.json"/>
		}
		<meta name="theme-color" content="#CCE1D699"/>
		@splashScreenForiOS()
		if strings.Contains(strings.ToLower(pageTitle), "dashboard") ||
			strings.Contains(strings.ToLower(pageTitle), "wallet") {
			<link
				rel="stylesheet"
				href="/public/assets/styles/swiper-bundle.min.css"
			/>
		}
		<link
			rel="stylesheet"
			href="/public/assets/styles/output.css"
		/>
		<link
			rel="stylesheet"
			href="/public/assets/styles/toastr.min.css"
		/>
		if strings.Contains(strings.ToLower(pageTitle), "location") ||
			strings.Contains(strings.ToLower(pageTitle), "wallet") ||
			strings.Contains(strings.ToLower(pageTitle), "spend") {
			<link
				rel="stylesheet"
				href="/public/assets/styles/backdrop.css"
			/>
			<link
				rel="stylesheet"
				href="/public/assets/styles/shift-away.css"
			/>
			<link
				rel="stylesheet"
				href="/public/assets/styles/perspective-extreme.css"
			/>
		}
		<style>
			.overflow-y-auto::-webkit-scrollbar {
				width: 0 !important;
				display: none;
				overflow: -moz-scrollbars-none;
				scrollbar-width: none;
			}
		</style>
		<title>{ pageTitle }</title>
	</head>
}

templ footer(active string) {
	<footer class="bg-white flex w-full justify-around px-4 pt-3 pb-1 gap-[2.375rem]" hx-boost="false">
		if active == "dashboard" || 
		active == "tips" ||
		 active == "waste" {
			<a
				href="/account/dashboard"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/home bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Home</p>
			</a>
		} else {
			<a
				href="/account/dashboard"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/home linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Home</p>
			</a>
		}
		if active == "scan" || active == "history" {
			<a
				href="/account/scan"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/scan bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Scan</p>
			</a>
		} else {
			<a
				href="/account/scan"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/scan linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Scan</p>
			</a>
		}
		if active == "location" {
			<a
				href="/account/location"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/location bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Location</p>
			</a>
		} else {
			<a
				href="/account/location"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/location linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Location</p>
			</a>
		}
		if active == "wallet" {
			<a
				href="/account/wallet"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/wallet bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Wallet</p>
			</a>
		} else {
			<a
				href="/account/wallet"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/wallet linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Wallet</p>
			</a>
		}
		if active == "spend" || active == "beneficiaries"||
		 active == "airtime" {
			<a
				href="/account/spend"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/new_exchange_bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Spend</p>
			</a>
		} else {
			<a
				href="/account/spend"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/new_exchange_linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Spend</p>
			</a>
		}
	</footer>
}

