package frontend

import "beltech/types"

templ AirtimePage(avatarURL string, ben []types.Beneficiary) {
	<!DOCTYPE html>
	<html lang="en">
		@HeadTag("Airtime")
		<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="w-full h-full grid grid-rows-agentCollectPage font-montserrat text-[#2E2E2E]">
				@commonHeaderTwo("Spend BEL Token", avatarURL, AirtimeHeaderBtnComp())
				@AirtimeMain(ben)
				@Footer("spend", templ.NopComponent)
			</div>
		</body>
		<script src="/public/assets/scripts/htmx.min.js"></script>
		<script src="/public/assets/scripts/hyperscript.min.js"></script>
		@airtimeRechargeSuccessDialog()
		@addNewBeneficiairyAirtimePageDialog()
		@scriptForAirtimePage()
	</html>
}

templ AirtimeHeaderBtnComp() {
	<button class="bg-[#CCE1D699] p-2 rounded-md flex justify-center items-center">
		<img
			src="/public/assets/svg/notification.svg"
			class="w-[1.5rem] aspect-square"
		/>
	</button>
}

templ AirtimeMain(ben []types.Beneficiary) {
	<main class="overflow-y-auto pl-[1.5rem] pr-[1.56rem] pt-12 grid grid-rows-wastePage">
		@AirtimeInputNumberPartial()
		@AirtimeBeneficiaries(ben)
	</main>
}

templ AirtimeMainOpeningTag() {
	@templ.Raw(`<main class="overflow-y-auto pl-[1.5rem] pr-[1.56rem] pt-12">`)
}

templ AirtimeHeaderPartial(avatarURL string, beforeHeaderTagPartial, afterHeaderTagPartial templ.Component) {
	@commonHeaderTwo("Spend BEL Token", avatarURL, AirtimeHeaderBtnComp())
}

templ AirtimeInputNumberPartial() {
	<p class="font-bold text-xs leading-5 tracking-[0.00625em] text-center text-black">Which number do you want to receive <br/>your airtime to?</p>
	<form class="mt-10" id="beneficiaryNumber">
		<div class="flex flex-col justify-start items-start gap-3 relative">
			<label for="airtime" class="font-semibold text-xs text-black text-left">Input Your Phone Number</label>
			<input type="tel" maxlength="11" minlength="11" enterkeyhint="send" inputmode="numeric" name="airtime" id="airtime" placeholder="09034097398" class="outline-none w-full min-h-[3.326rem] rounded-[0.652rem] pl-3 font-poppins font-semibold text-black border-solid border-[#0169344D] border-[0.065rem] placeholder:font-extralight placeholder:text-[0.625rem] placeholder:text-gray-500"/>
			<button type="button" _="on click call #addNewBeneficiairyDialog.showModal() then halt" class="absolute top-2/4 right-4">
				<img src="/public/assets/svg/profile-add.svg" alt="" class="w-[1.875rem] aspect-square"/>
			</button>
		</div>
		<button disabled type="submit" id="submitButton" class="w-full opacity-45 bg-green-400 rounded-md mb-2 font-medium mt-10 text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-[5.219rem] text-center text-white">Recharge</button>
	</form>
	<section class="mt-10 w-full flex items-center justify-between mb-2">
		<p class="font-semibold text-[0.688rem] leading-[0.838rem] text-black">Choose from Beneficiary</p>
		<button>
			<p class="font-medium text-[0.63rem] leading-[0.762rem] text-[#016934]">see all</p>
		</button>
	</section>
}

templ AirtimeBeneficiaries(ben []types.Beneficiary) {
	<section id="beneficiariesList" class="overflow-y-auto max-h-full w-full rounded-md">
		if len(ben) == 0 {
			<div class="h-full mt-3 flex justify-center items-center">
				<p class="text-center font-tt_chocolate">No beneficiary, click the + to add new beneficiary.</p>
			</div>
		} else {
			<ul class="w-full flex flex-col justify-center items-center gap-6 pb-2">
				for _, v := range ben {
					<li class="w-full bg-[#FEF7FF] shadow-[0px_1px_2px_1px_#00000014] pl-2 pr-7 py-3 flex justify-between items-center rounded-lg">
						<button
							class="w-full h-full flex gap-6 items-center justify-start"
							_="on click set #airtime's value to my.querySelector('.phone-number').textContent then call #airtime.reportValidity() then call changeSubmitBtnState()"
						>
							switch v.ServiceProvider {
								case "mtn":
									<picture>
										<source type="image/webp" srcset="/public/assets/images/mtn.webp"/>
										<img src="/public/assets/images/mtn.png" alt="" class="w-[3.5rem] aspect-square rounded-full"/>
									</picture>
								case "airtel":
									<picture>
										<source type="image/webp" srcset="/public/assets/images/airtel.webp"/>
										<img src="/public/assets/images/airtel.png" alt="" class="w-[3.5rem] aspect-square rounded-full"/>
									</picture>
								case "glo":
									<picture>
										<source type="image/webp" srcset="/public/assets/images/glo.webp"/>
										<img src="/public/assets/images/glo.png" alt="" class="w-[3.5rem] aspect-square rounded-full"/>
									</picture>
								case "9mobile":
									<img src="/public/assets/svg/9mobile.svg" alt="" class="w-[3.5rem] aspect-square rounded-full"/>
							}
							<div class="flex flex-col gap-2 justify-start items-start">
								<p class="font-poppins font-medium text-xs leading-[1.125rem] text-[#2E2E2E]">{ v.BName }</p>
								<p class="phone-number font-montserrat font-bold text-[0.625rem] leading-[0.762rem] text-[#016934]">{ v.BPhoneNo }</p>
							</div>
						</button>
					</li>
				}
			</ul>
		}
	</section>
}

templ scriptForAirtimePage() {
	<script>
			const beneficiaryNumberForm = document.getElementById('beneficiaryNumber');
			const beneficiaryNumberSubmitBtn = document.getElementById('submitButton');

			beneficiaryNumberForm.addEventListener('input', (e) => {
				changeSubmitBtnState();
			});

			function changeSubmitBtnState() {
				if (!beneficiaryNumberForm.checkValidity()) {
					beneficiaryNumberSubmitBtn.disabled = true
					beneficiaryNumberSubmitBtn.classList.remove('bg-[#016934]')
					beneficiaryNumberSubmitBtn.classList.add('opacity-45', 'bg-green-400')
					return
				}
				beneficiaryNumberSubmitBtn.disabled = false
				beneficiaryNumberSubmitBtn.classList.add('bg-[#016934]')
				beneficiaryNumberSubmitBtn.classList.remove('opacity-45', 'bg-green-400')
			}
		</script>
}

templ airtimeRechargeSuccessDialog() {
	<dialog id="airtimeRechargeSuccessDialog" class="backdrop:backdrop-blur-sm rounded-2xl py-8 pl-7 pr-9 font-montserrat text-[#2E2E2E]">
		<img src="/public/assets/svg/confetti.svg" alt="" class="w-[6.25rem] aspect-square mx-auto"/>
		<p class="mt-6 mb-4 font-bold text-[0.813rem] leading-5 tracking-[0.00625em] text-black text-center">Airtime has been recharged to the given phone number.</p>
		<button type="button" _="on click call #airtimeRechargeSuccessDialog.close()" class="outline-none w-full rounded-md mb-2 font-medium bg-[#016934] text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-[5.219rem] text-center text-white">Proceed</button>
	</dialog>
}

templ addNewBeneficiairyAirtimePageDialog() {
	<dialog id="addNewBeneficiairyDialog" class="backdrop:backdrop-blur-sm rounded-2xl py-8 pl-7 pr-9 font-montserrat text-[#2E2E2E]">
		<p class="font-bold text-sm leading-[1.067rem] text-center mb-2 mt-6">Add new number to your Beneficiary</p>
		<form
			id="newBeneficiary"
			hx-post="/account/beneficiaries/addNew"
			hx-target="#beneficiariesList"
			hx-swap="outerHTML"
			hx-vals='{"from": "airtimePage"}'
			hx-trigger="submit"
			_="on htmx:beforeRequest call #addNewBeneficiairyDialog.close() then call restoreState()"
			class="mt-8 w-full flex flex-col items-center justify-start gap-[1.141rem]"
		>
			<div class="w-full">
				<label for="name" class="font-semibold text-xs">Name</label>
				<input required type="text" autocomplete="off" name="name" id="name" minlength="2" maxlength="20" placeholder="min. 2 - max. 20" class="min-h-[2.071rem] pl-2 w-full border-solid border-[#569B78] border-[0.0256rem] rounded outline-none placeholder:text-xs"/>
			</div>
			<div class="w-full">
				<label for="number" class="font-semibold text-xs">Phone Number</label>
				<input required type="tel" name="number" id="number" inputmode="numeric" autocomplete="off" maxlength="11" minlength="11" title="number must be 11 in length" pattern="^0[1-9][0-1]\d{8}" placeholder="length of 11 numbers e.g 090xxxxxxxx" class="min-h-[2.071rem] pl-2 w-full border-solid border-[#569B78] border-[0.0256rem] rounded outline-none placeholder:text-xs"/>
			</div>
			<section class="grid grid-cols-4 justify-between items-center gap-[2.125rem] mb-8">
				<label for="mtn" class="label shadow-[0px_0.053rem_0.105rem_0.053rem_#00000014] py-[0.869rem] px-[1.25rem] flex flex-col justify-center items-center">
					<img src="/public/assets/svg/mtn.svg" alt="" class="w-9 rounded-full"/>
					<p class="font-poppins font-bold text-[0.524rem] leading-[0.787rem] mt-[0.482rem]">MTN</p>
				</label>
				<input required type="radio" id="mtn" name="sp" autocomplete="off" value="mtn" class="hidden"/>
				<label for="airtel" class="label shadow-[0px_0.053rem_0.105rem_0.053rem_#00000014] py-[0.869rem] px-[1.25rem] flex flex-col justify-center items-center">
					<img src="/public/assets/svg/airtel.svg" alt="" class="w-9 rounded-full"/>
					<p class="font-poppins font-bold text-[0.524rem] leading-[0.787rem] mt-[0.482rem]">AIRTEL</p>
				</label>
				<input type="radio" id="airtel" name="sp" autocomplete="off" value="airtel" class="hidden"/>
				<label for="glo" class="label shadow-[0px_0.053rem_0.105rem_0.053rem_#00000014] py-[0.869rem] px-[1.25rem] flex flex-col justify-center items-center">
					<img src="/public/assets/svg/glo.svg" alt="" class="w-9 rounded-full"/>
					<p class="font-poppins font-bold text-[0.524rem] leading-[0.787rem] mt-[0.482rem]">GLO</p>
				</label>
				<input type="radio" id="glo" name="sp" autocomplete="off" value="glo" class="hidden"/>
				<label for="9mobile" class="label shadow-[0px_0.053rem_0.105rem_0.053rem_#00000014] py-[0.869rem] px-[1.25rem] flex flex-col justify-center items-center">
					<img src="/public/assets/svg/9mobile.svg" alt="" class="w-9 rounded-full"/>
					<p class="font-poppins font-bold text-[0.524rem] leading-[0.787rem] mt-[0.482rem]">9MOBILE</p>
				</label>
				<input type="radio" id="9mobile" name="sp" autocomplete="off" value="9mobile" class="hidden"/>
			</section>
			<section class="w-full flex justify-between items-center gap-3">
				<button
					disabled
					id="submitBtn"
					type="submit"
					class="w-full opacity-45 bg-green-400 text-sm font-medium text-white py-[0.625rem] text-center tracking-[0.00625rem] rounded-md"
				>Save Beneficiary</button>
				<button type="reset" _="on click call #addNewBeneficiairyDialog.close() then call restoreState()" class="outline-none rounded-md mb-2 font-medium bg-black text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-8 text-center text-white">Close</button>
			</section>
		</form>
		<style>
			.selected {
				background-color: #b1ddc8;
				border-radius: 6px;
			}
		</style>
		<script>
			const newBeneficiaryForm = document.getElementById('newBeneficiary');
			const newBeneficiaryFormSubmitBtn =  document.getElementById("submitBtn")

			newBeneficiaryForm.addEventListener('input', () => {
				if (!newBeneficiaryForm.checkValidity()) {
					newBeneficiaryFormSubmitBtn.disabled = true
					newBeneficiaryFormSubmitBtn.classList.remove('bg-[#016934]')
					newBeneficiaryFormSubmitBtn.classList.add('opacity-45', 'bg-green-400')
					return
				}
				newBeneficiaryFormSubmitBtn.disabled = false
				newBeneficiaryFormSubmitBtn.classList.add('bg-[#016934]')
				newBeneficiaryFormSubmitBtn.classList.remove('opacity-45', 'bg-green-400')
			});

			const radioInputs = document.querySelectorAll('input[type="radio"][name="sp"]');
			radioInputs.forEach((radio) => {
				radio.addEventListener('change', () => {	
					const labels = document.querySelectorAll('label');
					labels.forEach((label) => {
						label.classList.remove('selected');
					});

					const checkedRadio = document.querySelector('input[type="radio"][name="sp"]:checked');
					if (checkedRadio) {
						const label = document.querySelector(`label[for="${checkedRadio.id}"]`);
						label.classList.add('selected');
					}
				});
			});

			function restoreState() {
				// Uncheck the radio buttons
				radioInputs.forEach((radio) => {
					radio.checked = false;
				});

    
				const labels = document.querySelectorAll('label');
				labels.forEach((label) => {
					label.classList.remove('selected');
				});

				 // Reset the form
				newBeneficiaryForm.reset();

				// Add the disabled attribute to the submit button
				newBeneficiaryFormSubmitBtn.disabled = true;
				newBeneficiaryFormSubmitBtn.classList.remove('bg-[#016934]');
				newBeneficiaryFormSubmitBtn.classList.add('opacity-45', 'bg-green-400');
			};
		</script>
	</dialog>
}
