package frontend

templ RechargeAirtimePage(user User) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="stylesheet" href="/assets/styles/output.css"/>
			<script src="/assets/libriaries/hyperscript.min.js"></script>
			@removeScrollBar()
			<title>Wallet</title>
		</head>
		<body class="bg-[url('/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="w-full h-full grid grid-rows-agentCollectPage font-montserrat text-[#2E2E2E]">
				@frequentHeaderTwo("Spend BEL Token", user.AvatarUrl, "/assets/svg/notification.svg", "")
				<main class="overflow-y-auto pl-[1.5rem] pr-[1.56rem] pt-12 grid grid-flow-row-4">
					<p class="font-bold text-xs leading-5 tracking-[0.00625em] text-center text-black">Which number do you want to receive <br/>your airtime to?</p>
					<form action="" class="mt-10">
						<label for="airtime" class="font-semibold text-xs text-black text-left">Input Your Phone Number</label>
						<input type="number" inputmode="numeric" name="airtime" id="airtime" placeholder="09034097398" class="w-full mt-[0.783rem] min-h-[3.326rem] rounded-[0.652rem] pl-3 font-poppins font-semibold text-xs text-black border-solid border-[#0169344D] border-[0.065rem] placeholder:font-extralight placeholder:text-[0.625rem] placeholder:text-gray-500"/>
						<button type="button" _="on click call #addNewBeneficiairyDialog.showModal() then halt" class="w-full rounded-md mb-2 font-medium bg-[#016934] mt-10 text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-[5.219rem] text-center text-white">Recharge</button>
					</form>
					<section class="mt-10 w-full flex items-center justify-between mb-2">
						<p class="font-semibold text-[0.688rem] leading-[0.838rem] text-black">Choose from Beneficiary</p>
						<button>
							<p class="font-medium text-[0.63rem] leading-[0.762rem] text-[#016934]">see all</p>
						</button>
					</section>
					<section class="overflow-y-auto max-h-full w-full rounded-md">
						<ul class="w-full flex flex-col justify-center items-center gap-6">
							for range 8 {
								<li class="w-full bg-[#FEF7FF] shadow-[0px_1px_2px_1px_#00000014] px-2 py-3 flex justify-start items-center gap-6 rounded-lg">
									<img src="/assets/images/mtn.png" alt="" class="w-[3.5rem] aspect-square rounded-full"/>
									<div class="flex flex-col gap-2 justify-start items-center">
										<p class="font-poppins font-medium text-xs leading-[1.125rem] text-[#2E2E2E]">Tobias</p>
										<p class="font-montserrat font-bold text-[0.625rem] leading-[0.762rem] text-[#016934]">09034097398</p>
									</div>
								</li>
								<li class="w-full bg-[#FEF7FF] shadow-[0px_1px_2px_1px_#00000014] px-2 py-3 flex justify-start items-center gap-6 rounded-lg">
									<img src="/assets/images/airtel.png" alt="" class="w-[3.5rem] aspect-square rounded-full"/>
									<div class="flex flex-col gap-2 justify-start items-center">
										<p class="font-poppins font-medium text-xs leading-[1.125rem] text-[#2E2E2E]">Elijah</p>
										<p class="font-montserrat font-bold text-[0.625rem] leading-[0.762rem] text-[#016934]">09034097398</p>
									</div>
								</li>
							}
						</ul>
					</section>
				</main>
				@menuComp("spend")
			</div>
		</body>
		@airtimeRechargeSuccessDialog()
		@addNewBeneficiairyDialog()
	</html>
}

templ airtimeRechargeSuccessDialog() {
	<dialog id="airtimeRechargeSuccessDialog" class="backdrop:backdrop-blur-sm rounded-2xl py-8 pl-7 pr-9 font-montserrat text-[#2E2E2E]">
		<img src="/assets/svg/confetti.svg" alt="" class="w-[6.25rem] aspect-square mx-auto"/>
		<p class="mt-6 mb-4 font-bold text-[0.813rem] leading-5 tracking-[0.00625em] text-black text-center">Airtime has been recharged to the given phone number.</p>
		<button type="button" _="on click call #airtimeRechargeSuccessDialog.close()" class="outline-none w-full rounded-md mb-2 font-medium bg-[#016934] text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-[5.219rem] text-center text-white">Proceed</button>
	</dialog>
}

templ addNewBeneficiairyDialog() {
	<dialog id="addNewBeneficiairyDialog" class="backdrop:backdrop-blur-sm rounded-2xl py-8 pl-7 pr-9 font-montserrat text-[#2E2E2E]">
		<p class="font-bold text-sm leading-[1.067rem] text-center mb-2 mt-6">Add new number to your Beneficiary</p>
		<form action="" class="mt-8 w-full flex flex-col items-center justify-start gap-[1.141rem]">
			<div class="w-full">
				<label for="name" class="font-semibold text-xs">Name</label>
				<input type="password" required max="4" minlength="4" name="name" id="name" inputmode="numeric" class="min-h-[2.071rem] pl-2 w-full border-solid border-[#569B78] border-[0.0256rem] rounded outline-none"/>
			</div>
			<div class="w-full">
				<label for="number" class="font-semibold text-xs">Phone Number</label>
				<input type="password" required max="4" minlength="4" name="number" id="number" inputmode="numeric" class="min-h-[2.071rem] pl-2 w-full border-solid border-[#569B78] border-[0.0256rem] rounded outline-none"/>
			</div>
			<button type="button" _="on click call #addNewBeneficiairyDialog.close()" class="w-full rounded-md mt-[2.188rem] mb-2 font-medium bg-[#016934] text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-[5.219rem] text-center text-white">Save Beneficiary</button>
		</form>
	</dialog>
}
