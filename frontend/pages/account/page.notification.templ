package frontend

import (
	"beltech/service"
	"fmt"
	"time"
)

templ MakeNotification(acc service.Account) {
	<!DOCTYPE html>
	<html lang="en">
		@headTag("dashboard")
		<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="Page w-full h-full flex flex-col font-montserrat text-[#2E2E2E]">
				@commonHeader(acc)
				@notificationMain(acc)
				@footer("dashboard")
			</div>
		</body>
		@scriptForNotificationPage()
		@confirmDialog()
	</html>
}

templ scriptForNotificationPage() {
	<script src="/public/assets/scripts/hyperscript.min.js"></script>
	<script src="/public/assets/scripts/notification.js"></script>
}

templ notificationMain(acc service.Account) {
	<main class="grow overflow-y-auto pl-[1.5rem] pr-[1.56rem] pt-[1.875rem] grid grid-rows-notificationPage">
		<form
			action="/account/createNotification"
			method="post"
			name="notificationForm"
			id="formTag"
			class="flex flex-col gap-3 justify-center items-center"
			_="on submit
			tell #saveButton
				add @disabled then add .opacity-45 then add .{'bg-green-400'}
				then remove .{'bg-[#016934]'}"
		>
			<div class="w-full flex flex-col justify-start items-start gap-1">
				<label for="title" class="font-semibold text-xs">Notification Title:</label>
				<input
					type="text"
					required
					name="title"
					id="title"
					minlength="2"
					maxlength="30"
					placeholder="e.g New Device Login, max 30 characters"
					class="outline-none border-solid border-[#569B78] border-[0.0313rem] rounded p-2 w-full"
					_="on input
					tell #saveButton
					call fill() then
					if #formTag.checkValidity()
						remove @disabled then remove .opacity-45 then remove .{'bg-green-400'}
						then add .{'bg-[#016934]'}
					else
						add @disabled then add .opacity-45 then add .{'bg-green-400'}
						then remove .{'bg-[#016934]'}
					end"
				/>
			</div>
			<div class="w-full flex flex-col justify-start items-start gap-1">
				<label for="heading" class="font-semibold text-xs">Notification Heading:</label>
				<input
					type="text"
					required
					name="heading"
					id="heading"
					minlength="2"
					maxlength="60"
					placeholder="max 60 characters"
					class="outline-none border-solid border-[#569B78] border-[0.0313rem] rounded p-2 w-full"
					_="on input
					tell #saveButton
					call fill() then
					if #formTag.checkValidity()
						remove @disabled then remove .opacity-45 then remove .{'bg-green-400'}
						then add .{'bg-[#016934]'}
					else
						add @disabled then add .opacity-45 then add .{'bg-green-400'}
						then remove .{'bg-[#016934]'}
					end"
				/>
			</div>
			<div class="w-full flex flex-col justify-start items-start gap-1">
				<label for="body" class="font-semibold text-xs">Notification Body:</label>
				<input
					type="text"
					required
					name="body"
					id="body"
					minlength="2"
					maxlength="200"
					placeholder="max 200 characters"
					class="outline-none border-solid border-[#569B78] border-[0.0313rem] rounded p-2 w-full"
					_="on input
					tell #saveButton
					call fill() then
					if #formTag.checkValidity()
						remove @disabled then remove .opacity-45 then remove .{'bg-green-400'}
						then add .{'bg-[#016934]'}
					else
						add @disabled then add .opacity-45 then add .{'bg-green-400'}
						then remove .{'bg-[#016934]'}
					end"
				/>
			</div>
			<div class="w-full flex flex-col justify-start items-start gap-1">
				<label for="days" class="font-semibold text-xs">Notification Alive:</label>
				<input
					type="number"
					required
					inputmode="numeric"
					name="days"
					id="days"
					min="1"
					max="90"
					placeholder="no. of days the server keeps the notif. alive"
					class="outline-none border-solid border-[#569B78] border-[0.0313rem] rounded p-2 w-full"
					_="on input
					tell #saveButton
					call fill() then
					if #formTag.checkValidity()
						remove @disabled then remove .opacity-45 then remove .{'bg-green-400'}
						then add .{'bg-[#016934]'}
					else
						add @disabled then add .opacity-45 then add .{'bg-green-400'}
						then remove .{'bg-[#016934]'}
					end"
				/>
			</div>
			<section class="mt-10 w-full flex justify-evenly items-center gap-[0.625rem]">
				<button
					id="saveButton"
					disabled
					type="button"
					_="on click call #confirmDialog.showModal()"
					class="text-center opacity-45 bg-green-400 text-white text-sm tracking-[0.1px] font-medium py-[0.625rem] px-4 rounded-md"
				>Create Notification</button>
				<button type="reset" class="bg-red-500 py-[0.625rem] px-4 rounded-md text-white text-sm tracking-[0.1px] font-medium">Reset</button>
			</section>
		</form>
		<section id="render" class="mt-6">
			<p class="font-montserrat font-light text-sm pb-5">Fill the forms... it would render a view of the notification</p>
			<ul class="flex flex-col gap-[2.635rem] justify-center items-center bg-gray-300 py-6 px-2 rounded-lg">
				<li id="liTag" class="w-full flex items-start gap-[0.98rem]">
					<img
						id="closeBtn-img"
						src="/public/assets/svg/closeBtn.svg"
						class="close-btn w-[1.324rem] aspect-square"
					/>
					<div class="w-full">
						<section class="w-full flex justify-between items-center mb-[0.441rem]">
							<p class="title bg-[#BB1D80] text-[#FFFFFF] font-bold text-[0.511rem] leading-[0.623rem] text-center px-[0.929rem] py-[0.078rem] rounded-[0.256rem]"></p>
							<p class="text-[#3C3C4399] font-poppins font-extralight text-[0.477rem] leading-[0.715rem]">{ fmt.Sprintf("%s", time.Now().Local().Format("2006-01-02 15:04:05")) }</p>
						</section>
						<div>
							<p class="heading text-[#000000] font-bold text-start text-[0.626rem] leading-[0.763rem] mb-[0.313rem]"></p>
							<p class="body text-[#000000] font-poppins font-extralight text-[0.626rem] text-start leading-[0.938rem] max-w-[50ch] break-words"></p>
						</div>
					</div>
				</li>
			</ul>
		</section>
		<script>
			function fill() {
				document.querySelector("#liTag .title").innerText = document.querySelector("#title").value;
				document.querySelector("#liTag .heading").innerText = document.querySelector("#heading").value;
				document.querySelector("#liTag .body").innerText = document.querySelector("#body").value;
			}
		</script>
	</main>
}

templ confirmDialog() {
	<dialog id="confirmDialog" class="backdrop:backdrop-blur-sm rounded-2xl py-8 pl-7 pr-9 font-montserrat text-[#2E2E2E]">
		<p class="font-poppins font-medium text-base text-black">Proceed to submit notification?</p>
		<div class="flex justify-between items-center gap-3 my-6">
			<button type="button" _="on click call #formTag.submit()" class="outline-none w-full rounded-md font-medium bg-[#016934] text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-[1.219rem] text-center text-white">Proceed</button>
			<button type="button" _="on click call #confirmDialog.close()" class="outline-none w-full rounded-md font-medium bg-black text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-[0.219rem] text-center text-white">Close</button>
		</div>
	</dialog>
}
