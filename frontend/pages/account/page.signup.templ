package frontend

templ SignUpPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Signup Page</title>
			<link rel="stylesheet" href="/assets/styles/output.css"/>
		</head>
		<body class="bg-white flex items-center justify-center h-screen">
			<div class="bg-white rounded-lg  p-8 w-full max-w-md">
				<div class="flex justify-center mb-6">
					<!-- Logo Image -->
					<img src="/assets/images/beltech_logo_2.jpg" alt="Beltech Logo" class="object-contain w-25"/>
				</div>
				<!-- Form -->
				<form>
					<div class="mb-8">
						<div class="relative">
							<!-- Overlapping Label -->
							<label for="name" class="absolute -top-3 left-3 bg-white px-1 text-sm text-gray-500 font-semibold">Email</label>
							<!-- Input Field -->
							<input id="email" type="text" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline border-green-300" placeholder=""/>
						</div>
					</div>
					<div class="mb-5">
						<div class="relative">
							<!-- Overlapping Label -->
							<label for="password" class="absolute -top-3 left-3 bg-white px-1 text-sm text-gray-500 font-semibold">Password</label>
							<!-- Input Field -->
							<input id="password" type="password" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline border-green-300" placeholder=""/>
						</div>
						<div class="flex items-center justify-between">
							<label class="flex items-center">
								<input type="checkbox" class="form-checkbox text-green-600"/>
								<span class="ml-2 text-gray-600">Remember me</span>
							</label>
							<a href="/verify" class="inline-block align-baseline font-bold text-sm text-green-500 hover:text-green-700">
								Forgot Password?
							</a>
						</div>
					</div>
					<div class="flex items-center justify-center">
						<button class="bg-green-700 hover:bg-green-800 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline w-full" type="button">
							Sign Up
						</button>
					</div>
					<div class="my-6 flex items-center justify-between">
						<hr class="w-full border-gray-300"/>
						<span class="px-2 text-gray-500">OR</span>
						<hr class="w-full border-gray-300"/>
					</div>
					<!-- Social Signup Buttons -->
					<div class="flex items-center justify-center space-x-4">
						<button class="flex items-center bg-white border border-gray-300 text-gray-600 px-4 py-2 rounded-lg shadow hover:bg-gray-100">
							<img src="/assets/svg/google_icon.svg" alt="Google" class="w-10 h-10 mr-2"/>
							Google
						</button>
						<button class="flex items-center bg-white border border-gray-300 text-gray-600 px-4 py-2 rounded-lg shadow hover:bg-gray-100">
							<img src="/assets/svg/facebook_icon.svg" alt="Facebook" class="w-10 h-10 mr-2"/>
							Facebook
						</button>
					</div>
				</form>
				<div class="mt-6 text-center">
					<p class="text-gray-600">
						Already have an account? <a href="/signin" class="text-green-500 font-bold">Log In</a>
					</p>
				</div>
			</div>
		</body>
	</html>
}
