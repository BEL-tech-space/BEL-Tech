package frontend

templ SignUpPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta
				name="viewport"
				content="width=device-width, initial-scale=1.0"
			/>
			<title>Beltech SignUp</title>
			<link
				rel="stylesheet"
				href="/public/assets/styles/output.css"
			/>
			@removeScrollBar()
		</head>
		<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="w-full h-full grid grid-rows-agentDashboardPage pt-[1.438rem]">
				<main class="overflow-y-auto mx-[1.563rem] mt-8 mb-[1.9368rem] text-[#2E2E2E] font-montserrat">
					<img
						src="/public/assets/images/beltech_logo.png"
						alt="Beltech Logo"
						class="w-[7.75rem] aspect-square mx-auto"
					/>
					<form action="" method="post" class="mt-12 flex flex-col w-full gap-3 items-center px-4">
						<div class="w-full flex flex-col justify-start items-start gap-1">
							<label for="username" class="font-semibold text-sm text-left">Username</label>
							<input type="text" autocomplete="off" name="login" id="username" placeholder="sign in with Google" class="border border-green-500 rounded-xl p-2 w-full placeholder:italic placeholder:font-extralight placeholder:pl-2 outline-none"/>
						</div>
						<div class="w-full flex flex-col justify-start items-start gap-1">
							<label for="password" class="font-semibold text-sm text-left">Password</label>
							<input type="password" autocomplete="off" name="login" id="password" placeholder="sign in with Google" class="border border-green-500 rounded-xl p-2 w-full placeholder:italic placeholder:font-extralight placeholder:pl-2 outline-none"/>
						</div>
						<div class="w-full flex justify-between items-center">
							<section class="flex justify-center items-center gap-2">
								<input type="checkbox" checked name="login" id="remember-me" class="accent-[#B1B4B2]"/>
								<label for="remember-me" class="font-medium text-[0.5rem] leading-4 tracking-[0.025rem] text-[#49454F] text-nowrap">Remember Password</label>
							</section>
							<a href="#" class="font-medium text-[#016934] text-[0.5rem] leading-4 tracking-[0.025rem]  text-nowrap">Forgot Password?</a>
						</div>
						<button
							disabled
							type="submit"
							class="mt-6 w-full opacity-40 bg-[#016934] py-[0.625rem] font-medium text-white text-sm text-center rounded-md"
						>
							Log In
						</button>
					</form>
					<p class="mt-8 mb-8 px-6 text-center font-semibold z-10 text-sm leading-4 relative before:content-[''] before:h-[0.0625rem] before:w-[5.625rem] before:absolute before:block before:bg-[#2E2E2E] before:top-1/2 before:left-6 before:-z-10 after:content-[''] after:h-[0.0625rem] after:w-[5.625rem] after:absolute after:block after:bg-[#2E2E2E] after:top-1/2 after:right-6 after:-z-10">
						<span class="mx-2 z-20">OR</span>
					</p>
					<section class="w-full flex justify-between items-center gap-4 px-6">
						<a
							href="/account/auth/google"
							class="flex justify-center items-center gap-3"
						>
							<img
								src="/public/assets/svg/googleLogo.svg"
								alt="Google"
								class="w-10 aspect-square rounded-[6.25rem] p-[0.375rem] bg-white shadow-[0px_0.125rem_0.25rem_0px_#0000001A]"
							/>
							<p class="font-light text-sm leading-[1.063rem] text-center tracking-[0.001em]">Sign Up</p>
						</a>
						<button
							disabled
							href="/account/auth/facebook"
							class="flex justify-center items-center gap-3"
						>
							<img
								src="/public/assets/svg/facebookLogo.svg"
								alt="Facebook"
								class="w-10 aspect-square rounded-[6.25rem] p-[0.375rem] bg-white shadow-[0px_0.125rem_0.25rem_0px_#0000001A]"
							/>
							<p class="font-light text-sm leading-[1.063rem] text-center tracking-[0.001em]">Sign Up</p>
						</button>
					</section>
				</main>
				<footer>
					<p class="font-normal text-sm text-center">Already have an account? <a href="/account/signin" class="text-[#016934] font-bold">Sign In</a></p>
				</footer>
			</div>
		</body>
	</html>
}
