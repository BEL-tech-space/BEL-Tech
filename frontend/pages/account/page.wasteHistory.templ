package frontend

import (
	"fmt"
	"strings"
)

templ WastePage(acc Account, wasteType string, history []string) {
	<!DOCTYPE html>
	<html lang="en">
		@HeadTag("waste")
		<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="Page w-full h-full flex flex-col font-montserrat text-[#2E2E2E]">
				@CommonHeader(acc)
				@WasteMain(acc, wasteType, history)
				@Footer("dashboard", templ.NopComponent)
			</div>
		</body>
		@scriptForWasteAndTipsPage()
	</html>
}

templ scriptForWasteAndTipsPage() {
	<script src="/public/assets/scripts/hyperscript.min.js"></script>
	<script src="/public/assets/scripts/notification.js"></script>
}

templ WasteMain(acc Account, wasteType string, history []string) {
	<main class="grow overflow-y-auto pl-[1.5rem] pr-[1.56rem] pt-[1.875rem] grid grid-rows-wastePage">
		<section class="flex items-center gap-1">
			<p class="leading-[1.143rem] font-semibold text-[0.938rem]">Let's Recycle!</p>
			<picture>
				<source type="image/webp" srcset="/public/assets/images/Recycle_small.webp"/>
				<img
					src="/public/assets/images/Recycle_small.png"
					class="w-5 aspect-square"
				/>
			</picture>
		</section>
		@WasteQuickInfo(wasteType, acc)
		@WasteFilterOptionsPartial()
		@WasteHistoryComp(wasteType, history)
	</main>
}

templ WasteHistoryComp(wasteType string, history []string) {
	if len(history) > 0 {
		@wasteNotEmptyHistory(wasteType)
	} else {
		@wasteEmptyHistory(wasteType)
	}
}

templ WasteMainOpeninTag() {
	@templ.Raw(`<main class="grow overflow-y-auto pl-[1.5rem] pr-[1.56rem] pt-[1.875rem] grid grid-rows-wastePage">
		<section class="flex items-center gap-1">
			<p class="leading-[1.143rem] font-semibold text-[0.938rem]">Let's Recycle!</p>
			<picture>
				<source type="image/webp" srcset="/public/assets/images/Recycle_small.webp"/>
				<img
					src="/public/assets/images/Recycle_small.png"
					class="w-5 aspect-square"
				/>
			</picture>
		</section>`)
}

templ WasteQuickInfo(wasteType string, acc Account) {
	<section class="flex justify-start items-center gap-4 mt-6 mb-10">
		switch wasteType {
			case "paper" :
				<picture>
					<source type="image/webp" srcset="/public/assets/images/book.webp"/>
					<img src="/public/assets/images/book.jpg" alt="" class="w-[6.875rem] aspect-square rounded-[0.516rem] bg-[#1E1E1E33]"/>
				</picture>
				<div class="flex flex-col justify-start items-start gap-1 text-[#3A3A3A]">
					<p class="font-bold text-[0.806rem] leading-[0.983rem]">Material: <span class="font-semibold">Paper</span></p>
					<p class="font-bold text-[0.733rem] leading-[0.893rem]">Total Earned: <span class="font-medium font-poppins">{ fmt.Sprintf("%.4f BEL", acc.TotalPaperWaste) }</span></p>
				</div>
			case "glass" :
				<picture>
					<source type="image/webp" srcset="/public/assets/images/glass.webp"/>
					<img src="/public/assets/images/glass.jpg" alt="" class="w-[6.875rem] aspect-square rounded-[0.516rem] bg-[#1E1E1E33]"/>
				</picture>
				<div class="flex flex-col justify-start items-start gap-1 text-[#3A3A3A]">
					<p class="font-bold text-[0.806rem] leading-[0.983rem]">Material: <span class="font-semibold">Glass</span></p>
					<p class="font-bold text-[0.733rem] leading-[0.893rem]">Total Earned: <span class="font-medium font-poppins">{ fmt.Sprintf("%.4f BEL", acc.TotalGlassWaste) }</span></p>
				</div>
			case "metal" :
				<picture>
					<source type="image/webp" srcset="/public/assets/images/metal2.webp"/>
					<img src="/public/assets/images/metal2.jpg" alt="" class="w-[6.875rem] aspect-square rounded-[0.516rem] bg-[#1E1E1E33]"/>
				</picture>
				<div class="flex flex-col justify-start items-start gap-1 text-[#3A3A3A]">
					<p class="font-bold text-[0.806rem] leading-[0.983rem]">Material: <span class="font-semibold">Metal</span></p>
					<p class="font-bold text-[0.733rem] leading-[0.893rem]">Total Earned: <span class="font-medium font-poppins">{ fmt.Sprintf("%.4f BEL", acc.TotalMetalWaste) }</span></p>
				</div>
			case "plastics" :
				<picture>
					<source type="image/webp" srcset="/public/assets/images/plastic_2.webp"/>
					<img src="/public/assets/images/plastic_2.jpg" alt="" class="w-[6.875rem] aspect-square rounded-[0.516rem] bg-[#1E1E1E33]"/>
				</picture>
				<div class="flex flex-col justify-start items-start gap-1 text-[#3A3A3A]">
					<p class="font-bold text-[0.806rem] leading-[0.983rem]">Material: <span class="font-semibold">Plastics</span></p>
					<p class="font-bold text-[0.733rem] leading-[0.893rem]">Total Earned: <span class="font-medium font-poppins">{ fmt.Sprintf("%.4f BEL", acc.TotalPlasticsWaste) }</span></p>
				</div>
		}
	</section>
}

templ WasteFilterOptionsPartial() {
	<section class="w-full flex justify-between items-center">
		<p class="text-[0.938rem] leading-[1.143rem] font-semibold">Overview</p>
		<div class="bg-[#01693433] pl-[0.5rem] pr-[0.833rem] flex justify-center items-center gap-[0.417rem] rounded-[1.562rem]">
			<select name="filter" id="filter" class="appearance-none min-w-fit outline-none">
				<option value="" class="">this week</option>
				<hr/>
				<optgroup label="range">
					<option value="lastweek" class="">last week</option>
					<option value="2Weeks" class="">2wk ago</option>
					<option value="3Weeks" class="">3wk ago</option>
					<option value="4Weeks" class="">4wk ago</option>
					<option value="thisMonth" class="">this month</option>
				</optgroup>
				<hr/>
				<optgroup label="result">
					<option value="single" class="">single</option>
					<option value="combined" class="">combined</option>
				</optgroup>
			</select>
			<label for="filter">
				<img
					src="/public/assets/svg/filter_small.svg"
					alt="Notifications"
					class="w-4 aspect-square"
				/>
			</label>
		</div>
	</section>
}

templ wasteNotEmptyHistory(wasteType string) {
	<section class="overflow-y-auto mt-8 max-h-full">
		<ul class="flex flex-col justify-start items-start gap-9 py-2">
			for range 8 {
				<li class="sucess grid grid-cols-2 justify-between w-full">
					<div class="flex flex-col justify-start items-start gap-4">
						<div class="flex items-start gap-2">
							<p class="font-medium text-[0.643rem] leading-[0.832rem] text-black">{ fmt.Sprintf("%s: %.2fkg", strings.ToUpper(wasteType), 23.45) }</p>
							<p class="bg-[#299960] rounded-[9.391rem] text-center font-bold text-white text-[0.235rem] leading-[0.286rem] py-[0.0788rem] px-[0.729rem]">
								Success
							</p>
						</div>
						<div class="text-nowrap flex flex-col gap-2 items-start pb-4 font-medium text-[0.558rem] leading-[0.681]">
							<p>Token Earned: 2 BEL</p>
							<p>TransactionName: Albert Tyson</p>
						</div>
					</div>
					<div class="flex flex-col h-full justify-between items-end">
						<p class="font-medium text-[#807B7B] text-[0.5rem] leading-[0.609rem]">24-05-24 03:30:45</p>
						<button onclick="">
							<img src="/public/assets/svg/bi_qr-code.svg" alt="" class="w-[1.125rem] aspect-square"/>
						</button>
					</div>
				</li>
			}
		</ul>
	</section>
}

templ wasteEmptyHistory(wasteType string) {
	<section class="h-full w-full flex justify-center items-center">
		<p class="text-[#3A3A3A] text-base font-tt_chocolate font-light text-nowrap">{ fmt.Sprintf("No history for %s", strings.ToUpper(wasteType) ) }</p>
	</section>
}
