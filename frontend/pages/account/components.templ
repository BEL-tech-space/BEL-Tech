package frontend

templ menuComp(active string) {
	<footer class="bg-white flex w-full justify-around mt-[1.125rem] gap-[2.375rem]">
		if active == "dashboard" {
			<a
				href="/account/dashboard"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/assets/svg/home bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Home</p>
			</a>
		} else {
			<a
				href="/account/dashboard"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/assets/svg/home linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Home</p>
			</a>
		}
		if active == "scan" {
			<a
				href="/account/scan"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/assets/svg/scan bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Scan</p>
			</a>
		} else {
			<a
				href="/account/scan"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/assets/svg/scan linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Scan</p>
			</a>
		}
		if active == "location" {
			<a
				href="/account/location"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/assets/svg/location bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Location</p>
			</a>
		} else {
			<a
				href="/account/location"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/assets/svg/location linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Location</p>
			</a>
		}
		if active == "wallet" {
			<a
				href="/account/wallet"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/assets/svg/wallet bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Wallet</p>
			</a>
		} else {
			<a
				href="/account/wallet"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/assets/svg/wallet linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Wallet</p>
			</a>
		}
		if active == "exchange" {
			<a
				href="/account/spend"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/assets/svg/new_exchange_bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Spend</p>
			</a>
		} else {
			<a
				href="/account/spend"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/assets/svg/new_exchange_linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Spend</p>
			</a>
		}
	</footer>
}

templ profileBar(user User) {
	<header class="pt-[1.5rem] pl-[1.5rem] pr-[1.56rem] flex w-full justify-start items-center">
		<a href="/account/profile">
			<img
				src={ user.AvatarUrl }
				class="rounded-full w-[1.86rem] aspect-square mr-[0.5rem]"
			/>
		</a>
		if user.NickName != "" {
			<p class="leading-[0.91rem] font-[500] text-[0.75rem]">
				Gm,
				<span class="font-[600]">{ user.NickName }</span>
			</p>
		} else if user.FirstName != "" {
			<p class="leading-[0.91rem] font-[500] text-[0.75rem]">
				Gm,
				<span class="font-[600]">{ user.FirstName }</span>
			</p>
		} else if user.LastName != "" {
			<p class="leading-[0.91rem] font-[500] text-[0.75rem]">
				Gm,
				<span class="font-[600]">{ user.LastName }</span>
			</p>
		} else {
			<p class="leading-[0.91rem] font-[500] text-[0.75rem]">
				Gm
			</p>
		}
		<button class="bg-[#CCE1D699] p-[0.5rem] ml-auto rounded-md flex justify-center items-center">
			<img
				src="/assets/svg/notification.svg"
				class="w-6 aspect-square"
			/>
		</button>
	</header>
}
