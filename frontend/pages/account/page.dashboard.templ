package frontend

import (
	"fmt"
	"html/template"
	"time"
)

templ DashboardPage(acc Account, chart template.HTML, isEmpty, isNewAccount bool) {
	<!DOCTYPE html>
	<html lang="en">
		@HeadTag("dashboard")
		<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="Page w-full h-full flex flex-col font-montserrat text-[#2E2E2E]">
				@CommonHeader(acc)
				@DashboardMain(chart, isEmpty)
				@Footer("dashboard", templ.NopComponent)
			</div>
		</body>
		if isNewAccount {
			@ToastMessage(SuccessToast, "Welcome to Beltech!")
			@confetti()
		}
		@scriptForDashboardPage()
	</html>
}

templ DashboardMain(chart template.HTML, isEmpty bool) {
	<main class="grow overflow-y-scroll pl-6 pr-[1.56rem] pt-[1.875rem] pb-2">
		@DashboardSwiperOne()
		@DashboardDataViz(chart, isEmpty)
		@DashboardSwiperTwo()
	</main>
}

templ DashboardMainOpeningTag() {
	@templ.Raw(`<main class="grow overflow-y-scroll pl-6 pr-[1.56rem] pt-[1.875rem] pb-2">`)
}

templ scriptForDashboardPage() {
	<script src="/public/assets/scripts/swiper-bundle.min.js"></script>
	<script src="/public/assets/scripts/htmx.min.js"></script>
	<script>
        const swiperOne = new Swiper( '.mySwiperOne', {
            direction: "horizontal",
            slidesPerView: 2,
            mousewheel: true,
            spaceBetween: 8,
            autoplay: {
                delay: 3000,
                disableOnInteraction: true,
            },
        } );

        const swiperTwo = new Swiper( '.mySwiperTwo', {
            mousewheel: true,
            keyboard: true,
			spaceBetween: 8,
            autoplay: {
                delay: 3000,
                disableOnInteraction: true,
            },
        } );

		document.querySelectorAll('.graph-select').forEach(button => {
			button.addEventListener('click', () => {
				document.querySelectorAll('.graph-select').forEach(btn => {
					btn.classList.remove('bg-[#016934]', 'text-[#FFFFFF]');
					btn.classList.add('bg-[#FFFFFF]', 'text-[#000000]');
				});
				button.classList.remove('bg-[#FFFFFF]', 'text-[#000000]');
				button.classList.add('bg-[#016934]', 'text-[#FFFFFF]');
			});
		});

		 window.addEventListener('load', () => {
			if ('serviceWorker' in navigator) {
				navigator.serviceWorker.register('/public/sw.js', {scope: "/"}).then((sw) => {
					console.log('Service worker registered!');
				}).catch((error) => {
					console.warn('Error registering service worker:');
					console.warn(error);
				});
			}
		});
    </script>
}

templ DashboardSwiperOne() {
	<section class="flex items-center gap-1">
		<p class="leading-[1.143rem] font-semibold text-[0.938rem]">Let's Recycle</p>
		<picture>
			<source type="image/webp" srcset="/public/assets/images/Recycle_small.webp"/>
			<img
				src="/public/assets/images/Recycle_small.png"
				class="w-5 aspect-square"
			/>
		</picture>
	</section>
	<section class="swiperOne mt-[0.86rem] mr-0">
		<div class="swiper mySwiperOne w-full">
			<div class="swiper-wrapper">
				<div class="swiper-slide">
					<a href="/account/waste/paper" class="relative block">
						<picture>
							<source type="image/webp" srcset="/public/assets/images/book.webp"/>
							<img
								fetchpriorty="high"
								src="/public/assets/images/book.jpg"
								class="w-[10rem] aspect-square rounded-xl "
							/>
						</picture>
						<div class="absolute bottom-4 left-4 text-white text-left">
							<p class="font-semibold text-xs leading-[0.838rem]">PAPER</p>
							<p class="font-bold text-[0.625rem] leading-[0.762rem]">50 BEL</p>
						</div>
					</a>
				</div>
				<div class="swiper-slide">
					<a href="/account/waste/glass" class="relative block">
						<picture>
							<source type="image/webp" srcset="/public/assets/images/glass.webp"/>
							<img
								fetchpriorty="high"
								src="/public/assets/images/glass.jpg"
								class="w-[10rem] aspect-square rounded-xl"
							/>
						</picture>
						<div class="absolute bottom-4 left-4 text-white text-left">
							<p class="font-semibold text-xs leading-[0.838rem]">GLASS</p>
							<p class="font-bold text-[0.625rem] leading-[0.762rem]">50 BEL</p>
						</div>
					</a>
				</div>
				<div class="swiper-slide">
					<a href="/account/waste/metal" class="relative block">
						<picture>
							<source type="image/webp" srcset="/public/assets/images/metal2.webp"/>
							<img
								fetchpriorty="high"
								src="/public/assets/images/metal2.jpg"
								class="w-[10rem] aspect-square rounded-xl"
							/>
						</picture>
						<div class="absolute bottom-4 left-4 text-white text-left">
							<p class="font-semibold text-xs leading-[0.838rem]">METAL</p>
							<p class="font-bold text-[0.625rem] leading-[0.762rem]">50 BEL</p>
						</div>
					</a>
				</div>
				<div class="swiper-slide">
					<a href="/account/waste/plastics" class="relative block">
						<picture>
							<source type="image/webp" srcset="/public/assets/images/plastic_2.webp"/>
							<img
								fetchpriorty="high"
								src="/public/assets/images/plastic_2.jpg"
								class="w-[10rem] aspect-square rounded-xl "
							/>
						</picture>
						<div class="absolute bottom-4 left-4 text-white text-left">
							<p class="font-semibold text-xs leading-[0.838rem]">PLASTICS</p>
							<p class="font-bold text-[0.625rem] leading-[0.762rem]">50 BEL</p>
						</div>
					</a>
				</div>
			</div>
		</div>
	</section>
	<section class="mt-8 w-full flex items-start justify-between">
		<p class="font-semibold text-[0.94rem] leading-[1.14rem]">Recycled</p>
		// <button
		// 	hx-get="/account/dashboard/chart/0"
		// 	hx-trigger="click"
		// 	hx-swap="outerHTML"
		// 	hx-target="#echart"
		// >
		// <p class="font-[500] text-[0.63rem] leading-[0.76rem] text-[#016934]">see all</p>
		// </button>
	</section>
}

templ DashboardDataViz(chart template.HTML, isEmpty bool) {
	<section class="mt-5">
		@DashboardEchart(chart, isEmpty)
		<div class="flex justify-between items-center gap-8  px-2">
			<button
				hx-get="/account/dashboard/chart?month=4"
				hx-trigger="click"
				hx-swap="outerHTML"
				hx-target="#echart"
				class="graph-select font-poppins font-semibold  text-[0.5rem] leading-3 py-[0.563rem] 
			pl-[0.688rem] pr-[0.75rem] bg-[#FFFFFF] text-[#000000] [box-shadow:0rem_0.0575rem_0.115rem_0.0575rem_#00000014] rounded-[0.344rem]"
			>{ fmt.Sprintf("%s", time.Now().AddDate(0, -4, 0).Format("Jan")) }</button>
			<button
				hx-get="/account/dashboard/chart?month=3"
				hx-trigger="click"
				hx-swap="outerHTML"
				hx-target="#echart"
				class="graph-select font-poppins font-semibold  text-[0.5rem] leading-3 py-[0.563rem] 
			pl-[0.688rem] pr-[0.75rem] bg-[#FFFFFF] text-[#000000] [box-shadow:0rem_0.0575rem_0.115rem_0.0575rem_#00000014] rounded-[0.344rem]"
			>{ fmt.Sprintf("%s", time.Now().AddDate(0, -3, 0).Format("Jan")) }</button>
			<button
				hx-get="/account/dashboard/chart?month=2"
				hx-trigger="click"
				hx-swap="outerHTML"
				hx-target="#echart"
				class="graph-select font-poppins font-semibold  text-[0.5rem] leading-3 py-[0.563rem] 
			pl-[0.688rem] pr-[0.75rem] bg-[#FFFFFF] text-[#000000] [box-shadow:0rem_0.0575rem_0.115rem_0.0575rem_#00000014] rounded-[0.344rem]"
			>{ fmt.Sprintf("%s", time.Now().AddDate(0, -2, 0).Format("Jan")) }</button>
			<button
				hx-get="/account/dashboard/chart?month=1"
				hx-trigger="click"
				hx-swap="outerHTML"
				hx-target="#echart"
				class="graph-select font-poppins font-semibold  text-[0.5rem] leading-3 py-[0.563rem] 
			pl-[0.688rem] pr-[0.75rem] bg-[#FFFFFF] text-[#000000] [box-shadow:0rem_0.0575rem_0.115rem_0.0575rem_#00000014] rounded-[0.344rem]"
			>{ fmt.Sprintf("%s", time.Now().AddDate(0, -1, 0).Format("Jan")) }</button>
			<button
				hx-get="/account/dashboard/chart?month=0"
				hx-trigger="click"
				hx-swap="outerHTML"
				hx-target="#echart"
				class="graph-select font-poppins font-semibold text-[0.5rem] leading-3 py-[0.563rem] 
			pl-[0.688rem] pr-[0.75rem] bg-[#016934] text-[#FFFFFF] [box-shadow:0rem_0.0575rem_0.115rem_0.0575rem_#00000014] rounded-[0.344rem]"
			>{ fmt.Sprintf("%s.", time.Now().AddDate(0, -0, 0).Format("Jan")) }</button>
		</div>
	</section>
}

templ DashboardEchart(chart template.HTML, isEmpty bool) {
	<div id="echart" class="bg-transparent relative">
		@templ.Raw(chart)
		if isEmpty {
			<div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-xs font-tt_chocolate font-light text-nowrap">No colletion waste data for this month</div>
		}
	</div>
}

templ DashboardSwiperTwo() {
	<p class="font-semibold text-[0.938rem] leading-[1.143rem] mt-6">Tips on Recycling</p>
	<section class="swiperTwo mt-4">
		<div class="px-4 swiper mySwiperTwo w-full">
			<div class="swiper-wrapper">
				<a href="/account/tips/plastics" class="swiper-slide block">
					<div class="bg-[#FEF7FF] rounded-lg flex items-center justify-center p-[0.313rem]">
						<img
							src="/public/assets/svg/manWithPlastics.svg"
							class="w-[6.875rem] aspect-[110/101] mx-[0.313rem] mr-[0.313rem] rounded-lg"
						/>
						<div class="flex flex-col gap-2">
							<div class="flex items-center gap-[0.313rem]">
								<p class="font-semibold text-[0.688rem] leading-[0.838rem]">PLASTICS:</p>
								<picture>
									<source type="image/webp" srcset="/public/assets/images/Recycle_small.webp"/>
									<img
										src="/public/assets/images/Recycle_small.png"
										alt=""
										class="w-[0.813rem] aspect-square"
									/>
								</picture>
							</div>
							<p class="font-[500] text-[0.625rem] leading-[0.875rem] text-left">
								Twist on the bottle
								caps before tossing them in the bin to make it
								easier
								for recyclers.
							</p>
						</div>
					</div>
				</a>
				<a href="/account/tips/glass" class="swiper-slide block">
					<div class="bg-[#FEF7FF] rounded-lg flex items-center justify-center p-[0.313rem]">
						<img
							src="/public/assets/svg/glassSwipper.svg"
							class="w-[6.875rem] aspect-[110/101] mx-[0.313rem] mr-[0.313rem] rounded-lg"
						/>
						<div class="flex flex-col gap-2">
							<div class="flex items-center gap-[0.313rem]">
								<p class="font-semibold text-[0.688rem] leading-[0.838rem]">GLASS:</p>
								<picture>
									<source type="image/webp" srcset="/public/assets/images/Recycle_small.webp"/>
									<img
										src="/public/assets/images/Recycle_small.png"
										alt=""
										class="w-[0.813rem] aspect-square"
									/>
								</picture>
							</div>
							<p class="font-[500] text-[0.625rem] leading-[0.875rem] text-left">
								Remove food or drink residues from the glass as it can contaminate recycling process.
							</p>
						</div>
					</div>
				</a>
				<a href="/account/tips/metal" class="swiper-slide block">
					<div class="bg-[#FEF7FF] rounded-lg flex items-center justify-center p-[0.313rem]">
						<img
							src="/public/assets/svg/metalSwipper.svg"
							class="w-[6.875rem] aspect-[110/101] mx-[0.313rem] mr-[0.313rem] rounded-lg"
						/>
						<div class="flex flex-col gap-2">
							<div class="flex items-center gap-[0.313rem]">
								<p class="font-semibold text-[0.688rem] leading-[0.838rem]">METAL:</p>
								<picture>
									<source type="image/webp" srcset="/public/assets/images/Recycle_small.webp"/>
									<img
										src="/public/assets/images/Recycle_small.png"
										alt=""
										class="w-[0.813rem] aspect-square"
									/>
								</picture>
							</div>
							<p class="font-[500] text-[0.625rem] leading-[0.875rem] text-left">
								Be careful not to crush metals like cans, as it makes sorting easier before recycling.
							</p>
						</div>
					</div>
				</a>
				<a href="/account/tips/paper" class="swiper-slide block">
					<div class="bg-[#FEF7FF] rounded-lg flex items-center justify-center p-[0.313rem]">
						<img
							src="/public/assets/svg/paperSwipper.svg"
							class="w-[6.875rem] aspect-[110/101] mx-[0.313rem] mr-[0.313rem] rounded-lg"
						/>
						<div class="flex flex-col gap-2">
							<div class="flex items-center gap-[0.313rem]">
								<p class="font-semibold text-[0.688rem] leading-[0.838rem]">PAPER:</p>
								<img
									src="/public/assets/images/Recycle_small.png"
									alt=""
									class="w-[0.813rem] aspect-square"
								/>
							</div>
							<p class="font-[500] text-[0.625rem] leading-[0.875rem] text-left">
								Wet paper can become too damaged to recycle, as paper weakens fibers. So keep paper dry!											
							</p>
						</div>
					</div>
				</a>
			</div>
		</div>
	</section>
}

templ confetti() {
	<script src="/public/assets/scripts/confetti.browser.min.js"></script>
	<script type="module">
		await new Promise(resolve => setTimeout(resolve, 400));
		var duration = 5000;
		var animationEnd = Date.now() + duration;
		var defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 0 };

		function randomInRange(min, max) {
		return Math.random() * (max - min) + min;
		}

		var interval = setInterval(function() {
		var timeLeft = animationEnd - Date.now();

		if (timeLeft <= 0) {
			return clearInterval(interval);
		}

		var particleCount = 50 * (timeLeft / duration);
		// since particles fall down, start a bit higher than random
		confetti({ ...defaults, particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 } });
		confetti({ ...defaults, particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 } });
		}, 250);
	</script>
}

templ serviceWorkerRegistration() {
	<!-- This script tag uses JavaScript modules, so the proper `type` attribute value is required -->
	<script type="module">
	// This code sample uses features introduced in Workbox v6.
	import {Workbox} from 'https://storage.googleapis.com/workbox-cdn/releases/6.4.1/workbox-window.prod.mjs';

	if ('serviceWorker' in navigator) {
		const wb = new Workbox('/sw.js');
		let registration;

		const showSkipWaitingPrompt = async (event) => {
		// Assuming the user accepted the update, set up a listener
		// that will reload the page as soon as the previously waiting
		// service worker has taken control.
		wb.addEventListener('controlling', () => {
			// At this point, reloading will ensure that the current
			// tab is loaded under the control of the new service worker.
			// Depending on your web app, you may want to auto-save or
			// persist transient state before triggering the reload.
			window.location.reload();
		});

		// When `event.wasWaitingBeforeRegister` is true, a previously
		// updated service worker is still waiting.
		// You may want to customize the UI prompt accordingly.

		// This code assumes your app has a promptForUpdate() method,
		// which returns true if the user wants to update.
		// Implementing this is app-specific; some examples are:
		// https://open-ui.org/components/alert.research or
		// https://open-ui.org/components/toast.research
		const updateAccepted = await promptForUpdate();

		if (updateAccepted) {
			wb.messageSkipWaiting();
		}
		};

		// Add an event listener to detect when the registered
		// service worker has installed but is waiting to activate.
		wb.addEventListener('waiting', (event) => {
		showSkipWaitingPrompt(event);
		});

		wb.register();
	}
</script>
}
