package frontend

templ AccountDashboardPage(user User) {
	<!DOCTYPE html>
	<html lang="en">
		@htmlHeadTag("Dashboard")
		<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="Page w-full h-full flex flex-col font-montserrat text-[#2E2E2E]">
				@frequentHeaderOne(user)
				<main class="grow overflow-y-scroll pl-[1.5rem] pr-[1.56rem] pt-[1.875rem]">
					@letRecycleAndProfile("Let's Recycle!")
					<section class="swiperOne mt-[0.86rem] mr-0">
						<div class="swiper mySwiper w-full">
							<div class="swiper-wrapper">
								<div class="swiper-slide">
									<a href="/account/waste/paper" class="relative block">
										<img
											src="/public/assets/images/book.jpg"
											class="w-[10rem] aspect-square rounded-xl "
										/>
										<div class="absolute bottom-4 left-4 text-white text-left">
											<p class="font-semibold text-xs leading-[0.838rem]">PAPER</p>
											<p class="font-bold text-[0.625rem] leading-[0.762rem]">50 BEL</p>
										</div>
									</a>
								</div>
								<div class="swiper-slide">
									<a href="/account/waste/glass" class="relative block">
										<img
											src="/public/assets/images/glass.jpg"
											class="w-[10rem] aspect-square rounded-xl"
										/>
										<div class="absolute bottom-4 left-4 text-white text-left">
											<p class="font-semibold text-xs leading-[0.838rem]">GLASS</p>
											<p class="font-bold text-[0.625rem] leading-[0.762rem]">50 BEL</p>
										</div>
									</a>
								</div>
								<div class="swiper-slide">
									<a href="/account/waste/metal" class="relative block">
										<img
											src="/public/assets/images/metal2.jpg"
											class="w-[10rem] aspect-square rounded-xl"
										/>
										<div class="absolute bottom-4 left-4 text-white text-left">
											<p class="font-semibold text-xs leading-[0.838rem]">METAL</p>
											<p class="font-bold text-[0.625rem] leading-[0.762rem]">50 BEL</p>
										</div>
									</a>
								</div>
								<div class="swiper-slide">
									<a href="/account/waste/plastics" class="relative block">
										<img
											src="/public/assets/images/plastic_2.jpg"
											class="w-[10rem] aspect-square rounded-xl "
										/>
										<div class="absolute bottom-4 left-4 text-white text-left">
											<p class="font-semibold text-xs leading-[0.838rem]">PLASTICS</p>
											<p class="font-bold text-[0.625rem] leading-[0.762rem]">50 BEL</p>
										</div>
									</a>
								</div>
							</div>
						</div>
					</section>
					<section class="mt-8 w-full flex items-center justify-between">
						<p class="font-[600] text-[0.94rem] leading-[1.14rem]">Recycled</p>
						<button>
							<p class="font-[500] text-[0.63rem] leading-[0.76rem] text-[#016934]">see all</p>
						</button>
					</section>
					<section class="mt-4 flex flex-col gap-4">
						<div class="bg-[#FEF7FF] w-full rounded-lg flex gap-2">
							<img
								src="/public/assets/images/sports_bottle.jpg"
								class="w-[4.69rem] aspect-[75/70] py-[0.31rem] pr-[0.31rem] rounded-lg"
							/>
							<div class="flex flex-col gap-0.5 ml-4 mt-[1.188rem] mb-[1.125rem]">
								<p class="font-[500] leading-[0.838rem] text-[0.688rem]">Sport plastic bottle</p>
								<p class="font-[700] leading-[0.0.762rem] text-[0.625rem]">54 recycled</p>
							</div>
							<img
								src="/public/assets/svg/back_arrow.svg"
								class="rotate-180 ml-auto w-[0.938rem] aspect-square"
							/>
						</div>
						<div class="bg-[#FEF7FF] w-full rounded-lg flex gap-2">
							<img
								src="/public/assets/images/paper_bag.jpg"
								class="w-[4.69rem] aspect-[75/70] py-[0.31rem] pr-[0.31rem] rounded-lg"
							/>
							<div class="flex flex-col gap-0.5 ml-4 mt-[1.188rem] mb-[1.125rem]">
								<p class="font-[500] leading-[0.838rem] text-[0.688rem]">Small paper bag</p>
								<p class="font-[700] leading-[0.0.762rem] text-[0.625rem]">45 recycled</p>
							</div>
							<img
								src="/public/assets/svg/back_arrow.svg"
								class="rotate-180 ml-auto w-[0.938rem] aspect-square"
							/>
						</div>
					</section>
					<p class="mt-8 font-[600] text-[0.938rem] leading-[1.143rem]">Tips on Recycling</p>
					<section class="swiperTwo mt-4">
						<div class="px-4 swiper mySwiperTwo w-full">
							<div class="swiper-wrapper">
								<a href="/account/tips/plastics" class="swiper-slide block">
									<div class="bg-[#FEF7FF] rounded-lg flex items-center justify-center p-[0.313rem]">
										<img
											src="/public/assets/images/plastic_1.jpg"
											class="w-[6.875rem] aspect-[110/101] mx-[0.313rem] mr-[0.313rem] rounded-lg"
										/>
										<div class="flex flex-col gap-2">
											<div class="flex items-center gap-[0.313rem]">
												<p class="font-[600] text-[0.688rem] leading-[0.838rem]">Plastics:</p>
												<img
													src="/public/assets/images/Recycle_small.png"
													alt=""
													class="w-[0.813rem] aspect-square"
												/>
											</div>
											<p class="font-[500] text-[0.625rem] leading-[0.875rem] text-left">
												Twist on the bottle
												caps before tossing them in the bin to make it
												easier
												for recyclers.
											</p>
										</div>
									</div>
								</a>
								<a href="/account/tips/glass" class="swiper-slide block">
									<div class="bg-[#FEF7FF] rounded-lg flex items-center justify-center p-[0.313rem]">
										<img
											src="/public/assets/svg/glassSwipper.svg"
											class="w-[6.875rem] aspect-[110/101] mx-[0.313rem] mr-[0.313rem] rounded-lg"
										/>
										<div class="flex flex-col gap-2">
											<div class="flex items-center gap-[0.313rem]">
												<p class="font-[600] text-[0.688rem] leading-[0.838rem]">GLASS:</p>
												<img
													src="/public/assets/images/Recycle_small.png"
													alt=""
													class="w-[0.813rem] aspect-square"
												/>
											</div>
											<p class="font-[500] text-[0.625rem] leading-[0.875rem] text-left">
												Remove food or drink residues from the glass as it can contaminate recycling process.
											</p>
										</div>
									</div>
								</a>
								<a href="/account/tips/metal" class="swiper-slide block">
									<div class="bg-[#FEF7FF] rounded-lg flex items-center justify-center p-[0.313rem]">
										<img
											src="/public/assets/svg/metalSwipper.svg"
											class="w-[6.875rem] aspect-[110/101] mx-[0.313rem] mr-[0.313rem] rounded-lg"
										/>
										<div class="flex flex-col gap-2">
											<div class="flex items-center gap-[0.313rem]">
												<p class="font-[600] text-[0.688rem] leading-[0.838rem]">METAL:</p>
												<img
													src="/public/assets/images/Recycle_small.png"
													alt=""
													class="w-[0.813rem] aspect-square"
												/>
											</div>
											<p class="font-[500] text-[0.625rem] leading-[0.875rem] text-left">
												Be careful not to crush metals like cans, as it makes sorting easier before recycling.
											</p>
										</div>
									</div>
								</a>
								<a href="/account/tips/paper" class="swiper-slide block">
									<div class="bg-[#FEF7FF] rounded-lg flex items-center justify-center p-[0.313rem]">
										<img
											src="/public/assets/svg/paperSwipper.svg"
											class="w-[6.875rem] aspect-[110/101] mx-[0.313rem] mr-[0.313rem] rounded-lg"
										/>
										<div class="flex flex-col gap-2">
											<div class="flex items-center gap-[0.313rem]">
												<p class="font-[600] text-[0.688rem] leading-[0.838rem]">PAPER:</p>
												<img
													src="/public/assets/images/Recycle_small.png"
													alt=""
													class="w-[0.813rem] aspect-square"
												/>
											</div>
											<p class="font-[500] text-[0.625rem] leading-[0.875rem] text-left">
												Wet paper can become too damaged to recycle, as paper weakens fibers. So keep paper dry!											
											</p>
										</div>
									</div>
								</a>
							</div>
						</div>
					</section>
				</main>
				@footerMenubar("dashboard")
			</div>
		</body>
		<script type="text/javascript">
        const swiper = new Swiper( '.mySwiper', {
            direction: "horizontal",
            slidesPerView: 2,
            mousewheel: true,
            spaceBetween: 8,
            autoplay: {
                delay: 3000,
                disableOnInteraction: true,
            },
        } );

        const swiperTwo = new Swiper( '.mySwiperTwo', {
            mousewheel: true,
            keyboard: true,
            autoplay: {
                delay: 1500,
                disableOnInteraction: true,
            },
        } );

		 window.addEventListener('load', () => {
			if ('serviceWorker' in navigator) {
				navigator.serviceWorker.register('/public/swThree.js').then(() => {
					console.log('Service worker registered!');
				}).catch((error) => {
					console.warn('Error registering service worker:');
					console.warn(error);
				});
			}
		});
    </script>
	</html>
}

templ letRecycleAndProfile(text string) {
	<article class="flex items-center gap-1">
		<p class="leading-[1.143rem] font-semibold text-[0.938rem]">{ text }</p>
		<img
			src="/public/assets/images/Recycle_small.png"
			class="w-5 aspect-square"
		/>
	</article>
}
