package frontend

import "html/template"

templ DashboardPage(acc Account, chart template.HTML) {
	<!DOCTYPE html>
	<html lang="en">
		@HeadTag("dashboard")
		<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="Page w-full h-full flex flex-col font-montserrat text-[#2E2E2E]">
				@CommonHeaderOne(acc, templ.NopComponent)
				@DashboardMain(chart)
				@Footer("dashboard", templ.NopComponent)
			</div>
		</body>
		@scriptForDashboardPage()
	</html>
}

templ DashboardMain(chart template.HTML) {
	<main class="grow overflow-y-scroll pl-6 pr-[1.56rem] pt-[1.875rem]">
		@LetRecycleAndProfile("Let's Recycle!")
		@DashboardSwiperOne()
		@DashboardRecycledAndSeeAll()
		@DashboardDataViz(chart)
		@DashboardTipsParagraph()
		@DashboardSwiperTwo()
	</main>
}

templ DashboardMainOpeningTag() {
	@templ.Raw(`<main class="grow overflow-y-scroll pl-6 pr-[1.56rem] pt-[1.875rem]">`)
}

templ scriptForDashboardPage() {
	<script src="/public/assets/scripts/swiper-bundle.min.js"></script>
	<script>
        const swiperOne = new Swiper( '.mySwiperOne', {
            direction: "horizontal",
            slidesPerView: 2,
            mousewheel: true,
            spaceBetween: 8,
            autoplay: {
                delay: 3000,
                disableOnInteraction: true,
            },
        } );

        const swiperTwo = new Swiper( '.mySwiperTwo', {
            mousewheel: true,
            keyboard: true,
			spaceBetween: 8,
            autoplay: {
                delay: 1500,
                disableOnInteraction: true,
            },
        } );

		 window.addEventListener('load', () => {
			if ('serviceWorker' in navigator) {
				navigator.serviceWorker.register('/public/sw.js', {scope: "/"}).then((sw) => {
					console.log('Service worker registered!');
				}).catch((error) => {
					console.warn('Error registering service worker:');
					console.warn(error);
				});
			}
		});
    </script>
}

templ DashboardSwiperOne() {
	<section class="swiperOne mt-[0.86rem] mr-0">
		<div class="swiper mySwiperOne w-full">
			<div class="swiper-wrapper">
				<div class="swiper-slide">
					<a href="/account/waste/paper" class="relative block">
						<picture>
							<source type="image/webp" srcset="/public/assets/images/book.webp"/>
							<img
								src="/public/assets/images/book.jpg"
								class="w-[10rem] aspect-square rounded-xl "
							/>
						</picture>
						<div class="absolute bottom-4 left-4 text-white text-left">
							<p class="font-semibold text-xs leading-[0.838rem]">PAPER</p>
							<p class="font-bold text-[0.625rem] leading-[0.762rem]">50 BEL</p>
						</div>
					</a>
				</div>
				<div class="swiper-slide">
					<a href="/account/waste/glass" class="relative block">
						<picture>
							<source type="image/webp" srcset="/public/assets/images/glass.webp"/>
							<img
								src="/public/assets/images/glass.jpg"
								class="w-[10rem] aspect-square rounded-xl"
							/>
						</picture>
						<div class="absolute bottom-4 left-4 text-white text-left">
							<p class="font-semibold text-xs leading-[0.838rem]">GLASS</p>
							<p class="font-bold text-[0.625rem] leading-[0.762rem]">50 BEL</p>
						</div>
					</a>
				</div>
				<div class="swiper-slide">
					<a href="/account/waste/metal" class="relative block">
						<picture>
							<source type="image/webp" srcset="/public/assets/images/metal2.webp"/>
							<img
								src="/public/assets/images/metal2.jpg"
								class="w-[10rem] aspect-square rounded-xl"
							/>
						</picture>
						<div class="absolute bottom-4 left-4 text-white text-left">
							<p class="font-semibold text-xs leading-[0.838rem]">METAL</p>
							<p class="font-bold text-[0.625rem] leading-[0.762rem]">50 BEL</p>
						</div>
					</a>
				</div>
				<div class="swiper-slide">
					<a href="/account/waste/plastics" class="relative block">
						<picture>
							<source type="image/webp" srcset="/public/assets/images/plastic_2.webp"/>
							<img
								src="/public/assets/images/plastic_2.jpg"
								class="w-[10rem] aspect-square rounded-xl "
							/>
						</picture>
						<div class="absolute bottom-4 left-4 text-white text-left">
							<p class="font-semibold text-xs leading-[0.838rem]">PLASTICS</p>
							<p class="font-bold text-[0.625rem] leading-[0.762rem]">50 BEL</p>
						</div>
					</a>
				</div>
			</div>
		</div>
	</section>
}

templ DashboardRecycledAndSeeAll() {
	<section class="mt-8 w-full flex items-center justify-between">
		<p class="font-semibold text-[0.94rem] leading-[1.14rem]">Recycled</p>
		<button>
			<p class="font-[500] text-[0.63rem] leading-[0.76rem] text-[#016934]">see all</p>
		</button>
	</section>
}

templ DashboardDataViz(chart template.HTML) {
	<section id="echart" class="bg-transparent mt-5">
		@templ.Raw(chart)
		<div class="flex justify-between items-center gap-8  px-2">
			<button
				class="font-poppins font-semibold text-[#FFFFFF] text-[0.5rem] leading-3 py-[0.563rem] 
			pl-[0.688rem] pr-[0.75rem] bg-[#016934] [box-shadow:0rem_0.0575rem_0.115rem_0.0575rem_#00000014] rounded-[0.344rem]"
			>Jan</button>
			<button
				class="font-poppins font-semibold text-[#000000] text-[0.5rem] leading-3 py-[0.563rem] 
			pl-[0.688rem] pr-[0.75rem] bg-[#FFFFFF] [box-shadow:0rem_0.0575rem_0.115rem_0.0575rem_#00000014] rounded-[0.344rem]"
			>Jan</button>
			<button
				class="font-poppins font-semibold text-[#000000] text-[0.5rem] leading-3 py-[0.563rem] 
			pl-[0.688rem] pr-[0.75rem] bg-[#FFFFFF] [box-shadow:0rem_0.0575rem_0.115rem_0.0575rem_#00000014] rounded-[0.344rem]"
			>Jan</button>
			<button
				class="font-poppins font-semibold text-[#000000] text-[0.5rem] leading-3 py-[0.563rem] 
			pl-[0.688rem] pr-[0.75rem] bg-[#FFFFFF] [box-shadow:0rem_0.0575rem_0.115rem_0.0575rem_#00000014] rounded-[0.344rem]"
			>Jan</button>
			<button
				class="font-poppins font-semibold text-[#000000] text-[0.5rem] leading-3 py-[0.563rem] 
			pl-[0.688rem] pr-[0.75rem] bg-[#FFFFFF] [box-shadow:0rem_0.0575rem_0.115rem_0.0575rem_#00000014] rounded-[0.344rem]"
			>Jan</button>
		</div>
	</section>
}

templ DashboardTipsParagraph() {
	<p class="font-semibold text-[0.938rem] leading-[1.143rem] mt-4">Tips on Recycling</p>
}

templ DashboardSwiperTwo() {
	<section class="swiperTwo mt-4">
		<div class="px-4 swiper mySwiperTwo w-full">
			<div class="swiper-wrapper">
				<a href="/account/tips/plastics" class="swiper-slide block">
					<div class="bg-[#FEF7FF] rounded-lg flex items-center justify-center p-[0.313rem]">
						<img
							src="/public/assets/svg/manWithPlastics.svg"
							class="w-[6.875rem] aspect-[110/101] mx-[0.313rem] mr-[0.313rem] rounded-lg"
						/>
						<div class="flex flex-col gap-2">
							<div class="flex items-center gap-[0.313rem]">
								<p class="font-semibold text-[0.688rem] leading-[0.838rem]">PLASTICS:</p>
								<picture>
									<source type="image/webp" srcset="/public/assets/images/Recycle_small.webp"/>
									<img
										src="/public/assets/images/Recycle_small.png"
										alt=""
										class="w-[0.813rem] aspect-square"
									/>
								</picture>
							</div>
							<p class="font-[500] text-[0.625rem] leading-[0.875rem] text-left">
								Twist on the bottle
								caps before tossing them in the bin to make it
								easier
								for recyclers.
							</p>
						</div>
					</div>
				</a>
				<a href="/account/tips/glass" class="swiper-slide block">
					<div class="bg-[#FEF7FF] rounded-lg flex items-center justify-center p-[0.313rem]">
						<img
							src="/public/assets/svg/glassSwipper.svg"
							class="w-[6.875rem] aspect-[110/101] mx-[0.313rem] mr-[0.313rem] rounded-lg"
						/>
						<div class="flex flex-col gap-2">
							<div class="flex items-center gap-[0.313rem]">
								<p class="font-semibold text-[0.688rem] leading-[0.838rem]">GLASS:</p>
								<picture>
									<source type="image/webp" srcset="/public/assets/images/Recycle_small.webp"/>
									<img
										src="/public/assets/images/Recycle_small.png"
										alt=""
										class="w-[0.813rem] aspect-square"
									/>
								</picture>
							</div>
							<p class="font-[500] text-[0.625rem] leading-[0.875rem] text-left">
								Remove food or drink residues from the glass as it can contaminate recycling process.
							</p>
						</div>
					</div>
				</a>
				<a href="/account/tips/metal" class="swiper-slide block">
					<div class="bg-[#FEF7FF] rounded-lg flex items-center justify-center p-[0.313rem]">
						<img
							src="/public/assets/svg/metalSwipper.svg"
							class="w-[6.875rem] aspect-[110/101] mx-[0.313rem] mr-[0.313rem] rounded-lg"
						/>
						<div class="flex flex-col gap-2">
							<div class="flex items-center gap-[0.313rem]">
								<p class="font-semibold text-[0.688rem] leading-[0.838rem]">METAL:</p>
								<picture>
									<source type="image/webp" srcset="/public/assets/images/Recycle_small.webp"/>
									<img
										src="/public/assets/images/Recycle_small.png"
										alt=""
										class="w-[0.813rem] aspect-square"
									/>
								</picture>
							</div>
							<p class="font-[500] text-[0.625rem] leading-[0.875rem] text-left">
								Be careful not to crush metals like cans, as it makes sorting easier before recycling.
							</p>
						</div>
					</div>
				</a>
				<a href="/account/tips/paper" class="swiper-slide block">
					<div class="bg-[#FEF7FF] rounded-lg flex items-center justify-center p-[0.313rem]">
						<img
							src="/public/assets/svg/paperSwipper.svg"
							class="w-[6.875rem] aspect-[110/101] mx-[0.313rem] mr-[0.313rem] rounded-lg"
						/>
						<div class="flex flex-col gap-2">
							<div class="flex items-center gap-[0.313rem]">
								<p class="font-semibold text-[0.688rem] leading-[0.838rem]">PAPER:</p>
								<img
									src="/public/assets/images/Recycle_small.png"
									alt=""
									class="w-[0.813rem] aspect-square"
								/>
							</div>
							<p class="font-[500] text-[0.625rem] leading-[0.875rem] text-left">
								Wet paper can become too damaged to recycle, as paper weakens fibers. So keep paper dry!											
							</p>
						</div>
					</div>
				</a>
			</div>
		</div>
	</section>
}
