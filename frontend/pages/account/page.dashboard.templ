package frontend

templ AccountDashboardPage(user User) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta
				name="viewport"
				content="width=device-width, initial-scale=1.0"
			/>
			<link
				rel="stylesheet"
				href="/assets/styles/output.css"
			/>
			<link
				rel="stylesheet"
				href="/assets/libriaries/swiper-bundle.min.css"
			/>
			<script src="/assets/libriaries/swiper-bundle.min.js"></script>
			<style>
            .overflow-y-scroll::-webkit-scrollbar {
                width: 0 !important;
                display: none;
                overflow: -moz-scrollbars-none;
                scrollbar-width: none;
            }
        </style>
			<title>Dashboard</title>
		</head>
		<body class="bg-[url('/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="Page w-full h-full flex flex-col font-montserrat text-[#2E2E2E]">
				@profileBar(user)
				<main class="grow overflow-y-scroll pl-[1.5rem] pr-[1.56rem]">
					<article class="pt-[1.88rem] flex">
						<p class="leading-[1.143rem] font-[600] text-[0.938rem]">Let's Recycle! </p>
						<img
							src="/assets/images/Recycle_small.png"
							class="w-[1.25rem] aspect-square ml-2"
						/>
					</article>
					<section class="swiperOne mt-[0.86rem] mr-0">
						<div class="swiper mySwiper w-full">
							<div class="swiper-wrapper">
								<div class="swiper-slide">
									<button class="">
										<img
											src="/assets/images/metal2.jpg"
											class="w-[10rem] aspect-square rounded-xl"
										/>
									</button>
								</div>
								<div class="swiper-slide">
									<button>
										<img
											src="/assets/images/glass.jpg"
											class="w-[10rem] aspect-square rounded-xl "
										/>
									</button>
									<p></p>
								</div>
								<div class="swiper-slide">
									<button>
										<img
											src="/assets/images/plastic_2.jpg"
											class="w-[10rem] aspect-square rounded-xl "
										/>
									</button>
									<p></p>
								</div>
								<div class="swiper-slide">
									<button>
										<img
											src="/assets/images/book.jpg"
											class="w-[10rem] aspect-square rounded-xl "
										/>
									</button>
									<p></p>
								</div>
							</div>
							<div class="swiper-pagination text-green-400"></div>
						</div>
					</section>
					<section class="mt-8 w-full flex items-center justify-between">
						<p class="font-[600] text-[0.94rem] leading-[1.14rem]">Recycled</p>
						<button>
							<p class="font-[500] text-[0.63rem] leading-[0.76rem] text-[#016934]">see all</p>
						</button>
					</section>
					<section class="mt-4 flex flex-col gap-4">
						<div class="bg-[#FEF7FF] w-full rounded-lg flex gap-2">
							<img
								src="/assets/images/sports_bottle.jpg"
								class="w-[4.69rem] aspect-[75/70] py-[0.31rem] pr-[0.31rem] rounded-lg"
							/>
							<div class="flex flex-col gap-0.5 ml-4 mt-[1.188rem] mb-[1.125rem]">
								<p class="font-[500] leading-[0.838rem] text-[0.688rem]">Sport plastic bottle</p>
								<p class="font-[700] leading-[0.0.762rem] text-[0.625rem]">54 recycled</p>
							</div>
							<img
								src="/assets/svg/back_arrow.svg"
								class="rotate-180 ml-auto w-[0.938rem] aspect-square"
							/>
						</div>
						<div class="bg-[#FEF7FF] w-full rounded-lg flex gap-2">
							<img
								src="/assets/images/paper_bag.jpg"
								class="w-[4.69rem] aspect-[75/70] py-[0.31rem] pr-[0.31rem] rounded-lg"
							/>
							<div class="flex flex-col gap-0.5 ml-4 mt-[1.188rem] mb-[1.125rem]">
								<p class="font-[500] leading-[0.838rem] text-[0.688rem]">Small paper bag</p>
								<p class="font-[700] leading-[0.0.762rem] text-[0.625rem]">45 recycled</p>
							</div>
							<img
								src="/assets/svg/back_arrow.svg"
								class="rotate-180 ml-auto w-[0.938rem] aspect-square"
							/>
						</div>
					</section>
					<p class="mt-8 font-[600] text-[0.938rem] leading-[1.143rem]">Tips on Recycling</p>
					<section class="swiperTwo mt-4">
						<div class="px-4 swiper mySwiperTwo w-full">
							<div class="swiper-wrapper">
								<div class="swiper-slide">
									<div class="bg-[#FEF7FF] rounded-lg flex items-center justify-center">
										<img
											src="/assets/images/plastic_1.jpg"
											class="w-[6.875rem] aspect-[110/101] mx-[0.313rem] mr-[0.313rem] rounded-lg"
										/>
										<div class="flex flex-col gap-2 ml-[1.625rem] my-[1.188rem]">
											<div class="flex items-center gap-[0.313rem]">
												<p class="font-[600] text-[0.688rem] leading-[0.838rem]">Plastics:</p>
												<img
													src="/assets/images/Recycle_small.png"
													alt=""
													class="w-[0.813rem] aspect-square"
												/>
											</div>
											<p class="font-[500] text-[0.625rem] leading-[0.875rem]">
												Twist on the bottle
												caps before tossing them in the bin to make it
												easier
												for recyclers.
											</p>
										</div>
									</div>
								</div>
								<div class="swiper-slide">
									<div class="bg-[#FEF7FF] rounded-lg flex items-center justify-center">
										<img
											src="/assets/images/plastic_1.jpg"
											class="w-[6.875rem] aspect-[110/101] mx-[0.313rem] mr-[0.313rem] rounded-lg"
										/>
										<div class="flex flex-col gap-2 ml-[1.625rem] my-[1.188rem]">
											<div class="flex items-center gap-[0.313rem]">
												<p class="font-[600] text-[0.688rem] leading-[0.838rem]">Plastics:</p>
												<img
													src="/assets/images/Recycle_small.png"
													alt=""
													class="w-[0.813rem] aspect-square"
												/>
											</div>
											<p class="font-[500] text-[0.625rem] leading-[0.875rem]">
												Twist on the bottle
												caps before tossing them in the bin to make it
												easier
												for recyclers.
											</p>
										</div>
									</div>
								</div>
								<div class="swiper-slide">
									<div class="bg-[#FEF7FF] rounded-lg flex items-center justify-center">
										<img
											src="/assets/images/plastic_1.jpg"
											class="w-[6.875rem] aspect-[110/101] mx-[0.313rem] mr-[0.313rem] rounded-lg"
										/>
										<div class="flex flex-col gap-2 ml-[1.625rem] my-[1.188rem]">
											<div class="flex items-center gap-[0.313rem]">
												<p class="font-[600] text-[0.688rem] leading-[0.838rem]">Plastics:</p>
												<img
													src="/assets/images/Recycle_small.png"
													alt=""
													class="w-[0.813rem] aspect-square"
												/>
											</div>
											<p class="font-[500] text-[0.625rem] leading-[0.875rem]">
												Twist on the bottle
												caps before tossing them in the bin to make it
												easier
												for recyclers.
											</p>
										</div>
									</div>
								</div>
							</div>
						</div>
					</section>
				</main>
				@menuComp("dashboard")
			</div>
		</body>
		<script type="text/javascript">
        const swiper = new Swiper( '.mySwiper', {
            direction: "horizontal",
            slidesPerView: 2,
            mousewheel: true,
            spaceBetween: 8,
            pagination: {
                el: ".swiper-pagination",
                clickable: true,
            },
            autoplay: {
                delay: 3000,
                disableOnInteraction: true,
            },
        } );

        const swiperTwo = new Swiper( '.mySwiperTwo', {
            mousewheel: true,
            keyboard: true,
            autoplay: {
                delay: 1500,
                disableOnInteraction: true,
            },
        } );
    </script>
		<style>
        .swiper-pagination-bullet-active {
            background-color: rgb(62, 184, 62);
        }

        .swiper-button-prev:after,
        .swiper-button-next:after {
            --swiper-navigation-size: 20px;
            color: rgb(62, 184, 62);
        }
    </style>
	</html>
}
