package frontend

templ BeforeHeaderTagPartial(pageTitle string) {
	@templ.Raw(`<!DOCTYPE html><html lang="en">`)
	@HeadTag(pageTitle)
	@templ.Raw(`<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden"><div class="Page w-full h-full flex flex-col font-montserrat text-[#2E2E2E]">`)
}

templ HtmlAndBodyOpeningTagPartial(pageTitle string, others ...templ.Component) {
	@templ.Raw(`<!DOCTYPE html><html lang="en">`)
	@HeadTag(pageTitle)
	@templ.Raw(`
			<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
					<div class="Page w-full h-full flex flex-col font-montserrat text-[#2E2E2E]">`)
	if others != nil {
		for _, comp := range others {
			@comp
		}
	}
}

// HtmlAndBodyClosingTagPartial renders the script, closing tags for body and html elements
templ HtmlAndBodyClosingTagPartial(pageTitle string) {
	@templ.Raw(`</div></body>`)
	switch pageTitle {
		case "dashboard":
			@scriptForDashboardPage()
		case "scan":
			@scriptForScanPage()
		case "location":
			@scriptForLocationPage()
		case "wallet":
			@scriptForWalletPage()
		case "spend":
			@scriptForSpendPage()
		case "airtime":
			@airtimeRechargeSuccessDialog()
			@addNewBeneficiairyAirtimePageDialog()
			@scriptForAirtimePage()
		case "beneficiaries":
			@scriptForBeneficiariesPage()
			@addNewBeneficiairyDialog()
		case "profile":
			@scriptForProfilePage()
			@createNewPinDialog()
			@enterSPLWalletAddrDialog()
			@successDialog(true)
			@changeSPLWalletAddrDialog()
	}
	@templ.Raw(`</html>`)
}

templ ToastMessage(toastType ToastType, message string, templComp ...templ.Component) {
	for _, comp := range templComp {
		@comp
	}
	@templ.JSONScript("toast-type", toastType.String())
	@templ.JSONScript("toast-message", message)
	<script src="/public/assets/scripts/jquery.min.js"></script>
	<script src="/public/assets/scripts/toastr.min.js"></script>
	<style>
		#toast-container {
			margin-top: 0.25rem; 
		}
	</style>
	<script>
	(function(){
		const toastType = JSON.parse(document.getElementById('toast-type').textContent);
		const toastMessage = JSON.parse(document.getElementById('toast-message').textContent);
		toastr.options = {
              	"closeButton": true,
				"debug": false,
				"newestOnTop": false,
				"progressBar": true,
				"positionClass": "toast-top-center",
				"preventDuplicates": true,
				"onclick": null,
				"showDuration": "100",
				"hideDuration": "1000",
				"timeOut": "2500",
				"extendedTimeOut": "1000",
				"showEasing": "swing",
				"hideEasing": "linear",
				"showMethod": "slideDown",
				"hideMethod": "slideUp"
            };
        toastr[ toastType ](toastMessage)
	})()
	</script>
}

templ commingSoonTooltip() {
	<script src="/public/assets/scripts/popper.min.js"></script>
	<script src="/public/assets/scripts/tippy-bundle.umd.js"></script>
	<style>
		.tippy-box[data-theme~='tomato'] {
			background-color: #CCE1D6;
			color:black;
			font-family: 'TT Chocolates';
			border-radius: 0.625rem;
			box-shadow: 0rem 0.25rem 0.625rem rgba(0, 0, 0, 0.25);
			padding: 0.15rem;
			text-align: start;
		}
	</style>
	<script>
		tippy('[data-tippy-content]', {
				trigger: 'click',
				// allowHTML: true,
				theme: 'tomato',
				animation: 'perspective-extreme',
				// interactive: true,
				arrow: false,
				onShow(instance) {
				setTimeout(() => {
					instance.hide();
				}, 1500);
			},
		});
	</script>
}

templ MainClosingTag() {
	@templ.Raw(`</main>`)
}

templ CommonHeader(user Account) {
	<header id="header" class="pt-[1.5rem] pl-[1.5rem] pr-[1.56rem] flex w-full justify-start items-center">
		<a href="/account/profile">
			<img
				src={ user.AvatarUrl }
				class="rounded-full w-[1.86rem] aspect-square mr-[0.5rem]"
			/>
		</a>
		if user.DisplayName != "" {
			<p class="leading-[0.91rem] font-[500] text-[0.75rem]">
				Gm,
				<span class="font-[600]">{ user.DisplayName }</span>
			</p>
		} else if user.FirstName != "" {
			<p class="leading-[0.91rem] font-[500] text-[0.75rem]">
				Gm,
				<span class="font-[600]">{ user.FirstName }</span>
			</p>
		} else if user.LastName != "" {
			<p class="leading-[0.91rem] font-[500] text-[0.75rem]">
				Gm,
				<span class="font-[600]">{ user.LastName }</span>
			</p>
		} else {
			<p class="leading-[0.91rem] font-[500] text-[0.75rem]">
				Gm
			</p>
		}
		<button
			class="bg-[#CCE1D699] p-[0.5rem] ml-auto rounded-md flex justify-center items-center"
			_="on click
					halt the event
					tell #notification-bar
					if #notification-bar.classList does not contain 'translate-y-0'
						then set :accountId to #notification-bar.dataset.accountid
						then call getNotificationMarkup(:accountId)
						then remove .translate-y-full then add .translate-y-0
						then call #notification-bar.focus() 
						then remove .hidden from #backdrop
					end"
		>
			<img
				src="/public/assets/svg/notification.svg"
				class="w-6 aspect-square"
			/>
		</button>
		@notificationBar(user.Email)
	</header>
}

templ commonHeaderTwo(text, avatarURL string, btnComp templ.Component) {
	<header class="pt-[1.5rem] pl-[1.5rem] pr-[1.56rem] flex w-full justify-between items-center">
		<a href="/account/profile">
			<img
				src={ avatarURL }
				class="rounded-full w-[1.86rem] aspect-square mr-[0.5rem]"
			/>
		</a>
		<p class="font-semibold text-[0.938rem] leading-[1.143rem]">{ text }</p>
		@btnComp
	</header>
}

templ LetRecycleAndProfile(text string) {
	<section class="flex items-center gap-1">
		<p class="leading-[1.143rem] font-semibold text-[0.938rem]">{ text }</p>
		<picture>
			<source type="image/webp" srcset="/public/assets/images/Recycle_small.webp"/>
			<img
				src="/public/assets/images/Recycle_small.png"
				class="w-5 aspect-square"
			/>
		</picture>
	</section>
}

templ removeScrollBar() {
	<style>
		.overflow-y-auto::-webkit-scrollbar {
			width: 0 !important;
			display: none;
			overflow: -moz-scrollbars-none;
			scrollbar-width: none;
		}
	</style>
}

templ notificationBar(accountEmail string) {
