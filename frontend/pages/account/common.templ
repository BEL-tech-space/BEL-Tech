package frontend

templ BeforeHeaderTagPartial(pageTitle string) {
	@templ.Raw(`<!DOCTYPE html><html lang="en">`)
	@HeadTag(pageTitle)
	@templ.Raw(`<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden"><div class="Page w-full h-full flex flex-col font-montserrat text-[#2E2E2E]">`)
}

// HtmlAndBodyOpeningTagPartial contains the partial for the html opening tag, the header opening &
// closing tag and a default body opening tag. *others* would replace the body tag and be render by
// lowest index first
templ HtmlAndBodyOpeningTagPartial(pageTitle string, others ...templ.Component) {
	@templ.Raw(`<!DOCTYPE html><html lang="en">`)
	@HeadTag(pageTitle)
	@templ.Raw(`
			<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
					<div class="Page w-full h-full flex flex-col font-montserrat text-[#2E2E2E]">`)
	if others != nil {
		for _, comp := range others {
			@comp
		}
	}
}

// HtmlAndBodyClosingTagPartial renders the script, closing tags for body and html elements
templ HtmlAndBodyClosingTagPartial(pageTitle string, others ...templ.Component) {
	@templ.Raw(`</div></body>`)
	switch pageTitle {
		case "dashboard":
			@scriptForDashboardPage()
		case "scan":
			@scriptForScanPage()
		case "location":
			@scriptForLocationPage()
		case "wallet":
			@scriptForWalletPage()
		case "spend":
			@scriptForSpendPage()
		case "airtime":
			@scriptForAirtimePage()
		case "beneficiaries":
			@scriptForBeneficiariesPage()
			@addNewBeneficiairyDialog()
	}
	if others != nil {
		for _, comp := range others {
			@comp
		}
	}
	@templ.Raw(`</html>`)
}

templ HeadTag(pageTitle string) {
	<head>
		<meta charset="UTF-8"/>
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0, maximum-scale=5.0"
		/>
		<link
			rel="stylesheet"
			href="/public/assets/styles/output.css"
		/>
		if pageTitle == "dashboard" || 
			pageTitle == "scan" ||
		  	pageTitle == "location" ||
		   	pageTitle == "wallet" ||
		    pageTitle == "spend" {
			<link rel="manifest" href="/public/manifest.json"/>
			<meta name="theme-color" content="#fff"/>
			<link
				rel="icon"
				type="image/png"
				sizes="32x32"
				href="/public/assets/icons/ios/32.png"
			/>
			<link
				rel="icon"
				type="image/png"
				sizes="16x16"
				href="/public/assets/icons/ios/16.png"
			/>
			// <link rel="shortcut icon" href="/public/assets/images/beltech_logo_2.ico"/>
			<link rel="apple-touch-icon" href="/pubic/assets/icons/ios/32.png"/>
		}
		if pageTitle == "dashboard" || pageTitle == "wallet" {
			<link
				rel="stylesheet"
				href="/public/assets/styles/swiper-bundle.min.css"
			/>
		}
		@removeScrollBar()
		<title>{ pageTitle }</title>
	</head>
}

templ MainClosingTag() {
	@templ.Raw(`</main>`)
}

templ Footer(active string, mainClosingTag templ.Component) {
	@mainClosingTag
	<footer class="bg-white flex w-full justify-around px-4 pt-2 pb-3 gap-[2.375rem]" hx-boost="false">
		if active == "dashboard" {
			<a
				href="/account/dashboard"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/home bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Home</p>
			</a>
		} else {
			<a
				href="/account/dashboard"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/home linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Home</p>
			</a>
		}
		if active == "scan" {
			<a
				href="/account/scan"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/scan bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Scan</p>
			</a>
		} else {
			<a
				href="/account/scan"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/scan linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Scan</p>
			</a>
		}
		if active == "location" {
			<a
				href="/account/location"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/location bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Location</p>
			</a>
		} else {
			<a
				href="/account/location"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/location linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Location</p>
			</a>
		}
		if active == "wallet" {
			<a
				href="/account/wallet"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/wallet bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Wallet</p>
			</a>
		} else {
			<a
				href="/account/wallet"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/wallet linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Wallet</p>
			</a>
		}
		if active == "spend" {
			<a
				href="/account/spend"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/new_exchange_bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Spend</p>
			</a>
		} else {
			<a
				href="/account/spend"
				class="flex flex-col justify-center items-center gap-[0.25rem]"
			>
				<img
					src="/public/assets/svg/new_exchange_linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-[700] text-[0.5rem] leading-[1.25rem] text-[#016934]">Spend</p>
			</a>
		}
	</footer>
}

templ CommonHeaderOne(user Account, mainOpenTag templ.Component) {
	<header class="pt-[1.5rem] pl-[1.5rem] pr-[1.56rem] flex w-full justify-start items-center">
		<a href="/account/profile">
			<img
				src={ user.AvatarUrl }
				class="rounded-full w-[1.86rem] aspect-square mr-[0.5rem]"
			/>
		</a>
		if user.DisplayName != "" {
			<p class="leading-[0.91rem] font-[500] text-[0.75rem]">
				Gm,
				<span class="font-[600]">{ user.DisplayName }</span>
			</p>
		} else if user.FirstName != "" {
			<p class="leading-[0.91rem] font-[500] text-[0.75rem]">
				Gm,
				<span class="font-[600]">{ user.FirstName }</span>
			</p>
		} else if user.LastName != "" {
			<p class="leading-[0.91rem] font-[500] text-[0.75rem]">
				Gm,
				<span class="font-[600]">{ user.LastName }</span>
			</p>
		} else {
			<p class="leading-[0.91rem] font-[500] text-[0.75rem]">
				Gm
			</p>
		}
		<button class="bg-[#CCE1D699] p-[0.5rem] ml-auto rounded-md flex justify-center items-center">
			<img
				src="/public/assets/svg/notification.svg"
				class="w-6 aspect-square"
			/>
		</button>
	</header>
	@mainOpenTag
}

templ commonHeaderTwo(text, avatarURL, imagePath, btnBehaviour string, beforeHeaderTagPartial, afterHeaderTagPartial templ.Component) {
	@beforeHeaderTagPartial
	<header class="pt-[1.5rem] pl-[1.5rem] pr-[1.56rem] flex w-full justify-between items-center">
		<a href="/account/profile">
			<img
				src={ avatarURL }
				class="rounded-full w-[1.86rem] aspect-square mr-[0.5rem]"
			/>
		</a>
		<p class="font-semibold text-[0.938rem] leading-[1.143rem]">{ text }</p>
		<button _={ btnBehaviour } class="bg-[#CCE1D699] p-2 rounded-md flex justify-center items-center">
			<img
				src={ imagePath }
				class="w-[1.5rem] aspect-square"
			/>
		</button>
	</header>
	@afterHeaderTagPartial
}

templ LetRecycleAndProfile(text string) {
	<article class="flex items-center gap-1">
		<p class="leading-[1.143rem] font-semibold text-[0.938rem]">{ text }</p>
		<picture>
			<source type="image/webp" srcset="/public/assets/images/Recycle_small.webp"/>
			<img
				src="/public/assets/images/Recycle_small.png"
				class="w-5 aspect-square"
			/>
		</picture>
	</article>
}

templ removeScrollBar() {
	<style>
		.overflow-y-auto::-webkit-scrollbar {
			width: 0 !important;
			display: none;
			overflow: -moz-scrollbars-none;
			scrollbar-width: none;
		}
	</style>
}
