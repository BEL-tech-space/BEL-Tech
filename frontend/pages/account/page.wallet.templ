package frontend

import (
	"beltech/types"
	"fmt"
)

templ WalletPage(acc Account, data []types.TokenData) {
	<!DOCTYPE html>
	<html lang="en">
		@HeadTag("Wallet")
		<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="w-full h-full flex flex-col font-montserrat text-[#2E2E2E]">
				@CommonHeaderOne(acc, templ.NopComponent)
				@WalletMain(acc, data)
				@Footer("wallet", templ.NopComponent)
			</div>
			@scriptForWalletPage()
		</body>
	</html>
}

templ WalletMain(acc Account, data []types.TokenData) {
	<main class="grow overflow-y-auto pl-6 pr-[1.56rem] flex flex-col">
		@WalletBalance(acc.CurrBalance)
		@WalletOptionsPartial()
		@WalletWatchlistPartial()
		@WalletCoinData(data)
		@WalletSwiper()
	</main>
}

templ scriptForWalletPage() {
	<script src="/public/assets/scripts/htmx.min.js"></script>
	<script src="/public/assets/scripts/swiper-bundle.min.js"></script>
	<script>
		const swiperThree = new Swiper( '.mySwiperThree', {
            mousewheel: true,
            keyboard: true,
			spaceBetween: 8,
            autoplay: {
                delay: 1500,
                disableOnInteraction: true,
            },
        } );
	</script>
}

templ WalletMainOpeningTag() {
	@templ.Raw(`<main class="grow overflow-y-auto pl-6 pr-[1.56rem] flex flex-col">`)
}

templ WalletBalance(belTokenBalance float64) {
	<section class="pt-[1.88rem] flex gap-2 items-center">
		<p class="font-semibold text-xs leading-[0.914rem]">My Balance </p>
		<img src="/public/assets/svg/eye.svg" class="w-[0.938rem] aspect-square"/>
	</section>
	<p class="mt-2 mb-8 font-bold text-xl leading-[1.524rem] text-[#016934]">{ fmt.Sprintf("%.4f BEL", belTokenBalance) }</p>
}

templ WalletOptionsPartial() {
	<section class="flex w-full justify-between items-start gap-2">
		<a class="flex flex-col gap-2 items-center">
			<button class="bg-[#CCE1D6] rounded-full p-[0.938rem]"><img src="/public/assets/svg/+.svg" class="w-5 aspect-square"/></button>
			<p class="font-poppins font-normal text-xs text-center">Send</p>
		</a>
		<a class="flex flex-col gap-2 items-center">
			<button class="bg-[#CCE1D6] rounded-full p-[0.938rem]"><img src="/public/assets/svg/-.svg" class="w-5 aspect-square"/></button>
			<p class="font-poppins font-normal text-xs text-center">Receive</p>
		</a>
		<a class="flex flex-col gap-2 items-center">
			<button class="bg-[#CCE1D6] rounded-full p-[0.938rem]"><img src="/public/assets/svg/cash out.svg" class="w-5 aspect-square"/></button>
			<p class="font-poppins font-normal text-xs text-center">Cash out</p>
		</a>
		<a class="flex flex-col gap-2 items-center">
			<button class="bg-[#CCE1D6] rounded-full p-[0.938rem]"><img src="/public/assets/svg/learn.svg" class="w-5 aspect-square"/></button>
			<p class="font-poppins font-normal text-xs text-center">Learn</p>
		</a>
	</section>
}

templ WalletWatchlistPartial() {
	<section class="mt-10 mb-4 w-full flex justify-between items-center">
		<p class="font-semibold text-[0.94rem] leading-[1.14rem]">Watchlist</p>
		<button>
			<p class="font-medium text-[0.63rem] leading-[0.76rem] text-[#016934]">Past 7d</p>
		</button>
	</section>
}

templ WalletCoinData(data []types.TokenData) {
	<section>
		<ul hx-get="/account/coinData" hx-trigger="every 11s" hx-swap="innerHTML" class="w-full flex flex-col gap-3 justify-around items-center h-full">
			@CoinData(data)
		</ul>
	</section>
}

templ CoinData(data []types.TokenData) {
	if isAllElementZero(data) {
		<div class="w-full h-full flex justify-center items-center">
			<p class="text-center font-poppins font-light">No live crypto data, maybe offline ☹️</p>
		</div>
	} else {
		for _, v := range data {
			<li class="w-full flex justify-between items-center gap-8 text-[#393737]">
				<div class="flex gap-1">
					<picture>
						<source srcset={ useWebp(v.TokenLogo) } type="image/webp"/>
						<img src={ v.TokenLogo } alt="" class="w-[2.788rem] aspect-square rounded-full"/>
					</picture>
					<div class="flex flex-col item-start gap-[0.446rem]">
						<p class="font-semibold leading-[0.838rem] text-[0.688rem] text-inherit">{ toTitle(v.TokenName) }</p>
						<p class="font-medium leading-[0.762rem] text-[0.625rem] text-inherit">{ v.TokenSymbol }</p>
					</div>
				</div>
				if v.UpOrDown == "icon-Caret-up" {
					@templ.Raw(chartUrlGreen(v.ChartUrl))
				} else {
					@templ.Raw(chartUrlRed(v.ChartUrl))
				}
				<div class="flex flex-col items-center">
					<p class="font-bold text-sm text-center text-inherit">{ v.TokenPrice }</p>
					if v.UpOrDown == "icon-Caret-up" {
						<p class="ml-auto font-semibold text-xs text-center text-[#34A853]">
							{ v.PercentUpOrDown }
						</p>
					} else {
						<p class="ml-auto font-semibold text-xs text-center text-[#EF0E0E]">
							{ v.PercentUpOrDown }
						</p>
					}
				</div>
			</li>
		}
	}
	// for _, v := range data {
	// <li class="w-full flex justify-between items-center gap-8 text-[#393737]">
	// 	<div class="flex gap-1">
	// 		<picture>
	// 			<source srcset={ useWebp(v.TokenLogo) } type="image/webp"/>
	// 			<img src={ v.TokenLogo } alt="" class="w-[2.788rem] aspect-square rounded-full"/>
	// 		</picture>
	// 		<div class="flex flex-col item-start gap-[0.446rem]">
	// 			<p class="font-semibold leading-[0.838rem] text-[0.688rem] text-inherit">{ toTitle(v.TokenName) }</p>
	// 			<p class="font-medium leading-[0.762rem] text-[0.625rem] text-inherit">{ v.TokenSymbol }</p>
	// 		</div>
	// 	</div>
	// 	if v.UpOrDown == "icon-Caret-up" {
	// 		@templ.Raw(chartUrlGreen(v.ChartUrl))
	// 	} else {
	// 		@templ.Raw(chartUrlRed(v.ChartUrl))
	// 	}
	// 	<div class="flex flex-col items-center">
	// 		<p class="font-bold text-sm text-center text-inherit">{ v.TokenPrice }</p>
	// 		if v.UpOrDown == "icon-Caret-up" {
	// 			<p class="ml-auto font-semibold text-xs text-center text-[#34A853]">
	// 				{ v.PercentUpOrDown }
	// 			</p>
	// 		} else {
	// 			<p class="ml-auto font-semibold text-xs text-center text-[#EF0E0E]">
	// 				{ v.PercentUpOrDown }
	// 			</p>
	// 		}
	// 	</div>
	// </li>
	// }
}

templ WalletSwiper() {
	<section class="swiperThree min-h-fit mt-auto">
		<div class="px-4 swiper mySwiperThree w-full">
			<div class="swiper-wrapper">
				for range 4 {
					<div class="swiper-slide">
						<div class="bg-[#FEF7FF] rounded-lg flex items-center justify-center gap-3">
							<img
								src="/public/assets/svg/cryptoNews.svg"
								class="w-[6.875rem] aspect-[110/101] mx-[0.313rem] mr-[0.313rem] rounded-lg"
							/>
							<div class="flex flex-col gap-2 my-[1.188rem]">
								<div class="flex items-center gap-[0.313rem]">
									<p class="font-[600] text-[0.688rem] leading-[0.838rem]">Solana</p>
									<picture>
										<source srcset="/public/assets/images/Recycle_small.webp" type="image/webp"/>
										<img
											src="/public/assets/images/Recycle_small.png"
											alt=""
											class="w-[0.813rem] aspect-square"
										/>
									</picture>
								</div>
								<p class="font-medium text-[0.625rem] leading-[0.875rem] text-justify hyphens-auto break-words">
									Solana's network has surpassed the Binance Smart Chain (BNB) to become the second-largest by liquid TVL, second only to Ethereum. This surge in TVL reflects increased deposits, which reached 42.5 million SOL, the highest since 2022
								</p>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</section>
}
