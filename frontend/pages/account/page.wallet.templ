package frontend

// import "fmt"
templ WalletPage(user User) {
	<!DOCTYPE html>
	<html lang="en">
		@htmlHeadTag("Wallet")
		<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="w-full h-full flex flex-col font-montserrat text-[#2E2E2E]">
				@frequentHeaderOne(user)
				<main class="grow overflow-y-auto.overflow-y-auto pl-6 pr-[1.56rem]">
					<section class="pt-[1.88rem] flex gap-2 items-center">
						<p class="font-semibold text-xs leading-[0.914rem]">My Balance </p>
						<img src="/public/assets/svg/eye.svg" class="w-[0.938rem] aspect-square"/>
					</section>
					<p class="mt-2 mb-8 font-bold text-xl leading-[1.524rem] text-[#016934]">250.06 BEL </p>
					<section class="flex w-full justify-between items-start gap-2">
						<a class="flex flex-col gap-2 items-center">
							<button class="bg-[#CCE1D6] rounded-full p-[0.938rem]"><img src="/public/assets/svg/+.svg" class="w-5 aspect-square"/></button>
							<p class="font-poppins font-normal text-xs text-center">Send</p>
						</a>
						<a class="flex flex-col gap-2 items-center">
							<button class="bg-[#CCE1D6] rounded-full p-[0.938rem]"><img src="/public/assets/svg/-.svg" class="w-5 aspect-square"/></button>
							<p class="font-poppins font-normal text-xs text-center">Receive</p>
						</a>
						<a class="flex flex-col gap-2 items-center">
							<button class="bg-[#CCE1D6] rounded-full p-[0.938rem]"><img src="/public/assets/svg/cash out.svg" class="w-5 aspect-square"/></button>
							<p class="font-poppins font-normal text-xs text-center">Cash out</p>
						</a>
						<a class="flex flex-col gap-2 items-center">
							<button class="bg-[#CCE1D6] rounded-full p-[0.938rem]"><img src="/public/assets/svg/learn.svg" class="w-5 aspect-square"/></button>
							<p class="font-poppins font-normal text-xs text-center">Learn</p>
						</a>
					</section>
					<section class="mt-10 w-full flex justify-between items-center">
						<p class="font-semibold text-[0.94rem] leading-[1.14rem]">Watchlist</p>
						<button>
							<p class="font-medium text-[0.63rem] leading-[0.76rem] text-[#016934]">see all</p>
						</button>
					</section>
					<section id="coins-container">
						<ul id="coins-list" class="w-full flex gap-6"></ul>
					</section>
					<section class="swiperTwo mt-auto">
						<div class="px-4 swiper mySwiperTwo w-full">
							<div class="swiper-wrapper">
								for range 4 {
									<div class="swiper-slide">
										<div class="bg-[#FEF7FF] rounded-lg flex items-center justify-center gap-3">
											<img
												src="/public/assets/svg/cryptoNews.svg"
												class="w-[6.875rem] aspect-[110/101] mx-[0.313rem] mr-[0.313rem] rounded-lg"
											/>
											<div class="flex flex-col gap-2 my-[1.188rem]">
												<div class="flex items-center gap-[0.313rem]">
													<p class="font-[600] text-[0.688rem] leading-[0.838rem]">Solana</p>
													<img
														src="/public/assets/images/Recycle_small.png"
														alt=""
														class="w-[0.813rem] aspect-square"
													/>
												</div>
												<p class="font-[500] text-[0.625rem] leading-[0.875rem] text-wrap">
													Solana’s network has surpassed the Binance Smart Chain (BNB) to become the second-largest by liquid TVL, second only to Ethereum. This surge in TVL reflects increased deposits, which reached 42.5 million SOL, the highest since 2022​
												</p>
											</div>
										</div>
									</div>
								}
							</div>
						</div>
					</section>
				</main>
				@footerMenubar("wallet")
			</div>
		</body>
		<script>
		async function fetchCoinData() {
			const coins = ['bitcoin', 'bitcoin', 'bitcoin', 'bitcoin'];
			const url = `https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&ids=${coins.join(',')}`;
			
			try {
				const response = await fetch(url);
				const data = await response.json();

				const coinsList = document.getElementById('coins-list');

				data.forEach((coin, index) => {
					const listItem = document.createElement('li');
					listItem.classList.add('w-full', 'flex', 'justify-stretch', 'items-center', 'gap-[0.233rem]', 'text-[#393737]');
					listItem.innerHTML = `
						<img src="${coin.image}" alt="${coin.name}" class="w-[2.788rem] aspect-square rounded-full"/>
						<div class="flex flex-col justisfy-start item-center gap-[0.446rem]">
							<p class="font-semibold leading-[0.838rem] text-[0.688rem] text-inherit">${coin.name}</p>
							<p class="font-medium leading-[0.762rem] text-[0.625rem] text-inherit">${coin.symbol.toUpperCase()}</p>
						</div>
						<div class="relative w-20 h-7 flex-shrink-0 self-center">
							<div id="chart-${index}" class="w-full h-full absolute inset-0"></div>
						</div>
						<div class="flex flex-col items-center ml-auto">
							<p class="font-bold text-sm text-center text-inherit">$${coin.current_price.toLocaleString()}</p>
							<p class="ml-auto font-semibold text-xs text-center {coin.price_change_percentage_24h >= 0 ? text-[#34A853] : text-[#EF0E0E]}">
								${coin.price_change_percentage_24h.toFixed(2)}%
							</p>
						</div>
					`;
					coinsList.appendChild(listItem);
					// Create Sparkline Chart
					createSparkline(`chart-${index}`, coin);
				});
			} catch (error) {
				console.error('Error fetching coin data:', error);
			}
		}

		// Function to create the sparkline graph using ApexCharts
		function createSparkline(elementId, coin) {
			const options = {
				chart: {
					type: 'line',
					sparkline: {
						enabled: true
					}
				},
				series: [{
					name: coin.name,
					data: generateRandomData() 
				}],
				stroke: {
					curve: 'smooth',
					width: 2
				},
				colors: coin.price_change_percentage_24h >= 0 ? ['#16a34a'] : ['#dc2626'], // Green for uptrend, Red for downtrend
			};

			const chart = new ApexCharts(document.querySelector(`#${elementId}`), options);
			chart.render();
		}

		// Dummy data generator for sparkline, replace this with actual price data over time
		function generateRandomData() {
			const data = [];
			for (let i = 0; i < 10; i++) {
				data.push(Math.floor(Math.random() * 100));
			}
			return data;
		}

		fetchCoinData();

		new Swiper( '.mySwiperTwo', {
            mousewheel: true,
            keyboard: true,
            autoplay: {
                delay: 300000,
                disableOnInteraction: true,
            },
        } );
	</script>
	</html>
}
