package frontend

// import "fmt"
templ WalletPage(user User) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="stylesheet" href="/assets/styles/output.css"/>
			<style>
				.overflow-y-scroll::-webkit-scrollbar {
					width: 0 !important;
					display: none;
					overflow: -moz-scrollbars-none;
					scrollbar-width: none;
				}
			</style>
			<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
			<title>Wallet</title>
		</head>
		<body class="bg-[url('/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<main class="w-full h-full flex flex-col font-montserrat text-[#2E2E2E]">
				@profileBar(user)
				<section class="grow overflow-y-scroll pl-[1.5rem] pr-[1.56rem]">
					<div class="pt-[1.88rem] flex">
						<p class="leading-[0.914rem]  text-git [0.75rem]">My Balance </p>
						<img src="/assets/svg/eye.svg"/>
					</div>
					<div class="pt-[0.5rem] flex">
						<p class="leading-[1.524rem] font-[700] text-[1.25rem] text-[#016934]">250.06 BEL </p>
					</div>
					<div class="pt-[2.8125rem] flex w-full justify-between items-start  ">
						<div class="flex flex-col gap-3 items-center">
							<button class="bg-green-200 h-12 w-12 rounded-full"><img src="/assets/svg/+.svg" class="h-8 w-8 m-auto"/></button>
							<p>Send</p>
						</div>
						<div class="flex flex-col gap-3 justify-center">
							<button class="bg-green-200 h-12 w-12 rounded-full flex justify-center items-center"><img src="/assets/svg/-.svg" class="h-8 w-8"/></button>
							<p>Receive</p>
						</div>
						<div class="flex flex-col gap-3 justify-center">
							<button class="bg-green-200 h-12 w-12 rounded-full flex justify-center items-center"><img src="/assets/svg/cash out.svg" class="h-8 w-8"/></button>
							<p>Cash out</p>
						</div>
						<div class="flex flex-col gap-3 justify-center">
							<button class="bg-green-200 h-12 w-12 rounded-full flex justify-center items-center"><img src="/assets/svg/learn.svg" class="h-8 w-8"/></button>
							<p>Learn</p>
						</div>
					</div>
					<div class="mt-8 w-full flex items-center justify-between">
						<p class="font-[600] text-[0.94rem] leading-[1.14rem]">Watchlist</p>
						<button>
							<p class="font-[500] text-[0.63rem] leading-[0.76rem] text-[#016934]">see all</p>
						</button>
					</div>
					<div id="coins-container">
						<ul id="coins-list"></ul>
					</div>
				</section>
				@menuComp("wallet")
			</main>
		</body>
		<script>
		async function fetchCoinData() {
			const coins = ['bitcoin', 'ethereum', 'solana', 'binancecoin', 'pancakeswap-token', 'tether'];
			const url = `https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&ids=${coins.join(',')}`;
			
			try {
				const response = await fetch(url);
				const data = await response.json();

				const coinsList = document.getElementById('coins-list');

				data.forEach((coin, index) => {
					const listItem = document.createElement('li');
					listItem.classList.add('flex', 'justify-between', 'items-center');
					
				listItem.innerHTML = `
					<div class="flex items-center justify-between gap-4 w-full">
						<img src="${coin.image}" alt="${coin.name}" class="rounded-full w-10 h-10"/>
						<div class="flex flex-col gap-0.5 flex-shrink-0">
							<p class="font-[500] leading-[0.838rem] text-[0.688rem]">${coin.name}</p>
							<p class="font-[700] leading-[0.762rem] text-[0.625rem]">${coin.symbol.toUpperCase()}</p>
						</div>
						<div class="relative w-20 h-7 flex-shrink-0 self-center">
							<div id="chart-${index}" class="w-full h-full absolute inset-0"></div>
						</div>
						<div class="flex flex-col items-center flex-shrink-0 self-center">
							<p class="font-extrabold text-xl">$${coin.current_price.toLocaleString()}</p>
							<p class="${coin.price_change_percentage_24h >= 0 ? 'text-green-600' : 'text-red-600'}">
								${coin.price_change_percentage_24h.toFixed(2)}%
							</p>
						</div>
					</div>
				`;

					coinsList.appendChild(listItem);

					// Create Sparkline Chart
					createSparkline(`chart-${index}`, coin);
				});
			} catch (error) {
				console.error('Error fetching coin data:', error);
			}
		}

		// Function to create the sparkline graph using ApexCharts
		function createSparkline(elementId, coin) {
			const options = {
				chart: {
					type: 'line',
					sparkline: {
						enabled: true
					}
				},
				series: [{
					name: coin.name,
					data: generateRandomData() 
				}],
				stroke: {
					curve: 'smooth',
					width: 2
				},
				colors: coin.price_change_percentage_24h >= 0 ? ['#16a34a'] : ['#dc2626'], // Green for uptrend, Red for downtrend
			};

			const chart = new ApexCharts(document.querySelector(`#${elementId}`), options);
			chart.render();
		}

		// Dummy data generator for sparkline, replace this with actual price data over time
		function generateRandomData() {
			const data = [];
			for (let i = 0; i < 10; i++) {
				data.push(Math.floor(Math.random() * 100));
			}
			return data;
		}

		fetchCoinData();
	</script>
	</html>
}
