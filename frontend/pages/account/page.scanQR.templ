package frontend

templ ScanQRPage(accountEmail string) {
	<!DOCTYPE html>
	<html lang="en">
		@HeadTag("scan")
		<body
			class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh font-montserrat text-[#2E2E2E] overflow-hidden"
		>
			<div class="Page w-full h-full flex flex-col font-montserrat text-[#2E2E2E]">
				<header class="pt-6 pl-6 pr-[1.56rem] flex w-full justify-between items-center">
					<button>
						<img
							src="/public/assets/svg/back_arrow.svg"
							alt=""
							class="w-6 aspect-square"
						/>
					</button>
					<p class="font-semibold text-[0.938rem] leading-[1.143rem]">Scan</p>
					<button
						class="bg-[#CCE1D699] p-[0.5rem] rounded-md flex justify-center items-center"
						_="on click
							halt the event
							tell #notification-bar
							if #notification-bar.classList does not contain 'translate-y-0'
								then set :accountId to #notification-bar.dataset.accountid
								then call getNotificationMarkup(:accountId)
								then remove .translate-y-full then add .translate-y-0
								then call #notification-bar.focus() 
								then remove .hidden from #backdrop
							end"
					>
						<div class="relative">
							<img
								src="/public/assets/svg/notification.svg"
								class="w-6 aspect-square"
							/>
							<p id="notificationCount" class="bg-[#016934] text-white text-[0.5rem] leading-3 rounded-full absolute -top-1 -right-1 hidden"></p>
						</div>
					</button>
					@notificationBar(accountEmail)
				</header>
				<main class="grow overflow-y-auto pl-[1.438rem] pr-[1.375rem] mt-[4.5rem]">
					<div class="h-full w-full flex flex-col justify-around items-center ">
						<section id="xyz">
							<picture>
								<source type="image/webp" srcset="/public/assets/images/qr_code.webp"/>
								<img
									src="/public/assets/images/qr_code.jpg"
									alt=""
									class="w-[22rem] aspect-square m-auto"
								/>
							</picture>
							<article
								class="mt-[0.938rem] mr-10 ml-[2.5625rem] font-normal font-poppins text-sm text-center"
							>
								<p>
									Scan QR code on the smart bin
									to
								</p>
								<p>dispose waste</p>
							</article>
						</section>
						<div id="reader"></div>
						<section class="w-full flex justify-around items-center gap-[0.625rem]">
							<button
								onclick="scan()"
								class="scanButton w-full h-full bg-[#016934] rounded-md"
							>
								<p
									class="scanButtonText font-montserrat font-medium text-center text-[0.813rem] text-white"
								>
									Scan
								</p>
							</button>
							<a
								href="/account/history"
								class="bg-[#CCE1D699] p-[0.688rem] rounded-md inline justify-center items-center"
							>
								<img
									src="/public/assets/svg/octicon_history-16.svg"
									class="w-[1.125rem]  aspect-square"
								/>
							</a>
						</section>
					</div>
				</main>
				@Footer("scan", templ.NopComponent)
			</div>
			@scriptForScanPage()
			@confirmWaste("")
		</body>
	</html>
}

templ scriptForScanPage() {
	<style>
		#toast-container {
			margin-top: 0.25rem; 
		}
	</style>
	<script src="/public/assets/scripts/html5-qrcode.min.js"></script>
	<script src="/public/assets/scripts/jquery.min.js"></script>
	<script src="/public/assets/scripts/toastr.min.js"></script>
	<script src="/public/assets/scripts/hyperscript.min.js"></script>
	<script src="/public/assets/scripts/htmx.min.js"></script>
	<script src="/public/assets/scripts/notification.js"></script>
	<script>
            const html5QrCode = new Html5Qrcode( "reader" );
            let isScanning = false;

			const data = {};

            function scan () {
                const readerContainer = document.getElementById( "reader" );
                const xyz = document.getElementById( 'xyz' );
                const scanButton = document.getElementsByClassName( 'scanButton' )[ 0 ];
                const scanButtonText = document.getElementsByClassName( 'scanButtonText' )[ 0 ];
                const width = xyz.offsetWidth;
                const height = xyz.offsetHeight;

                if ( isScanning )
                {
                    stopScanning();
                    return;
                }

                readerContainer.style.width = `${( 83 / 100 ) * width}px`;
                readerContainer.style.height = `${( 83 / 100 ) * height}px`;
                const config = { fps: 10, qrbox: { width: width, height: height } };

                html5QrCode.start( { facingMode: "environment" }, config, qrCodeSuccessCallback, qrCodeErrorCallback )
                    .then( () => {
                        isScanning = true;
                        xyz.style.display = 'none';
                        scanButton.style.backgroundColor = '#FF0000';
                        scanButtonText.innerText = 'Cancel Scanning';
                    } )
                    .catch( ( err ) => {
                        isScanning = false;
                        console.error( err );
                    } );

            }

            function qrCodeSuccessCallback ( decodedText, decodedResult ) {
                console.log( `Scan result: ${decodedText}`, decodedResult );
				 
				 
				decodedText.split("#").forEach(pair => {
					const [key, value] = pair.split(":").map(str => str.trim());
					if (key && value !== undefined) {
						data[key.toLowerCase()] = value;
					}
				});
				 console.log("Extracted Data:", data);

				// Update waste values in confirmWaste-bar
				document.querySelector('[data-waste="glass"]').textContent = `${data["glass"]} KG`;
				document.querySelector('[data-waste="plastics"]').textContent = `${data["plastics"]} KG`;
				document.querySelector('[data-waste="paper"]').textContent = `${data["paper"]} KG`;
				document.querySelector('[data-waste="metal"]').textContent = `${data["metal"]} KG`;
				document.querySelector('[data-txn="name"]').textContent = `${data["txnname"]}`;
				document.querySelector('[data-points="points"]').textContent = `${data["points"]}`;

				// Show the modal
				document.getElementById("confirmWaste-backdrop").classList.remove("hidden");
				const confirmWasteBar = document.getElementById("confirmWaste-bar");
				confirmWasteBar.classList.remove("translate-y-full");
				confirmWasteBar.classList.add("translate-y-0");

				// console.log("that does not seem like ours")
				// toastr.options = {
				// 		"closeButton": true,
				// 		"debug": false,
				// 		"newestOnTop": false,
				// 		"progressBar": true,
				// 		"positionClass": "toast-top-center",
				// 		"preventDuplicates": true,
				// 		"onclick": null,
				// 		"showDuration": "100",
				// 		"hideDuration": "1000",
				// 		"timeOut": "3000",
				// 		"extendedTimeOut": "1000",
				// 		"showEasing": "swing",
				// 		"hideEasing": "linear",
				// 		"showMethod": "slideDown",
				// 		"hideMethod": "slideUp"
				// 	};
				// toastr[ "success" ]("that does not seem like ours")
				stopScanning();
            }

			function qrCodeErrorCallback ( error ) {
                // console.error( "from qrCodeErrorCallback ", error );
            }

            function stopScanning () {
                html5QrCode.stop().then( ( ignore ) => {
                    restoreScreen();
                    isScanning = false;
                } )
                    .catch( ( err ) => {
                        restoreScreen();
                        console.error( "error clearing reader", err );
                    } );
            }

            function restoreScreen () {
                const xyz = document.getElementById( "xyz" );
                const scanButtonText = document.getElementsByClassName( "scanButtonText" )[ 0 ];
                const scanButton = document.getElementsByClassName( 'scanButton' )[ 0 ];

                xyz.style.display = 'block';
                scanButton.style.backgroundColor = '';
                scanButtonText.innerText = 'Scan';
            }

			function getWasteData() {
				return data
			}
        </script>
}

templ confirmWaste(accountEmail string) {
	<style>
		.slide-out {
			transform: translateX(100%);
			opacity: 0;
		}
	</style>
	<div
		id="confirmWaste-backdrop"
		class="hidden fixed inset-0 z-10 bg-black backdrop-blur-sm bg-opacity-50 transition-opacity duration-300 ease-in-out [transition:opacity_6s_ease-in-out]"
		_="on click 
			if #confirmWaste-bar.classList contains 'translate-y-0'
				tell #confirmWaste-bar
				remove .translate-y-0 then add .translate-y-full
				then add .hidden to me
			end"
	></div>
	<div
		id="confirmWaste-bar"
		class="bg-white fixed bottom-0 left-0 pl-[1.223rem] pr-[1.723rem] translate-y-full 
                 pt-[2.543rem] pb-[2.635rem] rounded-tl-[0.848rem] max-h-[50%] h-auto overflow-y-auto w-full z-20
                 [transition:all_0.7s_ease-in-out]"
		data-accountId={ accountEmail }
	>
		<section class="flex flex-col justify-center items-start gap-6">
			<p>Confirm your waste details match before proceeding</p>
			<div class="flex justify-center items-center gap-2">
				<p class="font-semibold">Glass:</p>
				<p data-waste="glass">0 KG</p>
			</div>
			<div class="flex justify-center items-center gap-2">
				<p class="font-semibold">Plastics:</p>
				<p data-waste="plastics">0 KG</p>
			</div>
			<div class="flex justify-center items-center gap-2">
				<p class="font-semibold">Paper:</p>
				<p data-waste="paper">0 KG</p>
			</div>
			<div class="flex justify-center items-center gap-2">
				<p class="font-semibold">Metal:</p>
				<p data-waste="metal">0 KG</p>
			</div>
			<div class="flex justify-center items-center gap-2">
				<p class="font-semibold">Txn Name:</p>
				<p data-txn="name"></p>
			</div>
			<div class="flex justify-center items-center gap-2">
				<p class="font-semibold">Txn Name:</p>
				<p data-points="points"></p>
			</div>
		</section>
		<section class="w-full mt-8 flex justify-between items-center gap-2">
			<button
				type="button"
				hx-post="/account/confirmWaste"
				hx-swap="outerHTML"
				hx-trigger="click"
				hx-vals="js:{...getWasteData()}"
				hx-indicator="#spinner"
				class="outline-none rounded-md mb-2 font-medium bg-black text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-8 text-center text-white"
			>
				Confirm from the server
				<span id="spinner" class="loading loading-spinner loading-md htmx-indicator"></span>
			</button>
			<button
				type="button"
				_="on click 
					if #confirmWaste-bar.classList contains 'translate-y-0'
						tell #confirmWaste-bar
						remove .translate-y-0 then add .translate-y-full
						then add .hidden to #confirmWaste-backdrop
					end"
				class="outline-none rounded-md mb-2 font-medium bg-red-400 text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-8 text-center text-black"
			>Cancel</button>
		</section>
	</div>
}

templ SubmitWaste() {
	<button
		type="button"
		hx-post="/account/submitWaste"
		hx-trigger="click"
		hx-vals="js:{...getWasteData()}"
		class="outline-none rounded-md mb-2 font-medium bg-[#016934] text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-8 text-center text-white"
	>
		Send Waste Data To Server
	</button>
}
