package frontend

templ ScanQRPage() {
	<!DOCTYPE html>
	<html lang="en">
		@HeadTag("scan")
		<body
			class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh font-montserrat text-[#2E2E2E] overflow-hidden"
		>
			<div class="Page w-full h-full flex flex-col font-montserrat text-[#2E2E2E]">
				<header class="pt-6 pl-6 pr-[1.56rem] flex w-full justify-between items-center">
					<button>
						<img
							src="/public/assets/svg/back_arrow.svg"
							alt=""
							class="w-6 aspect-square"
						/>
					</button>
					<p class="font-semibold text-[0.938rem] leading-[1.143rem]">Scan</p>
					<button
						class="bg-[#CCE1D699] p-2 rounded-md flex justify-center items-center"
						_="on click
							tell #notification-bar
							if #notification-bar.classList does not contain 'translate-y-0'
								remove .translate-y-full then add .translate-y-0
								then add .{'backdrop:backdrop-blur-3xl'}
								then call #notification-bar.focus() 
								then remove .hidden from #backdrop then halt
							end"
					>
						<img
							src="/public/assets/svg/notification.svg"
							class="w-[1.5rem] aspect-square"
						/>
					</button>
					@notificationBar()
				</header>
				<main class="grow overflow-y-auto pl-[1.438rem] pr-[1.375rem] mt-[4.5rem]">
					<div class="h-full w-full flex flex-col justify-around items-center ">
						<section id="xyz">
							<picture>
								<source type="image/webp" srcset="/public/assets/images/qr_code.webp"/>
								<img
									src="/public/assets/images/qr_code.jpg"
									alt=""
									class="w-[22rem] aspect-square m-auto"
								/>
							</picture>
							<article
								class="mt-[0.938rem] mr-10 ml-[2.5625rem] font-normal font-poppins text-sm text-center"
							>
								<p>
									Scan QR code on the smart bin
									to
								</p>
								<p>dispose waste</p>
							</article>
						</section>
						<div id="reader"></div>
						<section class="w-full flex justify-around items-center gap-[0.625rem]">
							<button
								onclick="scan()"
								class="scanButton w-full h-full bg-[#016934] rounded-md"
							>
								<p
									class="scanButtonText font-montserrat font-medium text-center text-[0.813rem] text-white"
								>
									Scan
								</p>
							</button>
							<a
								href="/account/history"
								class="bg-[#CCE1D699] p-[0.688rem] rounded-md inline justify-center items-center"
							>
								<img
									src="/public/assets/svg/octicon_history-16.svg"
									class="w-[1.125rem]  aspect-square"
								/>
							</a>
						</section>
					</div>
				</main>
				@Footer("scan", templ.NopComponent)
			</div>
			@scriptForScanPage()
		</body>
	</html>
}

templ scriptForScanPage() {
	<style>
		#toast-container {
			margin-top: 0.25rem; 
		}
	</style>
	<script src="/public/assets/scripts/html5-qrcode.min.js"></script>
	<script src="/public/assets/scripts/jquery.min.js"></script>
	<script src="/public/assets/scripts/toastr.min.js"></script>
	<script src="/public/assets/scripts/hyperscript.min.js"></script>
	<script>
            const html5QrCode = new Html5Qrcode( "reader" );
            let isScanning = false;

            function scan () {
                const readerContainer = document.getElementById( "reader" );
                const xyz = document.getElementById( 'xyz' );
                const scanButton = document.getElementsByClassName( 'scanButton' )[ 0 ];
                const scanButtonText = document.getElementsByClassName( 'scanButtonText' )[ 0 ];
                const width = xyz.offsetWidth;
                const height = xyz.offsetHeight;

                if ( isScanning )
                {
                    stopScanning();
                    return;
                }

                readerContainer.style.width = `${( 83 / 100 ) * width}px`;
                readerContainer.style.height = `${( 83 / 100 ) * height}px`;
                const config = { fps: 10, qrbox: { width: width, height: height } };

                html5QrCode.start( { facingMode: "environment" }, config, qrCodeSuccessCallback, qrCodeErrorCallback )
                    .then( () => {
                        isScanning = true;
                        xyz.style.display = 'none';
                        scanButton.style.backgroundColor = '#FF0000';
                        scanButtonText.innerText = 'Cancel Scanning';
                    } )
                    .catch( ( err ) => {
                        isScanning = false;
                        console.error( err );
                    } );

            }

            function qrCodeSuccessCallback ( decodedText, decodedResult ) {
                console.log( `Scan result: ${decodedText}`, decodedResult );
				console.log("that does not seem like ours")
				toastr.options = {
						"closeButton": true,
						"debug": false,
						"newestOnTop": false,
						"progressBar": true,
						"positionClass": "toast-top-center",
						"preventDuplicates": true,
						"onclick": null,
						"showDuration": "100",
						"hideDuration": "1000",
						"timeOut": "3000",
						"extendedTimeOut": "1000",
						"showEasing": "swing",
						"hideEasing": "linear",
						"showMethod": "slideDown",
						"hideMethod": "slideUp"
					};
				toastr[ "success" ]("that does not seem like ours")
				stopScanning();
            }

			function qrCodeErrorCallback ( error ) {
                // console.error( "from qrCodeErrorCallback ", error );
            }

            function stopScanning () {
                html5QrCode.stop().then( ( ignore ) => {
                    restoreScreen();
                    isScanning = false;
                } )
                    .catch( ( err ) => {
                        restoreScreen();
                        console.error( "error clearing reader", err );
                    } );
            }

            function restoreScreen () {
                const xyz = document.getElementById( "xyz" );
                const scanButtonText = document.getElementsByClassName( "scanButtonText" )[ 0 ];
                const scanButton = document.getElementsByClassName( 'scanButton' )[ 0 ];

                xyz.style.display = 'block';
                scanButton.style.backgroundColor = '';
                scanButtonText.innerText = 'Scan';
            }
        </script>
}
