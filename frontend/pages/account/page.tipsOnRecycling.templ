package frontend

templ TipsOnRecyclingPage(wasteType string) {
	<!DOCTYPE html>
	<html lang="en">
		@headTag("Waste History")
		<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh w-full overflow-hidden">
			<div class="w-full h-full grid grid-rows-agentDashboardPage">
				<main class="bg-[#FEF7FF] max-h-full overflow-y-auto p-2">
					switch wasteType {
						case "paper":
							@paper()
						case "glass":
							@glass()
						case "metal":
							@metal()
						case "plastics":
							@plastics()
					}
				</main>
				@Footer("dashboard", templ.NopComponent)
			</div>
		</body>
	</html>
}

