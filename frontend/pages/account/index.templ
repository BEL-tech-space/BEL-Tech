package frontend

templ IndexPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Beltech</title>
			<link
				rel="stylesheet"
				href="/assets/styles/output.css"
			/>
			<style>
        html {
            font-size:  16px;
        }

        @media screen and (max-width: 768px) {
            html {
                font-size: 12px;
            }
        }

        @media screen and (max-width: 576px) {
            html {
                font-size: 10px;
            }
        }

        body {
            font-family: Montserrat;
            margin: 0;
        }
 
        button, input[type="button"], input[type="reset"] {
            background: none;
            color: inherit;
            border: none;
            padding: 0;
            font: inherit;
            cursor: pointer;
            outline: inherit;
        }

        .call-to-action-bg {
            position: absolute;
            top: 0;
            left: 0;
            height: 900px;
            gap: 0px;
            opacity: 0px;
            z-index: -1;
            border-bottom-left-radius: 40rem;
            background: rgba(0, 110, 0, 0.08);
            margin-bottom: 20px;
            width: 100%;
        }

        .navigator-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3rem;
            margin-top: 0.5rem;
            margin-left: .2rem;
            margin-right: .2rem;
        }

        .navigator-controls-wrapper {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }

        .navigator-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 3rem;
        }

        .navigator-controls-wrapper > button {
            margin-right: 1rem;
            padding: 0.625rem 2.5rem;
            border-radius: 0.375rem;
            background: #016934;
            color: white;
            font-family: Montserrat;
            font-size: calc(12/16)rem;
            font-weight: 700;
            text-align: center;
        }

        .call-to-action-container {
            max-width: 65rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: auto;
        }

        .call-to-action-text {
            width: 100%;
            /* margin-left: 1rem;
            margin-right: 1rem; */
        }

        .call-to-action-text p {
            margin: 0;
        }

        .call-to-action-text .call-to-action-header {
            font-size: 4rem;
            font-weight: 700;
            line-height: 4.87625rem;
            text-align: left;
            margin-bottom: 1rem;
        }

        .call-to-action-header .call-to-action-emphasis {
            color: #C48E01;
            font-size: 4rem;
            font-weight: 700;
            line-height: 4.87625rem;
            text-align: left;
        }

        .call-to-action-text .call-to-action-subtext {
            font-family: Poppins;
            font-size: 1.5rem;
            font-weight: 400;
            line-height: 2rem;
            text-align: left;
        }

        .call-to-action-img img {
            width: 35rem;
            /* width: 100%; */
            height: 70%;
        }

        .call-to-action-button {
            margin-top: 4rem;
            background: #016934;
            border-radius: 0.49rem;
            text-align: center;
            font-size: clamp(0.54625rem, 0.2707rem + 1.1303vw, 1.294375rem);
            line-height: clamp(0.6825rem, 0.3379rem + 1.4136vw, 1.618125rem);
        }

        .how-it-works {
            margin-top: 320px;
            max-width: 65rem;
            margin-left: auto;
            margin-right: auto;
        }

    

        .how-it-works-onboarding {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }

        .how-it-works-onboarding-item-flex-group {
            display: flex;
        }

        .how-it-works-onboarding-item:nth-of-type(1) {
            width: 17.9375rem;
            height: 25.3125rem;
        }
        
        .how-it-works-onboarding-item-flex-group .how-it-works-onboarding-item:nth-of-type(1) {
            width: 17.375rem;
            height: 24.75rem;
        }

        .how-it-works-onboarding-item-flex-group .how-it-works-onboarding-item:nth-of-type(2) {
            width: 16.0625rem;
            height: 25.25rem;
        }

        .how-it-works-onboarding-item p {
            text-align: center;
        }

        .how-it-works-next-indicator {
            /* width: 176.46px; */
            height: 37.29px;
            transform: rotate(-9.13deg);
            margin-top: 6rem;
        }



        @media screen and (max-width: 1140px) {
            .call-to-action-container {
                flex-direction: column;
            }

            .call-to-action-text {
                margin-top: 30px;
            }

            .call-to-action-img img {
                height: auto;
            }

            .call-to-action-text {
                max-width: 40rem;
            }

            .call-to-action-img {
                text-align: center;
            }

            .how-it-works {
                margin-top: unset;
            }


            .how-it-works-onboarding {
                margin-top: 20px;
                width: fit-content;
                margin-left: auto;
                margin-right: auto;
            }

            .how-it-works-onboarding-item-flex-group {
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                gap: 3rem;
            }

            .how-it-works-onboarding-item-flex-group .how-it-works-next-indicator {
                transform: rotate(90deg);
                margin-top: 40px;
                margin-bottom: 30px;
            }
        }


        @media screen and (max-width: 768px) {
            .how-it-works-onboarding {
                flex-direction: column;
                align-items: center;
                justify-content: center;
            }

            .how-it-works-onboarding > .how-it-works-next-indicator {
                width: 114.5px;
                transform: rotate(90deg);
                margin-top: 84px;
                margin-bottom: 30px;
            }

            .waitlist-input-container {
                margin: 3.25rem auto;
            }
        }

        @media screen and (max-width: 576px) {
            .how-it-works-onboarding-item:nth-of-type(1), 
            .how-it-works-onboarding-item-flex-group .how-it-works-onboarding-item:nth-of-type(1), 
            .how-it-works-onboarding-item-flex-group .how-it-works-onboarding-item:nth-of-type(2) {
                width: unset;
            }

            .how-it-works-onboarding > .how-it-works-next-indicator {
                margin-top: 110px;
            }


            .how-it-works-onboarding-item-flex-group .how-it-works-next-indicator {
                margin-top: 90px;
            }
        }


        .agent {
            .textOne {
                font-size: clamp(0.9375rem, 0.4541rem + 1.983vw, 2.25rem);
                line-height: clamp(1.143125rem, 0.5541rem + 2.4164vw, 2.7425rem);
            }
            .textTwo {
                font-size: clamp(0.625rem, 0.3028rem + 1.322vw, 1.5rem);
                line-height: clamp(0.9375rem, 0.4541rem + 1.983vw, 2.25rem);
            }
            .textThree {
                font-size: clamp(0.54625rem, 0.2707rem + 1.1303vw, 1.294375rem);
                line-height: clamp(0.6825rem, 0.3379rem + 1.4136vw, 1.618125rem);
            }
        }

        .how-it-works-label-icon {
            p {
                font-size: clamp(0.9375rem, 0.4541rem + 1.983vw, 2.25rem);
                line-height: clamp(1.143125rem, 0.5541rem + 2.4164vw, 2.7425rem);            
            }

            img {
                width: clamp(2.68875rem, 1.4003rem + 5.2861vw, 6.1875rem);
                aspect-ratio: 1.581/1;
            }
        }

        .how-it-works p{
           font-size: clamp(0.8125rem, 0.5593rem + 1.0387vw, 1.5rem);
           line-height: clamp(0.990625rem, 0.682rem + 1.2663vw, 1.82875rem);
        }
        
        .call-to-action-header {
            font-size: clamp(1.686875rem, 0.835rem + 3.4948vw, 4rem);
            line-height: clamp(2.05625rem, 1.0177rem + 4.2606vw, 4.87625rem);
        }

        .call-to-action-subtext {
            font-size: clamp(0.6325rem, 0.313rem + 1.3107vw, 1.5rem);  
            line-height: clamp(0.94875rem, 0.4695rem + 1.966vw, 2.25rem);
        }
        
    </style>
		</head>
		<body class="font-montserrat">
			<img class="call-to-action-bg" src="/assets/images/grid.png" alt="background-image"/>
			<nav class="navigator-row">
				<div class="logo-adjustment-container">
					<img src="/assets/images/beltech.png" alt="logo"/>
				</div>
				<div class="navigator-controls-wrapper">
					<div></div>
					<div class="navigator-controls">
						<span class="text-[#016934] font-bold">Home</span>
						<span>About</span>
						<span>Contact Us</span>
					</div>
					<button onclick="window.location.href='/account/signin'">
						<span>Log In</span>
					</button>
				</div>
			</nav>
			<main>
				<section class="call-to-action-container px-2">
					<div class="call-to-action-text">
						<p class="call-to-action-header">
							Dispose, Recycle and <span class="call-to-action-emphasis">Earn BEL</span> tokens
						</p>
						<p class="call-to-action-subtext font-poppins">
							We make it easy to live a zero waste life and earn BEL tokens
						</p>
						<button class="call-to-action-button py-[0.75rem] px-[3.969rem] text-white font-bold max-sm:tracking-[0.00313rem] tracking-[0.00813rem]">
							Start now
						</button>
					</div>
					<div class="call-to-action-img">
						<img src="/assets/images/call-to-action-img.png" alt="call to action image"/>
					</div>
				</section>
				<section class="how-it-works">
					<section class="how-it-works-label-icon mt-20 flex flex-col gap-4 justify-center items-center">
						<img src="/assets/images/world.png" alt="" class=""/>
						<p class="font-bold text-[#016934]">How does it work?</p>
					</section>
					<div class="how-it-works-onboarding">
						<div class="how-it-works-onboarding-item">
							<img src="/assets/images/sign-into-user-account.png" alt="sign in into user account"/>
							<p class="font-medium text-center text-black">Start by signing up on our platform</p>
						</div>
						<img class="how-it-works-next-indicator" src="/assets/images/arrow.png" alt="arrow"/>
						<div class="how-it-works-onboarding-item-flex-group">
							<div class="how-it-works-onboarding-item">
								<img src="/assets/images/qr-scan.png" alt="woman scanning qr code with her phone"/>
								<p class="font-medium text-center text-black">Scan the e-bin with your mobile phone</p>
							</div>
							<img class="how-it-works-next-indicator" src="/assets/images/arrow.png" alt="arrow"/>
							<div class="how-it-works-onboarding-item">
								<img src="/assets/images/financial-growth.png" alt="man experiencing financial growth"/>
								<p class="font-medium text-center text-black">Dispose your waste and earn BEL tokens</p>
							</div>
						</div>
					</div>
				</section>
				<section id="agents" class="agent mt-24 flex flex-col gap-10 justify-center items-center mb-24">
					<article class="text-[#2E2E2E] text-center flex flex-col gap-4 items-center justify-center">
						<p class="textOne font-bold text-center">Register to be a <span class="text-[#C48E01]">Collector</span> now!</p>
						<p class="textTwo font-normal font-poppins">Register to be a collector in your location <br/> and receive more rewards</p>
					</article>
					<div class="flex justify-between items-center gap-8">
						<a href="#" class="bg-[#016934] textThree rounded-[0.486rem] py-2 px-[1.674rem] text-white font-bold text-center">Register</a>
						<a href="/agent/signin" class="bg-[#016934] textThree rounded-[0.486rem] py-2 px-[1.674rem] text-white font-bold text-center">Log in as collector</a>
					</div>
				</section>
			</main>
			<footer class="bg-[#016934] flex flex-row justify-between max-sm:justify-center items-center py-32 pr-6 max-sm:flex-col max-sm:gap-[3.008rem] max-sm:pt-8 max-sm:pb-[1.652rem] max-sm:pl-[1.966rem] max-sm:pr-[1.031rem]">
				<img src="/assets/images/footer-logo.png" alt="Beltech footer logo" class="w-[10.719rem] aspect-[171.51/176.22] mx-auto rounded-full"/>
				<section class="grid grid-cols-3 justify-between items-start gap-[2.659rem] text-xs text-white font-medium">
					<div class="flex flex-col justify-start items-start gap-6 max-sm:gap-[0.798rem] font-medium">
						<a href="#">Home</a>
						<a href="#">About Us</a>
						<a href="#">Contact Us</a>
					</div>
					<div class="flex flex-col justify-start items-start gap-6 max-sm:gap-[0.798rem] font-medium">
						<a href="#">Newsletter</a>
						<a href="/account/signin">Login Beltech account</a>
						<a href="/agent/signin">Login as Beltech collector</a>
					</div>
					<div class="flex flex-col justify-start items-start gap-6 max-sm:gap-[0.798rem] font-medium">
						<a href="#">Helpdesk</a>
						<a href="#">Policies</a>
						<a href="#">Terms and Conditions</a>
					</div>
				</section>
				<section class="ml-auto mt-[1.823rem] flex flex-col max-sm:flex-row gap-4 items-center">
					<a href="">
						<img src="/assets/svg/android.svg" alt="android app" class="max-sm:w-[1.125rem] w-6"/>
					</a>
					<a href="">
						<img src="/assets/svg/apple.svg" alt="ios app" class="max-sm:w-[1.125rem] w-6"/>
					</a>
					<a href="">
						<img src="/assets/svg/google-play.svg" alt="playstore" class="max-sm:w-[1.125rem] w-6"/>
					</a>
					<a href="">
						<img src="/assets/svg/global.svg" alt="web" class="max-sm:w-[1.125rem] w-6"/>
					</a>
				</section>
			</footer>
		</body>
	</html>
}
