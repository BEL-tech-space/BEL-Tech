package frontend

templ IndexPage() {
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Beltech</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <style>
        html {
            font-size:  16px;
        }

        @media screen and (max-width: 768px) {
            html {
                font-size: 12px;
            }
        }

        @media screen and (max-width: 576px) {
            html {
                font-size: 10px;
            }
        }

        body {
            font-family: Montserrat;
            margin: 0;
        }
 
        button, input[type="button"], input[type="reset"] {
            background: none;
            color: inherit;
            border: none;
            padding: 0;
            font: inherit;
            cursor: pointer;
            outline: inherit;
        }

        .call-to-action-bg {
            position: absolute;
            top: 0;
            left: 0;
            height: 900px;
            gap: 0px;
            opacity: 0px;
            z-index: -1;
            border-bottom-left-radius: 40rem;
            background: rgba(0, 110, 0, 0.08);
            margin-bottom: 20px;
            width: 100%;
        }

        .navigator-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3rem;
            margin-top: 0.5rem;
            margin-left: .2rem;
            margin-right: .2rem;
        }

        .navigator-controls-wrapper {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }

        .navigator-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 3rem;
        }

        .navigator-controls-wrapper > button {
            margin-right: 1rem;
            padding: 0.625rem 2.5rem;
            border-radius: 0.375rem;
            background: #016934;
            color: white;
            font-family: Montserrat;
            font-size: calc(12/16)rem;
            font-weight: 700;
            text-align: center;
        }

        .call-to-action-container {
            max-width: 65rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: auto;
        }

        .call-to-action-text {
            width: 100%;
            /* margin-left: 1rem;
            margin-right: 1rem; */
        }

        .call-to-action-text p {
            margin: 0;
        }

        .call-to-action-text .call-to-action-header {
            font-size: 4rem;
            font-weight: 700;
            line-height: 4.87625rem;
            text-align: left;
            margin-bottom: 1rem;
        }

        .call-to-action-header .call-to-action-emphasis {
            color: #C48E01;
            font-size: 4rem;
            font-weight: 700;
            line-height: 4.87625rem;
            text-align: left;
        }

        .call-to-action-text .call-to-action-subtext {
            font-family: Poppins;
            font-size: 1.5rem;
            font-weight: 400;
            line-height: 2rem;
            text-align: left;
        }

        .call-to-action-img img {
            width: 35rem;
            /* width: 100%; */
            height: 70%;
        }

        .call-to-action-button {
            margin-top: 4rem;
            width: 15.625rem;
            height: 3.125rem;
            padding:  0.25rem 0.81rem;
            background: #016934;
            border-radius: 0.49rem;
            color: white;
            font-size: 1.29rem;
            font-weight: 700;
            line-height: 1.61rem;
            letter-spacing: 0.008rem;
            text-align: center;
        }

        .how-it-works {
            margin-top: 320px;
            max-width: 65rem;
            margin-left: auto;
            margin-right: auto;
        }

        .how-it-works-label-icon {
            margin: auto;
            text-align: center;
        }

        .how-it-works-label-icon p {
            font-size: 2.25rem;
            font-weight: 700;
            line-height: 2.7425rem;
            color: #016934;
            margin: 0;
        }

        .how-it-works-onboarding {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }

        .how-it-works-onboarding-item-flex-group {
            display: flex;
        }

        .how-it-works-onboarding-item:nth-of-type(1) {
            width: 17.9375rem;
            height: 25.3125rem;
        }
        
        .how-it-works-onboarding-item-flex-group .how-it-works-onboarding-item:nth-of-type(1) {
            width: 17.375rem;
            height: 24.75rem;
        }

        .how-it-works-onboarding-item-flex-group .how-it-works-onboarding-item:nth-of-type(2) {
            width: 16.0625rem;
            height: 25.25rem;
        }

        .how-it-works-onboarding-item p {
            text-align: center;
        }

        .how-it-works-next-indicator {
            /* width: 176.46px; */
            height: 37.29px;
            transform: rotate(-9.13deg);
            margin-top: 6rem;
        }

        .waitlist {
            position: relative;
            padding: 5rem 0;
        }

        .waitlist-bg {
            position: absolute;
            z-index: -1;
            top: 0;
            right: 100px;
            width: 100%;
            height: 600px;
            border-bottom-right-radius: 300px;
            background: rgba(0, 110, 0, 0.08);
        }

        .waitlist-header {
            margin: auto;
            width: fit-content;
            color: #016934;
            font-size: 36px;
            font-weight: 700;
            line-height: 43.88px;
        }

        .waitlist-subtext {
            margin: 1rem auto;
            width: 32rem;
            text-align: center;
        }

        form {
            margin: 3.5rem auto 0 auto;
            width: fit-content;
        }

        .waitlist-input-container {
            position: relative;
            width: 27.6875rem;
            height: 2.659375rem;
            margin: 20px auto;
        }

        .waitlist-input-container input {
            width: 100%;
            padding: 10px;
            border: 1px solid #444;
            background-color: #fff;
            font-size: 12.76px;
            font-weight: 500;
            line-height: 17.01px;
            letter-spacing: 0.4252942204475403px;
            border: 0.53px solid #569B78;
            border-radius: 4.25px;
        }

        .waitlist-input-container label {
            position: absolute;
            top: -10px;
            left: 10px;
            background-color: #fff;
            padding: 0 5px;
            font-size: 12.76px;
            font-weight: 500;
            line-height: 17.01px;
            letter-spacing: 0.4252942204475403px;
            text-align: left;
            color: #569B78;
        }

        .waitlist-input-container input:focus {
            outline: none;
        }

        .waitlist-input-container input:focus + label {
            color: #569B78;
        }

        .waitlist-input-container input::placeholder {
            color: #B0ADAD;            ;
        }

        .waitlist-input-submit {
            width: fit-content;
            margin-top: 2.5rem;
            /* margin: auto; */
            background: #016934;
            color: white;
            width: 8.144375rem;
            padding: 6.75px;
            border-radius: 4.05px;
            text-align: center;
        }

        .waitlist-input-submit input {
            width: 100%;
        }

        footer {
            margin: 6rem 0 0 0;
            padding: 3rem 0 1.5rem 0;
            background: #016934;
        }

        .footer-logo img {
            border-radius: 100%;
        }

        .footer-link-logo-row {
            display: flex;
            align-items: center;
            justify-content: space-evenly;
            gap: 1.5rem;
        }

        .footer-links {
            display: flex;
            justify-content: space-between;
            gap: 3rem;
            color: white;
            font-size: 1.25rem;
            font-weight: 500;
            line-height: 1.52375rem;
            text-align: left;
        }

        .footer-app-dowloadables {
            display: flex;
            flex-direction: column;
            align-items: end;
            justify-content: end;
            margin-right: 1.5rem;
            gap: 1rem;
        }

        @media screen and (max-width: 1140px) {
            .call-to-action-container {
                flex-direction: column;
            }

            .call-to-action-text {
                margin-top: 30px;
            }

            .call-to-action-img img {
                height: auto;
            }

            .call-to-action-text {
                max-width: 40rem;
            }

            .call-to-action-img {
                text-align: center;
            }

            .how-it-works {
                margin-top: unset;
            }

            .how-it-works-label-icon {
                margin-top: 1rem;
            }

            .footer-link-logo-row {
                flex-direction: column;
            }

            .footer-links {
                justify-content: space-evenly;
                gap: 3rem;
                width: 100%;
            }

            .how-it-works-onboarding {
                margin-top: 20px;
                width: fit-content;
                margin-left: auto;
                margin-right: auto;
            }

            .how-it-works-onboarding-item-flex-group {
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                gap: 3rem;
            }

            .how-it-works-onboarding-item-flex-group .how-it-works-next-indicator {
                transform: rotate(90deg);
                margin-top: 40px;
                margin-bottom: 30px;
            }
        }


        @media screen and (max-width: 768px) {
            .how-it-works-onboarding {
                flex-direction: column;
                align-items: center;
                justify-content: center;
            }

            .how-it-works-onboarding > .how-it-works-next-indicator {
                width: 114.5px;
                transform: rotate(90deg);
                margin-top: 84px;
                margin-bottom: 30px;
            }

            .waitlist-input-container {
                margin: 3.25rem auto;
            }
        }

        @media screen and (max-width: 576px) {
            .how-it-works-onboarding-item:nth-of-type(1), 
            .how-it-works-onboarding-item-flex-group .how-it-works-onboarding-item:nth-of-type(1), 
            .how-it-works-onboarding-item-flex-group .how-it-works-onboarding-item:nth-of-type(2) {
                width: unset;
            }

            .how-it-works-onboarding > .how-it-works-next-indicator {
                margin-top: 110px;
            }


            .how-it-works-onboarding-item-flex-group .how-it-works-next-indicator {
                margin-top: 90px;
            }
        }
    </style>
</head>
<body>
    <img class="call-to-action-bg" src="/assets/images/grid.png" alt="background-image">
    <nav class="navigator-row">
        <div class="logo-adjustment-container">
            <img src="/assets/images/beltech.png" alt="logo">
        </div>
        <div class="navigator-controls-wrapper">
            <div></div>
            <div class="navigator-controls">
                <span>Home</span>
                <span>About</span>
                <span>Contact Us</span>
            </div>
            <button onclick="window.location.href='/signin'">
                <span>Log In</span>
            </button> 
        </div>
    </nav>
    <main>
        <section class="call-to-action-container">
            <div class="call-to-action-text">
                <p class="call-to-action-header">
                    Dispose, Recycle and <span class="call-to-action-emphasis">Earn BEL</span> tokens
                </p>
                <p class="call-to-action-subtext">
                    We make it easy to live a zero waste life and earn BEL tokens
                </p>
                <button class="call-to-action-button">
                    <span>Start now</span>
                </button>
            </div>
            <div class="call-to-action-img">
                <img src="/assets/images/call-to-action-img.png" alt="call to action image">
            </div>
        </section>
        <section class="how-it-works">
            <div class="how-it-works-label-icon">
                <img src="/assets/images/world.png" alt="">
                <p>How does it work?</p>
            </div>
            <div class="how-it-works-onboarding">
                <div class="how-it-works-onboarding-item">
                    <img src="/assets/images/sign-into-user-account.png" alt="sign in into user account">
                    <p>Start by signing up on our platform</p>
                </div>
                <img class="how-it-works-next-indicator" src="/assets/images/arrow.png" alt="arrow">
                <div class="how-it-works-onboarding-item-flex-group">
                    <div class="how-it-works-onboarding-item">
                        <img src="/assets/images/qr-scan.png" alt="woman scanning qr code with her phone">
                        <p>Scan the e-bin with your mobile phone</p>
                    </div>
                    <img class="how-it-works-next-indicator" src="/assets/images/arrow.png" alt="arrow">
                    <div class="how-it-works-onboarding-item">
                        <img src="/assets/images/financial-growth.png" alt="man experiencing financial growth">
                        <p>Dispose your waste and earn BEL tokens</p>
                    </div>
                </div>
            </div>
        </section>
        <section class="waitlist">
            <img class="waitlist-bg" src="/assets/images/grid.png" alt="background-image">
            <h2 class="waitlist-header">
                Join our Waitlist
            </h2>
            <p class="waitlist-subtext">
                Enter email address to join Beltech waitlist and get information firsthand
            </p>
            <form>
                <div class="waitlist-input-container">
                    <input type="name" id="name" required>
                    <label for="name">Name</label>
                  </div>
                  <div class="waitlist-input-container">
                    <input type="email" id="email" required>
                    <label for="email">Email</label>
                  </div>
                  <div class="waitlist-input-container">
                    <input type="wallet-address" id="wallet-address" placeholder="(optional, but anticipate great benefits!)" required>
                    <label for="wallet-address">SPL wallet address</label>
                  </div>
                  <div class="waitlist-input-submit">
                    <input type="button" id="button" name="button" value="Submit" required>
                  </div>
            </form>
        </section>
    </main>
    <footer>
        <div class="footer-link-logo-row">
            <div class="footer-logo">
                <img src="/assets/images/footer-logo.png" alt="Beltech footer logo">
            </div>
            <div class="footer-links">
                <div>
                    <p>Home</p>
                    <p>About Us</p>
                    <p>Contact Us</p>
                </div>
                <div>
                    <p>Register</p>
                    <p>Waitlist</p>
                    <p>Newsletter</p>
                </div>
                <div>
                    <p>Sign In</p>
                    <p>Helpdesk</p>
                    <p>Policies</p>
                    <p>Terms and Conditions</p>
                </div>
            </div>
        </div>
        <div class="footer-app-dowloadables">
            <img src="/assets/svg/android.svg" alt="android app">
            <img src="/assets/svg/apple.svg" alt="ios app">
            <img src="/assets/svg/google-play.svg" alt="playstore">
            <img src="/assets/svg/global.svg" alt="web">
        </div>
    </footer>
</body>
</html>    
}