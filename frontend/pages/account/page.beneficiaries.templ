package frontend

templ AirtimeBeneficiaryPage(user User) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="stylesheet" href="/assets/styles/output.css"/>
			<script src="/assets/libriaries/hyperscript.min.js"></script>
			@removeScrollBar()
			<title>Airtime Beneficiaries</title>
		</head>
		<body class="bg-[url('/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="w-full h-full grid grid-rows-agentCollectPage font-montserrat text-[#2E2E2E]">
				@frequentHeaderTwo("Beneficiaries", user.AvatarUrl, "/assets/svg/+.svg", "on click call #addNewBeneficiairyDialog.showModal() then halt")
				<main class="overflow-y-auto pl-[1.5rem] pr-[1.56rem] pt-12">
					<ul class="w-full flex flex-col justify-center items-center gap-6">
						for range 8 {
							<li class="w-full bg-[#FEF7FF] shadow-[0px_1px_2px_1px_#00000014] pl-2 pr-7 py-3 flex justify-between items-center rounded-lg">
								<div class="flex gap-6 items-center justify-start">
									<img src="/assets/images/mtn.png" alt="" class="w-[3.5rem] aspect-square rounded-full"/>
									<div class="flex flex-col gap-2 justify-start items-start">
										<p class="font-poppins font-medium text-xs leading-[1.125rem] text-[#2E2E2E]">Tobias</p>
										<p class="font-montserrat font-bold text-[0.625rem] leading-[0.762rem] text-[#016934]">09034097398</p>
									</div>
								</div>
								<img src="/assets/svg/greenEdit.svg" alt="" class="w-5 aspect-square"/>
							</li>
							<li class="w-full bg-[#FEF7FF] shadow-[0px_1px_2px_1px_#00000014] pl-2 pr-7 py-3 flex justify-between items-center rounded-lg">
								<div class="flex gap-6 items-center justify-start">
									<img src="/assets/images/airtel.png" alt="" class="w-[3.5rem] aspect-square rounded-full"/>
									<div class="flex flex-col gap-2 justify-start items-start">
										<p class="font-poppins font-medium text-xs leading-[1.125rem] text-[#2E2E2E]">Tobias</p>
										<p class="font-montserrat font-bold text-[0.625rem] leading-[0.762rem] text-[#016934]">09034097398</p>
									</div>
								</div>
								<img src="/assets/svg/greenEdit.svg" alt="" class="w-5 aspect-square"/>
							</li>
							<li class="w-full bg-[#FEF7FF] shadow-[0px_1px_2px_1px_#00000014] pl-2 pr-7 py-3 flex justify-between items-center rounded-lg">
								<div class="flex gap-6 items-center justify-start">
									<img src="/assets/images/glo.png" alt="" class="w-[3.5rem] aspect-square rounded-full"/>
									<div class="flex flex-col gap-2 justify-start items-start">
										<p class="font-poppins font-medium text-xs leading-[1.125rem] text-[#2E2E2E]">Tobias</p>
										<p class="font-montserrat font-bold text-[0.625rem] leading-[0.762rem] text-[#016934]">09034097398</p>
									</div>
								</div>
								<img src="/assets/svg/greenEdit.svg" alt="" class="w-5 aspect-square"/>
							</li>
						}
					</ul>
				</main>
				@menuComp("spend")
			</div>
		</body>
		@addNewBeneficiairyDialog()
	</html>
}
