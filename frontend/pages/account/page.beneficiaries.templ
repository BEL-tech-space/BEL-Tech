package frontend

import "beltech/types"

templ BeneficiariesPage(avatarURL string, ben []types.Beneficiary) {
	<!DOCTYPE html>
	<html lang="en">
		@headTag("Airtime Beneficiaries")
		<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="w-full h-full grid grid-rows-agentCollectPage font-montserrat text-[#2E2E2E]">
				@commonHeaderTwo("Beneficiaries", avatarURL, "/public/assets/svg/+.svg", "on click call #addNewBeneficiairyDialog.showModal() then halt", templ.NopComponent, templ.NopComponent)
				@BeneficiariesMain(ben)
				@Footer("spend", templ.NopComponent, templ.NopComponent)
			</div>
		</body>
		@scriptForBeneficiariesPage()
		@addNewBeneficiairyDialog()
	</html>
}

templ BeneficiariesHeaderPartialComp(avatarURL string, beforeHeaderTagPartial, afterHeaderTagPartial templ.Component) {
	@commonHeaderTwo("Beneficiaries", avatarURL, "/public/assets/svg/+.svg", "on click call #addNewBeneficiairyDialog.showModal() then halt", templ.NopComponent, templ.NopComponent)
}

templ BeneficiariesMain(ben []types.Beneficiary) {
	<main class="overflow-y-auto pl-[1.5rem] pr-[1.56rem] pt-12">
		if len(ben) == 0 {
			<div class="flex justify-center items-center">
				<p class="text-center">No beneficiary, click the + to add new beneficiary.</p>
			</div>
		} else {
			<ul class="w-full flex flex-col justify-center items-center gap-6">
				for _, v := range ben {
					<li class="w-full bg-[#FEF7FF] shadow-[0px_1px_2px_1px_#00000014] pl-2 pr-7 py-3 flex justify-between items-center rounded-lg">
						<div class="flex gap-6 items-center justify-start">
							switch v.ServiceProvider {
								case "mtn":
									<picture>
										<source type="image/webp" srcset="/public/assets/images/mtn.webp"/>
										<img src="/public/assets/images/mtn.png" alt="" class="w-[3.5rem] aspect-square rounded-full"/>
									</picture>
								case "airtel":
									<picture>
										<source type="image/webp" srcset="/public/assets/images/airtel.webp"/>
										<img src="/public/assets/images/airtel.png" alt="" class="w-[3.5rem] aspect-square rounded-full"/>
									</picture>
								case "glo":
									<picture>
										<source type="image/webp" srcset="/public/assets/images/glo.webp"/>
										<img src="/public/assets/images/glo.png" alt="" class="w-[3.5rem] aspect-square rounded-full"/>
									</picture>
								case "9mobile":
									<img src="/public/assets/svg/9mobile.svg" alt="" class="w-[3.5rem] aspect-square rounded-full"/>
							}
							<div class="flex flex-col gap-2 justify-start items-start">
								<p class="font-poppins font-medium text-xs leading-[1.125rem] text-[#2E2E2E]">{ v.BName }</p>
								<p class="font-montserrat font-bold text-[0.625rem] leading-[0.762rem] text-[#016934]">{ v.BPhoneNo }</p>
							</div>
						</div>
						<img src="/public/assets/svg/greenEdit.svg" alt="" class="w-5 aspect-square"/>
					</li>
					// <li class="w-full bg-[#FEF7FF] shadow-[0px_1px_2px_1px_#00000014] pl-2 pr-7 py-3 flex justify-between items-center rounded-lg">
					// 	<div class="flex gap-6 items-center justify-start">
					// 		<img src="/public/assets/images/airtel.png" alt="" class="w-[3.5rem] aspect-square rounded-full"/>
					// 		<div class="flex flex-col gap-2 justify-start items-start">
					// 			<p class="font-poppins font-medium text-xs leading-[1.125rem] text-[#2E2E2E]">Tobias</p>
					// 			<p class="font-montserrat font-bold text-[0.625rem] leading-[0.762rem] text-[#016934]">09034097398</p>
					// 		</div>
					// 	</div>
					// 	<img src="/public/assets/svg/greenEdit.svg" alt="" class="w-5 aspect-square"/>
					// </li>
					// <li class="w-full bg-[#FEF7FF] shadow-[0px_1px_2px_1px_#00000014] pl-2 pr-7 py-3 flex justify-between items-center rounded-lg">
					// 	<div class="flex gap-6 items-center justify-start">
					// 		<img src="/public/assets/images/glo.png" alt="" class="w-[3.5rem] aspect-square rounded-full"/>
					// 		<div class="flex flex-col gap-2 justify-start items-start">
					// 			<p class="font-poppins font-medium text-xs leading-[1.125rem] text-[#2E2E2E]">Tobias</p>
					// 			<p class="font-montserrat font-bold text-[0.625rem] leading-[0.762rem] text-[#016934]">09034097398</p>
					// 		</div>
					// 	</div>
					// 	<img src="/public/assets/svg/greenEdit.svg" alt="" class="w-5 aspect-square"/>
					// </li>
				}
			</ul>
		}
	</main>
}

templ scriptForBeneficiariesPage() {
	<script src="/public/assets/scripts/hyperscript.min.js"></script>
}
