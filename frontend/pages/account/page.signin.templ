package frontend

templ SignInPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta
				name="viewport"
				content="width=device-width, initial-scale=1.0"
			/>
			<title>Beltech SignIn</title>
			<link
				rel="stylesheet"
				href="/assets/styles/output.css"
			/>
		</head>
		<body class="bg-white">
			<main class="flex flex-col gap-8 justify-center items-center py-12">
				<img
					src="/assets/images/beltech_logo.png"
					alt="Beltech Logo"
					class="w-36 h-36"
				/>
				<form>
					<div class="mb-8">
						<div class="relative">
							<!-- Overlapping Label -->
							<label
								for="name"
								class="absolute -top-3 left-3 bg-white px-1 text-sm text-gray-500 font-semibold"
							>Email</label>
							<!-- Input Field -->
							<input
								id="email"
								type="text"
								class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline border-green-300"
								placeholder="sign in with Google"
								disabled
							/>
						</div>
					</div>
					<div class="mb-5">
						<div class="relative">
							<!-- Overlapping Label -->
							<label
								for="name"
								class="absolute -top-3 left-3 bg-white px-1 text-sm text-gray-500 font-semibold"
							>Password</label>
							<!-- Input Field -->
							<input
								id="password"
								type="password"
								class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline border-green-300"
								placeholder="sign in with Google"
								disabled
							/>
						</div>
						<div class="flex items-center justify-between gap-2 mt-3">
							<label class="flex items-center">
								<input
									disabled
									type="checkbox"
									class="form-checkbox text-green-600"
								/>
								<span class="ml-2 text-gray-600">Remember me</span>
							</label>
							<a
								href="/verify"
								class="inline-block align-baseline font-bold text-sm text-green-500 hover:text-green-700"
							>
								Forgot Password?
							</a>
						</div>
					</div>
					<div class="flex items-center justify-center">
						<button
							disabled
							class="bg-green-700 hover:bg-green-800 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline w-full"
							type="button"
							onclick="window.location.href='/wallet';"
						>
							Sign In
						</button>
					</div>
					<div class="mt-6 flex items-center justify-between">
						<hr class="w-full border-gray-300"/>
						<span class="px-2 text-gray-500">OR</span>
						<hr class="w-full border-gray-300"/>
					</div>
				</form>
				<!-- Social Signup Buttons -->
				<div class="flex items-center justify-around gap-4">
					<a
						href="/auth/google"
						class="flex flex-col justify-center items-center bg-white border border-gray-300 text-gray-600 px-5 py-3 rounded-lg shadow hover:bg-gray-100"
					>
						<img
							src="/assets/svg/google_icon.svg"
							alt="Google"
							class="w-10 h-10"
						/>
						<p>Google</p>
					</a>
					<a
						href="/auth/facebook"
						class="pointer-events-none flex flex-col justify-center items-center bg-white border border-gray-300 text-gray-600 px-4 py-3 rounded-lg shadow hover:bg-gray-100"
					>
						<img
							src="/assets/svg/facebook_icon.svg"
							alt="Facebook"
							class="w-10 h-10"
						/>
						<p>Facebook</p>
					</a>
				</div>
				<div class="mt-2 text-center">
					<p class="text-gray-600">
						Don't have an accoun? <a
	href="/signup"
	class="text-green-500 font-bold"
>Sign Up</a>
					</p>
				</div>
			</main>
		</body>
	</html>
}
