package pages

templ DashboardPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta
				name="viewport"
				content="width=device-width, initial-scale=1.0"
			/>
			<link
				rel="stylesheet"
				href="/assets/styles/output.css"
			/>
			<style>
				.overflow-y-auto::-webkit-scrollbar {
					width: 0 !important;
					display: none;
					overflow: -moz-scrollbars-none;
					scrollbar-width: none;
				}
			</style>
			<title>Dashboard Beltech-Agent</title>
		</head>
		<body class="bg-[url('/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="w-full h-full grid grid-rows-agentDashboardPage pt-[1.438rem]">
				<main class="overflow-y-auto mx-[1.563rem] mt-8 mb-[1.9368rem] text-[#2E2E2E] font-montserrat">
					<img
						src="/assets/images/beltech_logo.png"
						alt="Beltech Logo"
						class="w-[7.75rem] aspect-square mx-auto"
					/>
					<section class="w-full flex justify-between items-center">
						<p class="text-[0.938rem] leading-[1.143rem] font-semibold">Overview</p>
						<button
							class="bg-[#01693433] px-[0.833rem] flex justify-center items-center gap-[0.417rem] rounded-[1.562rem]"
						>
							<p class="font-bold text-center text-[0.417rem] leading-[1.041rem]">
								This week
							</p>
							<img
								src="/assets/svg/filter_small.svg"
								alt="Notifications"
								class="w-3 aspect-square my-[0.328rem]"
							/>
						</button>
					</section>
					<section class="flex flex-col gap-4 justify-between items-center mb-6 mt-[0.946rem]">
						<article
							class="bg-[#FEF7FF] pl-[0.313rem] pr-6 rounded-lg flex w-full justify-start items-center gap-4"
						>
							<img
								src="/assets/images/glass.jpg"
								alt=""
								class="w-[4.688rem] aspect-[75/70] rounded-lg"
							/>
							<div class="flex flex-col justify-center items-center gap-2">
								<p class="font-medium text-[0.688rem] leading-[0.838rem]">Glass</p>
								<p class="text-[0.625rem] leading-[0.762rem] font-bold">245kg</p>
							</div>
							<img
								src="/assets/svg/arrow_right.svg"
								alt=""
								class="w-[0.938rem] aspect-square ml-auto"
							/>
						</article>
						<article
							class="bg-[#FEF7FF] pl-[0.313rem] pr-6 rounded-lg flex w-full justify-start items-center gap-4"
						>
							<img
								src="/assets/images/book.jpg"
								alt=""
								class="w-[4.688rem] aspect-[75/70] rounded-lg"
							/>
							<div class="flex flex-col justify-center items-center gap-2">
								<p class="font-medium text-[0.688rem] leading-[0.838rem]">Paper</p>
								<p class="text-[0.625rem] leading-[0.762rem] font-bold">245kg</p>
							</div>
							<img
								src="/assets/svg/arrow_right.svg"
								alt=""
								class="w-[0.938rem] aspect-square ml-auto"
							/>
						</article>
						<article
							class="bg-[#FEF7FF] pl-[0.313rem] pr-6 rounded-lg flex w-full justify-start items-center gap-4"
						>
							<img
								src="/assets/images/metal2.jpeg"
								alt=""
								class="w-[4.688rem] aspect-[75/70] rounded-lg"
							/>
							<div class="flex flex-col justify-center items-center gap-2">
								<p class="font-medium text-[0.688rem] leading-[0.838rem]">Metal</p>
								<p class="text-[0.625rem] leading-[0.762rem] font-bold">245kg</p>
							</div>
							<img
								src="/assets/svg/arrow_right.svg"
								alt=""
								class="w-[0.938rem] aspect-square ml-auto"
							/>
						</article>
						<article
							class="bg-[#FEF7FF] pl-[0.313rem] pr-6 rounded-lg flex w-full justify-start items-center gap-4"
						>
							<img
								src="/assets/images/plastic_1.jpg"
								alt=""
								class="w-[4.688rem] aspect-[75/70] rounded-lg"
							/>
							<div class="flex flex-col justify-center items-center gap-2">
								<p class="font-medium text-[0.688rem] leading-[0.838rem]">Plastics</p>
								<p class="text-[0.625rem] leading-[0.762rem] font-bold">245kg</p>
							</div>
							<img
								src="/assets/svg/arrow_right.svg"
								alt=""
								class="w-[0.938rem] aspect-square ml-auto"
							/>
						</article>
					</section>
					<section class="flex items-center justify-between gap-5">
						<div
							class="w-full text-center pt-[1.875rem] pb-[1.686rem] py-[1.063rem] border-[#016934] border-[0.031rem] border-solid rounded-lg text-[#016934]"
						>
							<p class="font-medium text-[0.688rem] leading-[0.838rem] text-nowrap">
								Successful
								Operations
							</p>
							<p class="text-[0.625rem] leading-[0.762rem] font-bold">234 Recycles</p>
						</div>
						<div
							class="w-full text-center pt-[1.875rem] pb-[1.686rem] py-[1.063rem] border-[#EF0E0E] border-[0.031rem] border-solid rounded-lg text-[#9D2323]"
						>
							<p class="font-medium text-[0.688rem] leading-[0.838rem] text-nowrap">
								Failed
								Operations
							</p>
							<p class="text-[0.625rem] leading-[0.762rem] font-bold">23 Recycles</p>
						</div>
					</section>
				</main>
				@footer("dashboard")
			</div>
		</body>
	</html>
}
