package pages

templ DashboardPage() {
	<!DOCTYPE html>
	<html lang="en">
		@headTag("dashboard")
		<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="w-full h-full grid grid-rows-agentDashboardPage pt-[1.438rem] text-[#2E2E2E] font-montserrat">
				<main class="overflow-y-auto mx-[1.563rem] mt-8 mb-[1.9368rem]">
					<picture>
						<source type="image/webp" src="/public/assets/images/beltech_logo.webp"/>
						<img
							src="/public/assets/images/beltech_logo.png"
							alt="Beltech Logo"
							class="w-[7.75rem] aspect-square mx-auto"
						/>
					</picture>
					<section class="w-full flex justify-between items-center">
						<p class="text-[0.938rem] leading-[1.143rem] font-semibold">Overview</p>
						<div class="bg-[#01693433] pl-[0.5rem] pr-[0.833rem] flex justify-center items-center gap-[0.417rem] rounded-[1.562rem]">
							<select name="filter" id="filter" class="appearance-none min-w-fit outline-none">
								<option value="" class="">this week</option>
								<hr/>
								<optgroup label="range">
									<option value="lastweek" class="">last week</option>
									<option value="2Weeks" class="">2wk ago</option>
									<option value="3Weeks" class="">3wk ago</option>
									<option value="4Weeks" class="">4wk ago</option>
									<option value="thisMonth" class="">this month</option>
								</optgroup>
								<hr/>
								<optgroup label="result">
									<option value="single" class="">single</option>
									<option value="combined" class="">combined</option>
								</optgroup>
							</select>
							<label for="filter">
								<img
									src="/public/assets/svg/filter_small.svg"
									alt="Notifications"
									class="w-4 aspect-square"
								/>
							</label>
						</div>
					</section>
					<section class="flex flex-col gap-4 justify-between items-center mb-6 mt-[0.946rem]">
						<article
							class="bg-[#FEF7FF] pl-[0.313rem] pr-6 rounded-lg flex w-full justify-start items-center gap-4"
						>
							<picture>
								<source type="image/webp" src="/public/assets/images/glass.webp"/>
								<img
									src="/public/assets/images/glass.jpg"
									alt=""
									class="w-[4.688rem] aspect-[75/70] rounded-lg"
								/>
							</picture>
							<div class="flex flex-col justify-center items-center gap-2">
								<p class="font-medium text-[0.688rem] leading-[0.838rem]">Glass</p>
								<p class="text-[0.625rem] leading-[0.762rem] font-bold">245kg</p>
							</div>
							<img
								src="/public/assets/svg/arrow_right.svg"
								alt=""
								class="w-[0.938rem] aspect-square ml-auto"
							/>
						</article>
						<article
							class="bg-[#FEF7FF] pl-[0.313rem] pr-6 rounded-lg flex w-full justify-start items-center gap-4"
						>
							<picture>
								<source type="image/webp" src="/public/assets/images/book.webp"/>
								<img
									src="/public/assets/images/book.jpg"
									alt=""
									class="w-[4.688rem] aspect-[75/70] rounded-lg"
								/>
							</picture>
							<div class="flex flex-col justify-center items-center gap-2">
								<p class="font-medium text-[0.688rem] leading-[0.838rem]">Paper</p>
								<p class="text-[0.625rem] leading-[0.762rem] font-bold">245kg</p>
							</div>
							<img
								src="/public/assets/svg/arrow_right.svg"
								alt=""
								class="w-[0.938rem] aspect-square ml-auto"
							/>
						</article>
						<article
							class="bg-[#FEF7FF] pl-[0.313rem] pr-6 rounded-lg flex w-full justify-start items-center gap-4"
						>
							<picture>
								<source type="image/webp" src="/public/assets/images/metal2.webp"/>
								<img
									src="/public/assets/images/metal2.jpeg"
									alt=""
									class="w-[4.688rem] aspect-[75/70] rounded-lg"
								/>
							</picture>
							<div class="flex flex-col justify-center items-center gap-2">
								<p class="font-medium text-[0.688rem] leading-[0.838rem]">Metal</p>
								<p class="text-[0.625rem] leading-[0.762rem] font-bold">245kg</p>
							</div>
							<img
								src="/public/assets/svg/arrow_right.svg"
								alt=""
								class="w-[0.938rem] aspect-square ml-auto"
							/>
						</article>
						<article
							class="bg-[#FEF7FF] pl-[0.313rem] pr-6 rounded-lg flex w-full justify-start items-center gap-4"
						>
							<picture>
								<source type="image/webp" src="/public/assets/images/plastic_2.webp"/>
								<img
									src="/public/assets/images/plastic_2.jpg"
									alt=""
									class="w-[4.688rem] aspect-[75/70] rounded-lg"
								/>
							</picture>
							<div class="flex flex-col justify-center items-center gap-2">
								<p class="font-medium text-[0.688rem] leading-[0.838rem]">Plastics</p>
								<p class="text-[0.625rem] leading-[0.762rem] font-bold">245kg</p>
							</div>
							<img
								src="/public/assets/svg/arrow_right.svg"
								alt=""
								class="w-[0.938rem] aspect-square ml-auto"
							/>
						</article>
					</section>
					<section>
						<p class="text-[0.938rem] leading-[1.143rem] font-semibold mt-6 mb-[0.875rem]">Statistics</p>
						<div class="flex items-center justify-between gap-5">
							<div class="w-full flex flex-col justify-center items-center gap-[0.625rem] bg-[#FEF7FF] py-[0.688rem] px-[2.688rem]">
								<picture>
									<source type="image/webp" srcset="/public/assets/images/Recycle_small.png"/>
									<img
										src="/assets/images/Recycle_small.png"
										alt="Recycle Icon"
										class="w-[1.875rem] aspect-square"
									/>
								</picture>
								<div>
									<p class="font-medium text-xs leading-[0.914rem]">Operations</p>
									<p class="font-bold text-[0.625rem] leading-3">234 Recycles</p>
								</div>
							</div>
							<div class="w-full flex flex-col justify-center items-center gap-[0.625rem] bg-[#FEF7FF] py-[0.688rem] px-[2.688rem]">
								// <picture>
								// <source type="image/webp" srcset="/public/assets/images/Recycle_small.png"/>
								<img
									src="/public/assets/svg/yellow.svg"
									alt=""
									class="w-[3.313rem] aspect-[53/35.33]"
								/>
								// </picture>
								<div>
									<p class="font-medium text-xs leading-[0.914rem]">Cummulative</p>
									<p class="font-medium text-[0.625rem] leading-3 text-center">Data</p>
								</div>
							</div>
						</div>
					</section>
				</main>
				@Footer("dashboard")
			</div>
		</body>
	</html>
}
