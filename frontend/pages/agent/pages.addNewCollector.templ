package pages

import "beltech/service"

templ AddNewCollector(collector service.Collector, collectorAddedSuccessfully bool) {
	<!DOCTYPE html>
	<html lang="en">
		@headTag("profile")
		<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="w-full h-full flex flex-col pt-6 text-[#2E2E2E] font-montserrat ">
				@profileBar(collector)
				<main class="grow overflow-y-scroll px-6">
					@letRecycleAndProfile("Collector")
					<form
						method="post"
						name="collector"
						action="/agent/addNewCollector"
						class="mt-10 flex flex-col justify-center items-center gap-6"
					>
						<div class="relative">
							<label for="firstname" name="collector" class="font-bold text-sm tracking-[0.025rem] text-[#49454F]">First Name</label>
							<input id="firstname" name="firstname" required type="text" class="w-[21.375rem] aspect-[342/36] rounded border-[0.0313rem] outline-none border-[#569B78] border-solid text-xs font-medium pl-3 pt-1"/>
						</div>
						<div class="relative">
							<label for="lastname" name="collector" class="font-bold text-sm tracking-[0.025rem] text-[#49454F]">Last Name</label>
							<input id="lastname" name="lastname" required type="text" class="w-[21.375rem] aspect-[342/36] rounded border-[0.0313rem] outline-none border-[#569B78] border-solid text-xs font-medium pl-3 pt-1"/>
						</div>
						<div class="relative">
							<label for="displayname" name="collector" class="font-bold text-sm tracking-[0.025rem] text-[#49454F]">Display Name</label>
							<input id="displayname" name="displayname" type="text" class="w-[21.375rem] aspect-[342/36] rounded border-[0.0313rem] outline-none border-[#569B78] border-solid text-xs font-medium pl-3 pt-1"/>
						</div>
						<div class="relative">
							<label for="email" name="collector" class="font-bold text-sm tracking-[0.025rem] text-[#49454F]">Email Address</label>
							<input id="email" name="email" required type="text" class="w-[21.375rem] aspect-[342/36] rounded border-[0.0313rem] outline-none border-[#569B78] border-solid text-xs font-medium pl-3 pt-1"/>
						</div>
						<div class="relative">
							<label for="role" class="font-bold text-sm tracking-[0.025rem] text-[#49454F]">Role</label>
							<select id="role" name="role" required class="w-[21.375rem] aspect-[342/36] rounded border-[0.0313rem] outline-none border-[#569B78] border-solid text-xs font-medium pl-3 pt-1 bg-white">
								<option value="" disabled selected>Select a role</option>
								<option value="collector">Collector</option>
								<option value="super_collector">Super Collector</option>
							</select>
						</div>
						<div class="my-7 w-full">
							<button class="w-full bg-[#016934] py-3 rounded-md px-[5.438rem] font-montserrat font-medium text-sm text-center tracking-[0.1px] text-white text-nowrap">
								Add Collector
							</button>
						</div>
					</form>
				</main>
				@footer("profile")
			</div>
		</body>
		if collectorAddedSuccessfully {
			<script>
                    alert("Collector has been added successful and can login now.")
            </script>
		}
	</html>
}
