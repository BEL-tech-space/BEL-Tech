package pages

templ UnauthorizedPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link
				rel="stylesheet"
				href="/assets/styles/output.css"
			/>
			<title>Unauthorized</title>
		</head>
		<body class="bg-[url('/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="w-full h-full grid grid-rows-agentDashboardPage pt-11 overflow-y-auto font-montserrat">
				<div class="mx-6 flex flex-col justify-center items-center gap-[5.5rem]">
					<img
						src="/assets/svg/unauthorized.svg"
						alt=""
						class="w-[24.375rem] min-w-[51%] aspect-[390/437]"
					/>
					<a
						href="#"
						class="w-full bg-[#016934] py-3 rounded-md px-[5.438rem] font-medium text-sm text-center tracking-[0.1px] text-white text-nowrap"
					>
						Unauthorized 
					</a>
				</div>
				<footer class="bg-white flex w-full justify-around mt-[1.125rem] gap-[2.375rem] text-[#016934]">
					<a
						href="#"
						class="flex flex-col justify-center items-center"
					>
						<img
							src="/assets/svg/home linear.svg"
							class="w-6 aspect-square"
						/>
						<p class="font-bold text-[0.5rem] leading-[1.25rem]">Home</p>
					</a>
					<a
						href="#"
						class="flex flex-col justify-center items-center"
					>
						<img
							src="/assets/svg/collect_icon_linear.svg"
							class="w-6 aspect-square"
						/>
						<p class="font-bold text-[0.5rem] leading-[1.25rem]">Collect</p>
					</a>
					<a
						href="#"
						class="flex flex-col justify-center items-center"
					>
						<img
							src="/assets/svg/history_icon_linear.svg"
							class="w-6 aspect-square"
						/>
						<p class="font-bold text-[0.5rem] leading-[1.25rem]">History</p>
					</a>
					<a
						href="#"
						class="flex flex-col justify-center items-center"
					>
						<img
							src="/assets/svg/profile.svg"
							class="w-6 aspect-square"
						/>
						<p class="font-bold text-[0.5rem] leading-[1.25rem]">Profile</p>
					</a>
					<a
						href="#"
						class="flex flex-col justify-center items-center"
					>
						<img
							src="/assets/svg/logout_linear.svg"
							class="w-6 aspect-square"
						/>
						<p class="font-bold text-[0.5rem] leading-[1.25rem]">Logout</p>
					</a>
				</footer>
			</div>
		</body>
		@unauthorizedDialog()
	</html>
}

templ unauthorizedDialog() {
	<dialog id="unauthorized" class="backdrop:backdrop-blur-sm pt-8 pb-16 px-8 rounded-3xl border-solid border-[0.0625rem] border-white text-[#2E2E2E] outline-none">
		<img
			src="/assets/svg/unauthorized.svg"
			alt=""
			class="w-[11.813rem] aspect-square mx-auto"
		/>
		<p class="text-center font-bold text-base leading-[1.219rem] mx-auto mb-2 mt-3">
			Unauthorized
		</p>
		<p class="font-poppins font-medium text-xs leading-[1.125rem] text-center">Sorry, you do not have permission to use this application page</p>
		<p class="font-poppins font-medium text-xs leading-[1.125rem] text-center mt-5">Redirecting after <span class="font-bold">3 secs...</span></p>
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const dialog = document.getElementById('unauthorized');
				dialog.showModal();

                setTimeout(() => {
                    // dialog.close() 
                    window.location.href = "/"; // Replace with your desired redirect URL
                }, 3000);
                
			});
		</script>
	</dialog>
}
