package pages

templ ProfilePage(collector Collector) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link
				rel="stylesheet"
				href="/assets/styles/output.css"
			/>
			<title>Profile Beltech-Agent</title>
		</head>
		<body class="bg-[url('/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="w-full h-full flex flex-col px-6 pt-6 text-[#2E2E2E] font-montserrat ">
				@profileBar(collector)
				<main class="grow overflow-y-scroll">
					@letRecycleAndProfile("Collector")
					<form class="mt-10 flex flex-col justify-center items-center gap-6">
						<div class="relative">
							<label for="firstname" name="collector" class="font-bold text-sm tracking-[0.025rem] text-[#49454F]">First Name</label>
							<input id="firstname" type="text" value={ collector.FirstName } class="w-[21.375rem] aspect-[342/36] rounded border-[0.0313rem] outline-none border-[#569B78] border-solid text-xs font-medium pl-3 pt-1"/>
						</div>
						<div class="relative">
							<label for="lastname" name="collector" class="font-bold text-sm tracking-[0.025rem] text-[#49454F]">Last Name</label>
							<input id="lastname" type="text" value={ collector.LastName } class="w-[21.375rem] aspect-[342/36] rounded border-[0.0313rem] outline-none border-[#569B78] border-solid text-xs font-medium pl-3 pt-1"/>
						</div>
						<div class="relative">
							<label for="nickName" name="collector" class="font-bold text-sm tracking-[0.025rem] text-[#49454F]">Display Name</label>
							<input id="nickName" type="text" value={ collector.NickName } class="w-[21.375rem] aspect-[342/36] rounded border-[0.0313rem] outline-none border-[#569B78] border-solid text-xs font-medium pl-3 pt-1"/>
						</div>
						<div class="relative">
							<label for="email" name="collector" class="font-bold text-sm tracking-[0.025rem] text-[#49454F]">Email Address</label>
							<input disabled id="email" type="text" value={ collector.Email } class="w-[21.375rem] aspect-[342/36] rounded border-[0.0313rem] outline-none border-[#569B78] border-solid text-xs font-medium pl-3 pt-1"/>
						</div>
						<div class="relative">
							<label for="role" name="collector" class="font-bold text-sm tracking-[0.025rem] text-[#49454F]">Role</label>
							<input disabled id="role" type="text" value={ collector.Role } class="w-[21.375rem] aspect-[342/36] rounded border-[0.0313rem] outline-none border-[#569B78] border-solid text-xs font-medium pl-3 pt-1"/>
						</div>
						<div class="my-7 w-full">
							<button class="w-full bg-[#016934] py-3 rounded-md px-[5.438rem] font-montserrat font-medium text-sm text-center tracking-[0.1px] text-white text-nowrap">
								Save Changes
							</button>
						</div>
					</form>
				</main>
				@footer("profile")
			</div>
		</body>
	</html>
}
