package pages

templ CollectPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta
				name="viewport"
				content="width=device-width, initial-scale=1.0"
			/>
			<title>Signin Page</title>
			<link
				rel="stylesheet"
				href="/assets/styles/output.css"
			/>
		</head>
		<body class="bg-white">
			<div class="page p-4">
				<div class="flex justify-between items-center">
					<div class="flex justify-center items-center gap-2">
						<p class="text-black text-xl font-bold">Collect</p>
						<img
							src="../assets/images/Recycle_small.png"
							alt="Recycle Icon"
							class="w-5 h-5"
						/>
					</div>
					<div class="bg-green-100 p-2 rounded-lg">
						<p class="text-lg text-green-800 font-bold">02:00:00</p>
					</div>
				</div>
				<form class="mt-10 flex flex-col gap-3 justify-center items-center px-4">
					<div class="waitlist-input-container w-full flex flex-col justify-start items-start gap-1">
						<label
							for="plastics"
							class="font-semibold text-sm"
						>Plastics in KG</label>
						<input
							type="number"
							id="plastics"
							placeholder="00.00"
							step="0.01"
							min="0"
							class="border border-green-500 rounded-xl p-2 w-full"
						/>
					</div>
					<div class="waitlist-input-container w-full flex flex-col justify-start items-start gap-1">
						<label
							for="paper"
							class="font-semibold text-sm"
						>Paper in KG</label>
						<input
							type="number"
							id="paper"
							placeholder="00.00"
							step="0.01"
							min="0"
							class="border border-green-500 rounded-xl p-2 w-full"
						/>
					</div>
					<div class="waitlist-input-container w-full flex flex-col justify-start items-start gap-1">
						<label
							for="glass"
							class="font-semibold text-sm"
						>Glass in KG</label>
						<input
							type="number"
							id="glass"
							placeholder="00.00"
							step="0.01"
							min="0"
							class="border border-green-500 rounded-xl p-2 w-full"
						/>
					</div>
					<div class="waitlist-input-container w-full flex flex-col justify-start items-start gap-1">
						<label
							for="metal"
							class="font-semibold text-sm"
						>Metal in KG</label>
						<input
							type="number"
							id="metal"
							placeholder="00.00"
							step="0.01"
							min="0"
							class="border border-green-500 rounded-xl p-2 w-full"
						/>
					</div>
					<div class="waitlist-input-submit w-full">
						<input
							type="button"
							id="button"
							name="button"
							value="Submit waste"
							formaction="/"
							formenctype="application/x-www-form-urlencoded"
							formmethod="post"
							class="w-full bg-green-700 text-white py-4 my-4 rounded-2xl"
						/>
					</div>
				</form>
			</div>
		</body>
	</html>
}
