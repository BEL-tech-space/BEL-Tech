package pages

import (
	"encoding/base64"
	"fmt"
)

templ CollectPage(agentID string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta
				name="viewport"
				content="width=device-width, initial-scale=1.0"
			/>
			<link
				rel="stylesheet"
				href="/assets/styles/output.css"
			/>
			<script src="/assets/libriaries/htmx.min.js"></script>
			<script src="/assets/libriaries/hyperscript.min.js"></script>
			<style>
			.overflow-y-auto::-webkit-scrollbar {
				width: 0 !important;
				display: none;
				overflow: -moz-scrollbars-none;
				scrollbar-width: none;
			}
	</style>
			<title>Collect Waste</title>
		</head>
		<body class="bg-[url('/assets/images/beltech_background.png')] bg-cover bg-center h-dvh overflow-hidden">
			<div class="w-full h-full grid grid-rows-agentCollectPage pt-8 font-montserrat ">
				<header class="flex justify-between items-center mr-[1.688rem] ml-6">
					<div class="flex justify-center items-center gap-2 w-fit">
						<p class="font-semibold text-left text-base leading-[1.219rem]">Collect</p>
						<img
							src="../assets/images/Recycle_small.png"
							alt="Recycle Icon"
							class="w-5 aspect-square"
						/>
					</div>
					<p
						class="leading-[1.143rem] text-[0.938rem] text-left font-semibold text-[#014623] bg-[#CCE1D699] p-2 rounded-md"
					>
						02:00:00
					</p>
				</header>
				<main id="main" class="overflow-y-auto my-auto mr-[1.688rem] ml-6" hx-on:htmx:after-swap="reattachListeners()">
					@WasteForm(agentID)
				</main>
				@footer("collect")
			</div>
		</body>
	</html>
}

templ RenderQRCode(qrcodeByteImage []byte) {
	<article id="wasteQRCode" class="w-full">
		<img src={ "data:image/png;base64," + base64.StdEncoding.EncodeToString(qrcodeByteImage) } alt="QR Code" class="px-auto block w-full"/>
		<a
			hx-get="/agent/wasteForm"
			hx-select="#wasteForm"
			hx-target="#wasteQRCode"
			hx-swap="outerHTML"
			class="block w-full bg-[#016934] rounded-md text-center font-medium text-sm tracking-widest py-[0.625rem] px-[6.438rem] text-white"
		>Next</a>
	</article>
}

var formFormatterScript = templ.NewOnceHandle()

templ WasteForm(agentID string) {
	<form
		id="wasteForm"
		hx-post={ fmt.Sprintf("/agent/qrcode/%s", agentID) }
		hx-select="#wasteQRCode"
		hx-swap="outerHTML"
		enctype="application/x-www-form-urlencoded"
		class="flex flex-col h-full gap-3 justify-center items-center px-4"
	>
		// <div class="relative">
		// 	<input type="text" id="floating_outlined" class="block px-2.5 pb-2.5 pt-4 w-full text-sm text-gray-900 bg-transparent rounded-lg border-1 border-gray-300 appearance-none dark:text-white dark:border-gray-600 dark:focus:border-blue-500 focus:outline-none focus:ring-0 focus:border-blue-600 peer" placeholder=" "/>
		// 	<label for="floating_outlined" class="absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-4 scale-75 top-2 z-10 origin-[0] bg-white dark:bg-gray-900 px-2 peer-focus:px-2 peer-focus:text-blue-600 peer-focus:dark:text-blue-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:top-1/2 peer-focus:top-2 peer-focus:scale-75 peer-focus:-translate-y-4 rtl:peer-focus:translate-x-1/4 rtl:peer-focus:left-auto start-1">Floating outlined</label>
		// </div>
		<div class="w-full flex flex-col justify-start items-start gap-1">
			<label
				for="plastics"
				class="font-semibold text-sm"
			>Plastics in KG</label>
			<input
				type="number"
				inputmode="numeric"
				id="plastics"
				name="plastics"
				placeholder="00.00"
				step="0.01"
				min="0"
				required
				class="border border-green-500 rounded-xl p-2 w-full"
			/>
		</div>
		<div class="w-full flex flex-col justify-start items-start gap-1">
			<label
				for="paper"
				class="font-semibold text-sm"
			>Paper in KG</label>
			<input
				type="number"
				inputmode="numeric"
				id="paper"
				name="paper"
				placeholder="00.00"
				step="0.01"
				min="0"
				required
				class="border border-green-500 rounded-xl p-2 w-full"
			/>
		</div>
		<div class="w-full flex flex-col justify-start items-start gap-1">
			<label
				for="glass"
				class="font-semibold text-sm"
			>Glass in KG</label>
			<input
				type="number"
				inputmode="numeric"
				id="glass"
				name="glass"
				placeholder="00.00"
				step="0.01"
				min="0"
				required
				class="border border-green-500 rounded-xl p-2 w-full"
			/>
		</div>
		<div class=" w-full flex flex-col justify-start items-start gap-1">
			<label
				for="metal"
				class="font-semibold text-sm"
			>Metal in KG</label>
			<input
				type="number"
				inputmode="numeric"
				id="metal"
				name="metal"
				placeholder="00.00"
				step="0.01"
				min="0"
				required
				class="border border-green-500 rounded-xl p-2 w-full"
			/>
		</div>
		<section class="mt-3 w-full flex justify-around items-center gap-[0.625rem]">
			<button type="submit" class="w-full text-center bg-[#016934] text-white text-sm tracking-[0.1px] font-medium py-[0.625rem] px-1 rounded-md">Submit Waste</button>
			<button
				onclick="resetForm(event)"
				title="reset form"
				class="bg-[#CCE1D699] p-[0.688rem] rounded-md flex justify-center items-center"
			>
				<img
					src="/assets/svg/octicon_history-16.svg"
					class="w-[1.125rem]  aspect-square"
				/>
			</button>
		</section>
		@formFormatterScript.Once() {
			<script type="text/javascript">

			document.addEventListener("DOMContentLoaded", function() {
                initializeFormFormatter();
            });

			function reattachListeners() {
				initializeFormFormatter();
			}

			function initializeFormFormatter() {
				const inputElements = document.querySelectorAll("input[type='number']");
				inputElements.forEach(input => {
					input.addEventListener("input", function(event) {
						formatToTwoDecimalPlaces(event.target);
					});
				});
			}

			function formatToTwoDecimalPlaces(input) {
				let value = parseFloat(input.value.replace(/\D/g, '') || 0) / 100;
				input.value = value.toFixed(2);
			}

			function resetForm(ev) {
				ev.preventDefault();
				document.getElementById("wasteForm").reset();
			}
		</script>
		}
		// const form = document.getElementById("wasteForm")
		// console.log(form)
		// form.addEventListener("submit", handleSubmit);
		// function handleSubmit(ev) {
		// 	console.log("got here", areAllFieldsZeroOrEmpty())
		// 	if (areAllFieldsZeroOrEmpty()) {
		// 		ev.preventDefault();        // Prevents HTMX submission
		// 		ev.stopPropagation();  
		// 		alert("All fields cannot be zero or empty.");
		// 		return;
		// 	}
		// 	// form.submit();
		// }
		// function areAllFieldsZeroOrEmpty() {
		// 	const inputs = document.querySelectorAll("input[type='number']");
		// 	return Array.from(inputs).every(input => parseFloat(input.value) === 0 || input.value.trim() === "");
		// }
	</form>
}
