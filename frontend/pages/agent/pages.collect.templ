package pages

import (
	"encoding/base64"
	"fmt"
)

templ CollectPage(agentID string) {
	<!DOCTYPE html>
	<html lang="en">
		@headTag("collet")
		<body class="bg-[url('/public/assets/images/beltech_background.png')] bg-cover  bg-center h-dvh overflow-hidden">
			<div class="w-full h-full grid grid-rows-agentCollectPage pt-8 font-montserrat">
				<header class="flex justify-between items-center mr-[1.688rem] ml-6">
					<div class="flex justify-center items-center gap-2 w-fit">
						<p class="font-semibold text-left text-base leading-[1.219rem]">Collect</p>
						<picture>
							<source type="image/webp" srcset="/public/assets/images/Recycle_small.png"/>
							<img
								src="/assets/images/Recycle_small.png"
								alt="Recycle Icon"
								class="w-5 aspect-square"
							/>
						</picture>
					</div>
					<p
						class="leading-[1.143rem] text-[0.938rem] text-left font-semibold text-[#014623] bg-[#CCE1D699] p-2 rounded-md"
					>
						02:00:00
					</p>
				</header>
				<main id="main" class="overflow-y-auto my-auto mr-[1.688rem] ml-6" hx-on:htmx:after-swap="reattachListeners()">
					@WasteForm(agentID)
				</main>
				@Footer("collect")
			</div>
		</body>
		<script src="/public/assets/scripts/htmx.min.js"></script>
		<script src="/public/assets/scripts/hyperscript.min.js"></script>
		@confirmDialog()
	</html>
}

templ RenderQRCode(qrcodeByteImage []byte) {
	<article id="wasteQRCode" class="w-full">
		<img src={ "data:image/png;base64," + base64.StdEncoding.EncodeToString(qrcodeByteImage) } alt="QR Code" class="px-auto block w-full"/>
		<a
			hx-get="/agent/wasteForm"
			hx-select="#wasteForm"
			hx-target="#wasteQRCode"
			hx-swap="outerHTML"
			class="block w-full bg-[#016934] rounded-md text-center font-medium text-sm tracking-widest py-[0.625rem] px-[6.438rem] text-white"
		>Next</a>
	</article>
}

var formFormatterScript = templ.NewOnceHandle()

templ WasteForm(agentID string) {
	<form
		id="wasteForm"
		hx-post={ fmt.Sprintf("/agent/qrcode/%s", agentID) }
		hx-select="#wasteQRCode"
		hx-swap="outerHTML"
		enctype="application/x-www-form-urlencoded"
		class="flex flex-col h-full gap-3 justify-center items-center px-4"
	>
		<div class="w-full flex flex-col justify-start items-start gap-1">
			<label
				for="plastics"
				class="font-semibold text-sm"
			>Plastics in KG</label>
			<input
				type="number"
				inputmode="numeric"
				id="plastics"
				name="plastics"
				placeholder="00.00"
				step="0.01"
				min="0"
				class="border border-green-500 rounded-xl p-2 w-full"
			/>
		</div>
		<div class="w-full flex flex-col justify-start items-start gap-1">
			<label
				for="paper"
				class="font-semibold text-sm"
			>Paper in KG</label>
			<input
				type="number"
				inputmode="numeric"
				id="paper"
				name="paper"
				placeholder="00.00"
				step="0.01"
				min="0"
				class="border border-green-500 rounded-xl p-2 w-full"
			/>
		</div>
		<div class="w-full flex flex-col justify-start items-start gap-1">
			<label
				for="glass"
				class="font-semibold text-sm"
			>Glass in KG</label>
			<input
				type="number"
				inputmode="numeric"
				id="glass"
				name="glass"
				placeholder="00.00"
				step="0.01"
				min="0"
				class="border border-green-500 rounded-xl p-2 w-full"
			/>
		</div>
		<div class=" w-full flex flex-col justify-start items-start gap-1">
			<label
				for="metal"
				class="font-semibold text-sm"
			>Metal in KG</label>
			<input
				type="number"
				inputmode="numeric"
				id="metal"
				name="metal"
				placeholder="00.00"
				step="0.01"
				min="0"
				class="border border-green-500 rounded-xl p-2 w-full"
			/>
		</div>
		<section class="mt-3 w-full flex justify-around items-center gap-[0.625rem]">
			<button
				type="button"
				_="on click 
					if (#plastics.value is '' or #plastics.value is '0' or #plastics.value is '0.00')
						and (#paper.value is '' or #paper.value is '0' or #paper.value is '0.00')
						and (#glass.value is '' or #glass.value is '0' or #glass.value is '0.00')
						and (#metal.value is '' or #metal.value is '0' or #metal.value is '0.00')
							then alert('At least one value must be non-empty and greater than zero.')
							halt
						end

					set #confirmDialog.querySelector('[data-waste=plastics]').innerText to #plastics.value + ' KG'
					then set #confirmDialog.querySelector('[data-waste=paper]').innerText to #paper.value + ' KG'
					then set #confirmDialog.querySelector('[data-waste=glass]').innerText to #glass.value + ' KG'
					then set #confirmDialog.querySelector('[data-waste=metal]').innerText to #metal.value + ' KG'
					then call #confirmDialog.showModal()"
				class="w-full text-center bg-[#016934] text-white text-sm tracking-[0.1px] font-medium py-[0.625rem] px-1 rounded-md"
			>Submit Waste</button>
			<button
				_="on click call #wasteForm.reset()"
				title="reset form"
				class="bg-[#CCE1D699] p-[0.688rem] rounded-md flex justify-center items-center"
			>
				<img
					src="/public/assets/svg/octicon_history-16.svg"
					class="w-[1.125rem]  aspect-square"
				/>
			</button>
		</section>
		@formFormatterScript.Once() {
			<script type="text/javascript">
			document.addEventListener("DOMContentLoaded", function() {
                initializeFormFormatter();
            });

			function reattachListeners() {
				initializeFormFormatter();
			}

			function initializeFormFormatter() {
				const inputElements = document.querySelectorAll("input[type='number']");
				inputElements.forEach(input => {
					input.addEventListener("input", function(event) {
						formatToTwoDecimalPlaces(event.target);
					});
				});
			}

			function formatToTwoDecimalPlaces(input) {
				let value = parseFloat(input.value.replace(/\D/g, '') || 0) / 100;
				input.value = value.toFixed(2);
			}
		</script>
		}
	</form>
}

templ confirmDialog() {
	<dialog id="confirmDialog" class="backdrop:backdrop-blur-sm rounded-2xl py-4 px-6 font-tt_chocolate text-[#2E2E2E]">
		<section class="flex flex-col justify-center items-start gap-6">
			<div class="flex justify-center items-center gap-2">
				<p class="font-semibold">Glass:</p>
				<p data-waste="glass">0 KG</p>
			</div>
			<div class="flex justify-center items-center gap-2">
				<p class="font-semibold">Plastics:</p>
				<p data-waste="plastics">0 KG</p>
			</div>
			<div class="flex justify-center items-center gap-2">
				<p class="font-semibold">Paper:</p>
				<p data-waste="paper">0 KG</p>
			</div>
			<div class="flex justify-center items-center gap-2">
				<p class="font-semibold">Metal:</p>
				<p data-waste="metal">0 KG</p>
			</div>
		</section>
		<div class="w-full mt-8 flex justify-between items-center gap-2">
			<button type="submit" _="on click call #confirmDialog.close() then call #wasteForm.requestSubmit()" class="outline-none rounded-md mb-2 font-medium bg-[#016934] text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-8 text-center text-white">Proceed</button>
			<button type="button" _="on click call #confirmDialog.close()" class="outline-none rounded-md mb-2 font-medium bg-black text-[0.813rem] leading-5 tracking-[0.00625em] py-[0.625rem] px-8 text-center text-white">Close</button>
		</div>
	</dialog>
}
