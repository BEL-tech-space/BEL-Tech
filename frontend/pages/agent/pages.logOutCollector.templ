package pages

templ LogOutCollector() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta
				name="viewport"
				content="width=device-width, initial-scale=1.0"
			/>
			<link
				rel="stylesheet"
				href="/assets/styles/output.css"
			/>
			<style>
				.overflow-y-scroll::-webkit-scrollbar {
					width: 0 !important;
					display: none;
					overflow: -moz-scrollbars-none;
					scrollbar-width: none;
				}
        </style>
			<title>LogOut Beltech-Agent</title>
		</head>
		<body class="h-dvh overflow-hidden">
			<div class="w-full h-full grid grid-rows-agentDashboardPage pt-11 overflow-y-auto">
				<div class="mx-6 flex flex-col justify-center items-center gap-[5.5rem]">
					<img
						src="/assets/svg/beltechClearLogo.svg"
						alt=""
						class="w-[24.375rem] min-w-[51%] aspect-[390/437]"
					/>
					<a
						href="/agent/logout"
						class="w-full bg-[#016934] py-3 rounded-md px-[5.438rem] font-montserrat font-medium text-sm text-center tracking-[0.1px] text-white text-nowrap"
					>
						LogOut 
					</a>
				</div>
				@footer("logout")
			</div>
		</body>
	</html>
}
