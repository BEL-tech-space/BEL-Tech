package pages

templ Footer(active string) {
	<footer class="bg-white flex w-full justify-around mt-[1.125rem] gap-[2.375rem] text-[#016934]">
		if active == "dashboard" {
			<a
				href="/agent/dashboard"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/home bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">Home</p>
			</a>
		} else {
			<a
				href="/agent/dashboard"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/home linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">Home</p>
			</a>
		}
		if active == "collect" {
			<a
				href="/agent/collect"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/collect_icon_bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">Collect</p>
			</a>
		} else {
			<a
				href="/agent/collect"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/collect_icon_linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">Collect</p>
			</a>
		}
		if active == "history" {
			<a
				href="/agent/history"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/history_icon_bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">History</p>
			</a>
		} else {
			<a
				href="/agent/history"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/history_icon_linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">History</p>
			</a>
		}
		if active == "profile" {
			<a
				href="/agent/profile"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/profile-home.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">Profile</p>
			</a>
		} else {
			<a
				href="/agent/profile"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/profile.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">Profile</p>
			</a>
		}
		if active == "logout" {
			<a
				href="/agent/signout"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/logout_bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">Logout</p>
			</a>
		} else {
			<a
				href="/agent/signout"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/logout_linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">Logout</p>
			</a>
		}
	</footer>
}

templ profileBar(collector Collector) {
	<header class="flex w-full justify-start items-center">
		<img
			src={ collector.AvatarUrl }
			class="rounded-full w-[1.86rem] aspect-square mr-[0.5rem]"
		/>
		if collector.NickName != "" {
			<p class="leading-[0.91rem] font-[500] text-[0.75rem]">
				Gm,
				<span class="font-[600]">{ collector.NickName }</span>
			</p>
		} else if collector.FirstName != "" {
			<p class="leading-[0.91rem] font-[500] text-[0.75rem]">
				Gm,
				<span class="font-[600]">{ collector.FirstName }</span>
			</p>
		} else if collector.LastName != "" {
			<p class="leading-[0.91rem] font-[500] text-[0.75rem]">
				Gm,
				<span class="font-[600]">{ collector.LastName }</span>
			</p>
		} else {
			<p class="leading-[0.91rem] font-[500] text-[0.75rem]">
				Gm
			</p>
		}
		<button class="bg-[#CCE1D699] p-[0.5rem] rounded-md flex justify-center items-center">
			<img
				src="/public/assets/svg/notification.svg"
				class="w-6 aspect-square"
			/>
		</button>
	</header>
}

templ letRecycleAndProfile(text string) {
	<article class="pt-[1.88rem] flex items-center gap-1">
		<p class="leading-[1.143rem] font-semibold text-[0.938rem]">{ text }</p>
		<img
			src="/public/assets/images/Recycle_small.png"
			class="w-5 aspect-square"
		/>
	</article>
}

templ removeScrollBar() {
	<style>
		.overflow-y-auto::-webkit-scrollbar {
			width: 0 !important;
			display: none;
			overflow: -moz-scrollbars-none;
			scrollbar-width: none;
		}
	</style>
}
