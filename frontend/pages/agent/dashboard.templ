package pages

templ DashboardPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta
				name="viewport"
				content="width=device-width, initial-scale=1.0"
			/>
			<title>Signin Page</title>
			<link
				rel="stylesheet"
				href="/assets/styles/output.css"
			/>
		</head>
		<body class="bg-white">
			<div class="page p-4">
				<div class="flex w-full justify-center items-center mb-6">
					<img
						src="/assets/images/beltech_logo.png"
						alt="Beltech Logo"
						class="w-24"
					/>
				</div>
				<div class="flex w-full justify-between items-center my-4">
					<p class="text-2xl font-seminbold">Overview</p>
					<button class="bg-[#01693433] flex justify-center items-center gap-1 rounded-3xl px-4 py-2">
						<p class="text-sm font-light text-black">This week</p>
						<img
							src="/assets/svg/filter_small.svg"
							alt="Notifications"
							class="w-6"
						/>
					</button>
				</div>
				<div class="flex flex-col gap-3 justify-between items-center">
					<div class="bg-[#FEF7FF] p-3 rounded-2xl flex w-full justify-start items-center gap-4">
						<img
							src="/assets/images/glass.jpg"
							alt=""
							class="w-24 h-24 rounded-xl"
						/>
						<div class="flex flex-col justify-center items-center gap-1">
							<p class="text-xl">Glass</p>
							<p class="text-md font-semibold">245kg</p>
						</div>
						<img
							src="/assets/svg/arrow_right.svg"
							alt=""
							class="w-8 h-8 ml-auto"
						/>
					</div>
					<div class="bg-[#FEF7FF] p-3 rounded-2xl flex w-full justify-start items-center gap-4">
						<img
							src="/assets/images/book.jpg"
							alt=""
							class="w-24 h-24 rounded-xl"
						/>
						<div class="flex flex-col justify-center items-center gap-1">
							<p class="text-xl">Paper</p>
							<p class="text-md font-semibold">245kg</p>
						</div>
						<img
							src="/assets/svg/arrow_right.svg"
							alt=""
							class="w-8 h-8 ml-auto"
						/>
					</div>
					<div class="bg-[#FEF7FF] p-3 rounded-2xl flex w-full justify-start items-center gap-4">
						<img
							src="/assets/images/metal2.jpeg"
							alt=""
							class="w-24 h-24 rounded-xl"
						/>
						<div class="flex flex-col justify-center items-center gap-1">
							<p class="text-xl">Metal</p>
							<p class="text-md font-semibold">245kg</p>
						</div>
						<img
							src="/assets/svg/arrow_right.svg"
							alt=""
							class="w-8 h-8 ml-auto"
						/>
					</div>
					<div class="bg-[#FEF7FF] p-3 rounded-2xl flex w-full justify-start items-center gap-4">
						<img
							src="/assets/images/plastic_1.jpg"
							alt=""
							class="w-24 h-24 rounded-xl"
						/>
						<div class="flex flex-col justify-center items-center gap-1">
							<p class="text-xl">Plastics</p>
							<p class="text-md font-semibold">245kg</p>
						</div>
						<img
							src="/assets/svg/arrow_right.svg"
							alt=""
							class="w-8 h-8 ml-auto"
						/>
					</div>
				</div>
				<div class="flex items-center gap-4 my-8">
					<div class="text-center border border-green-500 p-4 rounded-lg">
						<div class="text-green-800 text-lg font-semibold whitespace-nowrap">Successful Operations</div>
						<div class="text-xl font-bold text-green-800">234 Recycles</div>
					</div>
					<div class="text-center border border-red-500 p-4 rounded-lg">
						<div class="text-red-800 text-lg font-semibold whitespace-nowrap">Failed Operations</div>
						<div class="text-xl font-bold text-red-800">23 Recycles</div>
					</div>
				</div>
			</div>
		</body>
	</html>
}
