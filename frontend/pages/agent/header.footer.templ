package pages

templ headTag(pageTitle string) {
	<head>
		<meta charset="UTF-8"/>
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0, viewport-fit=cover"
		/>
		<meta name="theme-color" content="#CCE1D699"/>
		@splashScreenForiOS()
		<link
			rel="stylesheet"
			href="/public/assets/styles/output.css"
		/>
		// <link
		// 	rel="stylesheet"
		// 	href="/public/assets/styles/toastr.min.css"
		// />
		<style>
			.overflow-y-auto::-webkit-scrollbar {
				width: 0 !important;
				display: none;
				overflow: -moz-scrollbars-none;
				scrollbar-width: none;
			}
		</style>
		if pageTitle == "profile" {
			<script src="/public/assets/scripts/hyperscript.min.js"></script>
		}
		<script src="/public/assets/scripts/htmx.min.js"></script>
		<title>{ pageTitle }</title>
	</head>
}

templ footer(active string) {
	<footer class="bg-white flex w-full justify-around mt-[1.125rem] gap-[2.375rem] text-[#016934]" hx-boost="false">
		if active == "dashboard" {
			<a
				href="/agent/dashboard"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/home bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">Home</p>
			</a>
		} else {
			<a
				href="/agent/dashboard"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/home linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">Home</p>
			</a>
		}
		if active == "collect" {
			<a
				href="/agent/collect"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/collect_icon_bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">Collect</p>
			</a>
		} else {
			<a
				href="/agent/collect"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/collect_icon_linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">Collect</p>
			</a>
		}
		if active == "history" {
			<a
				href="/agent/history"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/history_icon_bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">History</p>
			</a>
		} else {
			<a
				href="/agent/history"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/history_icon_linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">History</p>
			</a>
		}
		if active == "profile" {
			<a
				href="/agent/profile"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/profile-home.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">Profile</p>
			</a>
		} else {
			<a
				href="/agent/profile"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/profile.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">Profile</p>
			</a>
		}
		if active == "logout" {
			<a
				href="/agent/signout.html"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/logout_bold.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">Logout</p>
			</a>
		} else {
			<a
				href="/agent/signout.html"
				class="flex flex-col justify-center items-center"
			>
				<img
					src="/public/assets/svg/logout_linear.svg"
					class="w-6 aspect-square"
				/>
				<p class="font-bold text-[0.5rem] leading-[1.25rem]">Logout</p>
			</a>
		}
	</footer>
}

